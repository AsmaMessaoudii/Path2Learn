                                        </div>
                                        <div class="modal-footer">
                                            <a href="{{ selectedRessource ? path('admin_ressources_view', {'id': selectedRessource.id}) : path('admin_ressources_index') }}" class="btn btn-secondary">
                                                <i class="bi bi-x-circle me-1"></i> Annuler
                                            </a>
