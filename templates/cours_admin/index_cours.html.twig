                                        <button type="submit" class="btn btn-primary px-4">
                                            <i class="bi bi-plus-circle me-1"></i> Ajouter la ressource
                                        </button>
                                    </div>
                                    {{ form_end(formRessource) }}
                                </div>
                            </div>
                        {% endif %}

                        <!-- Modal pour VIEW Ressource -->
