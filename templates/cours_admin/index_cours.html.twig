                                                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_cours_' ~ cours.id) }}">
                                                                    <button type="submit" class="btn btn-outline-danger" title="Supprimer">
                                                                        <i class="bi bi-trash"></i>
                                                                    </button>
                                                                </form>
                                                            </div>
                                                        </td>
                                                    </tr>
                                                {% endfor %}
                                            </tbody>
                                        </table>
                                    </div>
                                {% endif %}
                            </div>
                        </div>

                    </div>
                    {% endif %}
                    
                    <!-- ===== Section Statistiques (uniquement pour les cours) ===== -->
