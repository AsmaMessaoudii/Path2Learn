                                                            <span>Titre</span>
                                                            {% if current_sort.field == 'titre' %}
                                                                <i class="bi bi-sort-{{ current_sort.direction == 'ASC' ? 'down' : 'up' }} ms-1"></i>
                                                            {% else %}
