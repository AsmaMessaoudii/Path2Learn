                                                {{ form_widget(formRessource.type) }}
                                                <div class="text-danger small mt-1">
                                                    {{ form_errors(formRessource.type) }}
                                                </div>
                                            </div>
                                        </div>
                                        
                                        <!-- Fichier upload -->
