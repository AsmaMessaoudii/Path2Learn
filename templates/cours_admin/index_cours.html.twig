                                                                    <div class="me-3">
                                                                        <div class="bg-success text-white rounded p-3 text-center" style="width: 70px; height: 70px;">
                                                                            <i class="bi bi-journal-text fs-4"></i>
                                                                        </div>
                                                                    </div>
