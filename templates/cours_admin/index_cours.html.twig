                                                <tr>
                                                    <th>
                                                        <a href="{{ path('admin_ressources_tri', {'sortBy': 'titre', 'direction': current_sort.field == 'titre' and current_sort.direction == 'ASC' ? 'DESC' : 'ASC'}) }}" class="text-decoration-none">
                                                            Titre 
