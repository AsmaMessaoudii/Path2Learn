                                                                   class="btn btn-danger">
                                                                    <i class="bi bi-file-earmark-pdf me-1"></i> PDF
                                                                </a>
                                                            </div>
                                                        </div>
                                                        
                                                    {% elseif selectedRessource.url %}
                                                        <!-- AFFICHAGE DU LIEN -->
                                                        <div class="text-center mb-4">
                                                            <div class="bg-info text-white rounded p-5">
                                                                <i class="bi bi-link-45deg display-4"></i>
