<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>CV - {{ user.nom }} {{ user.prenom }}</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300&family=DM+Sans:wght@300;400;500&display=swap');

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'DM Sans', 'DejaVu Sans', 'Helvetica', sans-serif;
            background: #e8e4df;
            color: #1c1a17;
            margin: 0;
            padding: 40px 20px;
            font-size: 11px;
            line-height: 1.6;
        }

        .container {
            max-width: 760px;
            margin: 0 auto;
            background: #faf8f5;
            box-shadow: 0 20px 60px rgba(0,0,0,0.15);
        }

        /* ── HEADER ── */
        .header {
            background: #1c1a17;
            color: #faf8f5;
            padding: 48px 48px 40px 48px;
            position: relative;
            overflow: hidden;
        }

        .header::before {
            content: '';
            position: absolute;
            top: -60px;
            right: -60px;
            width: 220px;
            height: 220px;
            border-radius: 50%;
            border: 40px solid rgba(255,255,255,0.04);
        }

        .header::after {
            content: '';
            position: absolute;
            bottom: -30px;
            right: 80px;
            width: 100px;
            height: 100px;
            border-radius: 50%;
            border: 20px solid rgba(255,255,255,0.04);
        }

        .header-name {
            font-family: 'Cormorant Garamond', 'DejaVu Serif', serif;
            font-size: 42px;
            font-weight: 300;
            letter-spacing: 3px;
            text-transform: uppercase;
            color: #faf8f5;
            line-height: 1.1;
            margin-bottom: 6px;
        }

        .header-title {
            font-size: 11px;
            font-weight: 300;
            letter-spacing: 3px;
            text-transform: uppercase;
            color: #c9b99a;
            margin-bottom: 24px;
        }

        .header-divider {
            width: 48px;
            height: 1px;
            background: #c9b99a;
            margin-bottom: 20px;
        }

        .contact-line {
            font-size: 10px;
            color: #a89880;
            letter-spacing: 0.5px;
        }

        .contact-item {
            display: block;
            margin-bottom: 4px;
            padding-left: 16px;
            position: relative;
        }

        .contact-item::before {
            content: '—';
            color: #c9b99a;
            position: absolute;
            left: 0;
            font-size: 10px;
        }

        /* ── BODY: TABLE LAYOUT (reliable for PDF) ── */
        .body-table {
            width: 100%;
            border-collapse: collapse;
        }

        .body-table td {
            vertical-align: top;
            padding: 0;
        }

        .col-sidebar {
    width: 240px;
    background: #f2ede7;
    border-right: 1px solid #e2dbd2;
    padding: 52px 30px 52px 90px; /* ← left is already 56px, keep it */
}

.col-main {
    background: #faf8f5;
    padding: 52px 56px 52px 56px; /* ← left is already 56px, keep it */
    overflow: hidden;
}

/* ── SECTION ── */
.section {
    margin-bottom: 32px; /* Increased from 28px */
}

.section-title {
    font-size: 8px;
    font-weight: 500;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: #c9b99a;
    margin-bottom: 16px; /* Increased from 14px */
    border-bottom: 1px solid #e0d9d0;
    padding-bottom: 8px; /* Increased from 6px */
}

/* ── ABOUT ── */
.about-text {
    font-size: 11px;
    color: #4a4640;
    line-height: 1.8; /* Increased from 1.75 */
    text-align: justify;
    font-weight: 300;
    margin-bottom: 8px; /* Added */
}

/* ── SKILLS ── */
.skills-list {
    list-style: none;
    margin-top: 8px; /* Added */
}

.skills-list li {
    font-size: 10.5px;
    color: #3a3630;
    padding: 8px 0; /* Increased from 6px */
    border-bottom: 1px solid #e8e3dc;
}

.skills-list li:last-child {
    border-bottom: none;
}

.skills-list li::before {
    content: '· ';
    color: #c9b99a;
    font-weight: bold;
    margin-right: 4px; /* Added */
}

/* ── LANGUAGES ── */
.langue-item {
    margin-bottom: 16px; /* Increased from 12px */
}

.langue-nom {
    font-size: 11px;
    font-weight: 500;
    color: #1c1a17;
    display: block;
    margin-bottom: 4px; /* Added */
}

.langue-niveau {
    font-size: 9px;
    color: #8a8078;
    letter-spacing: 1px;
    text-transform: uppercase;
    display: inline-block; /* Added */
    padding-left: 4px; /* Added */
}

/* ── CERTIFICATIONS ── */
.certification-item {
    font-size: 10.5px;
    color: #4a4640;
    line-height: 2; /* Increased from 1.8 */
    margin-top: 8px; /* Added */
}

.certification-item br {
    content: "";
    margin: 8px 0; /* Added spacing between lines */
    display: block;
}

/* ── PROJECTS ── */
.experience-item {
    margin-bottom: 32px; /* Increased from 24px */
    padding-bottom: 28px; /* Increased from 24px */
    border-bottom: 1px solid #ede8e1;
}

.experience-item:last-child {
    border-bottom: none;
    margin-bottom: 0;
    padding-bottom: 0;
}

.experience-header-table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 12px; /* Increased from 7px */
}

.experience-title {
    font-family: 'Cormorant Garamond', 'DejaVu Serif', serif;
    font-size: 16px;
    font-weight: 600;
    color: #1c1a17;
    letter-spacing: 0.3px;
    line-height: 1.3; /* Increased from 1.2 */
}

.experience-date {
    font-size: 9px;
    color: #8a8078;
    letter-spacing: 1px;
    text-transform: uppercase;
    white-space: nowrap;
    text-align: right;
    padding-left: 16px; /* Added space between title and date */
}

.experience-desc {
    font-size: 10.5px;
    color: #4a4640;
    line-height: 1.8; /* Increased from 1.7 */
    font-weight: 300;
    margin-bottom: 8px; /* Added */
}

/* Tech tags */
.tech-tags {
    margin-top: 16px; /* Increased from 10px */
    margin-bottom: 8px; /* Added */
}

.tech-tag {
    display: inline-block;
    background: #f0ece6;
    border: 1px solid #e0d9d0;
    color: #3a3630;
    padding: 4px 12px; /* Increased from 2px 9px */
    border-radius: 3px; /* Increased from 2px */
    font-size: 9.5px;
    margin-right: 8px; /* Increased from 5px */
    margin-bottom: 8px; /* Increased from 4px */
    letter-spacing: 0.3px; /* Added */
}

/* ── INTERESTS ── */
.interest-item {
    display: inline-block;
    background: #f0ece6;
    border: 1px solid #e0d9d0;
    padding: 4px 12px; /* Increased from 3px 10px */
    border-radius: 3px; /* Increased from 2px */
    font-size: 10px;
    color: #4a4640;
    margin-right: 8px; /* Increased from 5px */
    margin-bottom: 8px; /* Increased from 5px */
}

/* Add spacing between columns */
.col-sidebar {
    width: 240px;
    background: #f2ede7;
    border-right: 1px solid #e2dbd2;
    padding: 44px 28px 44px 56px; /* ← matches header left padding */
}

 /* ── MAIN ── */
        .main-content {
            flex: 1;
            padding: 40px 40px 40px 36px;
        }
        
.col-main {
    background: #faf8f5;
    padding: 44px 52px 44px 56px; /* ← matches header left padding */
}

/* Add spacing for contact items in header */
.contact-item {
    display: block;
    margin-bottom: 8px; /* Increased from 4px */
    padding-left: 16px;
    position: relative;
}

.contact-item::before {
    content: '—';
    color: #c9b99a;
    position: absolute;
    left: 0;
    font-size: 10px;
}

/* Add spacing for header elements */
.header-name {
    margin-bottom: 12px; /* Increased from 6px */
}

.header-title {
    margin-bottom: 28px; /* Increased from 24px */
}

.header-divider {
    margin-bottom: 28px; /* Increased from 20px */
}

/* Footer spacing */
.footer {
    text-align: center;
    padding: 20px 48px; /* Increased top/bottom from 16px */
    background: #1c1a17;
    font-size: 9px;
    color: #5a5650;
    letter-spacing: 2px;
    text-transform: uppercase;
    line-height: 1.6; /* Added */
}
    </style>
</head>
<body>
    <div class="container">

        <!-- HEADER -->
        <div class="header">
            <div class="header-name">{{ user.nom|upper }} {{ user.prenom|capitalize }}</div>
            <div class="header-title">{% if cvInfo.objectif %}{{ cvInfo.objectif }}{% else %}Étudiant{% endif %}</div>
            <div class="header-divider"></div>
            <div class="contact-line">
                {% if cvInfo.telephone %}
                <span class="contact-item">{{ cvInfo.telephone }}</span>
                {% endif %}
                <span class="contact-item">{{ user.email }}</span>
                {% if cvInfo.adresse %}
                <span class="contact-item">{{ cvInfo.adresse }}</span>
                {% endif %}
                {% if cvInfo.linkedin %}
                <span class="contact-item">LinkedIn</span>
                {% endif %}
            </div>
        </div>

        <!-- BODY: TABLE-BASED TWO COLUMNS -->
        <table class="body-table">
            <tr>

                <!-- SIDEBAR -->
                <td class="col-sidebar">

                    {% if cvInfo.centresInteret %}
                    <div class="section">
                        <div class="section-title">Compétences</div>
                        <ul class="skills-list">
                            {% for interet in cvInfo.centresInteret %}
                                {% if interet is iterable and interet.nom is defined %}
                                    <li>{{ interet.nom }}</li>
                                {% else %}
                                    <li>{{ interet }}</li>
                                {% endif %}
                            {% endfor %}
                        </ul>
                    </div>
                    {% endif %}

                    {% if cvInfo.langues %}
                    <div class="section">
                        <div class="section-title">Langues</div>
                        {% for langue in cvInfo.langues %}
                        <div class="langue-item">
                            <span class="langue-nom">{{ langue.nom }}</span>
                            <span class="langue-niveau">{{ langue.niveau }}</span>
                        </div>
                        {% endfor %}
                    </div>
                    {% endif %}

                    {% if cvInfo.certifications %}
                    <div class="section">
                        <div class="section-title">Certifications</div>
                        <div class="certification-item">{{ cvInfo.certifications|nl2br }}</div>
                    </div>
                    {% endif %}

                    {% if cvInfo.centresInteret and false %}
                    <div class="section">
                        <div class="section-title">Intérêts</div>
                        {% for interet in cvInfo.centresInteret %}
                            {% if interet is iterable and interet.nom is defined %}
                                <span class="interest-item">{{ interet.nom }}</span>
                            {% else %}
                                <span class="interest-item">{{ interet }}</span>
                            {% endif %}
                        {% endfor %}
                    </div>
                    {% endif %}

                </td>

                <!-- MAIN -->
                <td class="col-main">

                    {% if cvInfo.objectif %}
                    <div class="section">
                        <div class="section-title">À Propos</div>
                        <div class="about-text">{{ cvInfo.objectif }}</div>
                    </div>
                    {% endif %}

                    {% if portfolio and projets|length > 0 %}
                    <div class="section">
                        <div class="section-title">Projets Réalisés</div>

                        {% for projet in projets %}
                        <div class="experience-item">

                            <table class="experience-header-table">
                                <tr>
                                    <td class="experience-title">{{ projet.titreProjet }}</td>
                                    {% if projet.dateRealisation %}
                                    <td class="experience-date">{{ projet.dateRealisation|date('M Y') }}</td>
                                    {% endif %}
                                </tr>
                            </table>

                            <div class="experience-desc">
                                {{ projet.description|slice(0, 300) }}{% if projet.description|length > 300 %}...{% endif %}

                                {% if projet.technologies %}
                                <div class="tech-tags">
                                    {% for tech in projet.technologies|split(',') %}
                                    <span class="tech-tag">{{ tech|trim }}</span>
                                    {% endfor %}
                                </div>
                                {% endif %}
                            </div>

                        </div>
                        {% endfor %}
                    </div>
                    {% endif %}

                </td>

            </tr>
        </table>

        <!-- FOOTER -->
        <div class="footer">
            CV généré le {{ 'now'|date('d/m/Y') }} &nbsp;·&nbsp; Path2Learn
        </div>

    </div>
</body>
</html>