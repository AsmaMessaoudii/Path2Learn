<!-- Script simple pour l'aperçu -->
<script>
function previewFile(input) {
    const preview = document.getElementById('preview-img');
    const container = document.getElementById('preview-container');
    
    if (input.files && input.files[0]) {
        const file = input.files[0];
        
        // Vérifier la taille (2MB max)
        if (file.size > 2 * 1024 * 1024) {
            alert('Le fichier est trop volumineux. Taille maximum: 2MB');
            input.value = '';
            return;
        }
        
        // Vérifier le type
        if (!file.type.match('image.*')) {
            alert('Veuillez sélectionner une image');
            input.value = '';
            return;
        }
        
        const reader = new FileReader();
        reader.onload = function(e) {
            if (preview) {
                preview.src = e.target.result;
                preview.classList.remove('d-none');
            } else {
                // Créer l'élément preview s'il n'existe pas
                const newPreview = document.createElement('img');
                newPreview.id = 'preview-img';
                newPreview.src = e.target.result;
                newPreview.alt = 'Aperçu';
                newPreview.className = 'img-thumbnail';
                newPreview.style.maxWidth = '150px';
                newPreview.style.maxHeight = '150px';
                container.innerHTML = '';
                container.appendChild(newPreview);
            }
            container.classList.remove('d-none');
        }
        reader.readAsDataURL(file);
    }
}
</script>

<script>
document.addEventListener('DOMContentLoaded', function() {
    console.log('DOM chargé - Initialisation des événements');


    // ========== LANGUAGES COLLECTION ==========
    const languagesWrapper = document.getElementById('languages-wrapper');
    const languagesList = document.getElementById('languages-list');
    const addLanguageBtn = document.getElementById('add-language');
    const noLanguagesMsg = document.getElementById('no-languages-msg');
    
    if (addLanguageBtn && languagesWrapper) {
        addLanguageBtn.addEventListener('click', function() {
            console.log('Ajout d\'une langue');
            const prototype = languagesWrapper.dataset.prototype;
            const index = languagesList.children.length;
            let newForm = prototype.replace(/__name__/g, index);
            
            // Create a temporary div to parse the HTML
            const tempDiv = document.createElement('div');
            tempDiv.innerHTML = newForm;
            
            // Create the row structure
            const rowDiv = document.createElement('div');
            rowDiv.className = 'row g-3 mb-3 language-item';
            
            // Get the form fields
            const nomField = tempDiv.querySelector('[id$="_nom"]');
            const niveauField = tempDiv.querySelector('[id$="_niveau"]');
            
            if (nomField && niveauField) {
                // Create columns
                const col1 = document.createElement('div');
                col1.className = 'col-md-5';
                nomField.className = 'form-control';
                nomField.placeholder = 'Ex: Français';
                col1.appendChild(nomField);
                
                const col2 = document.createElement('div');
                col2.className = 'col-md-5';
                niveauField.className = 'form-control';
                col2.appendChild(niveauField);
                
                const col3 = document.createElement('div');
                col3.className = 'col-md-2 d-flex align-items-center';
                col3.innerHTML = '<button type="button" class="btn btn-outline-danger remove-language"><i class="bi bi-trash"></i></button>';
                
                rowDiv.appendChild(col1);
                rowDiv.appendChild(col2);
                rowDiv.appendChild(col3);
                
                languagesList.appendChild(rowDiv);
                
                // Hide the "no languages" message
                if (noLanguagesMsg) {
                    noLanguagesMsg.style.display = 'none';
                }
                
                // Add remove event
                rowDiv.querySelector('.remove-language').addEventListener('click', function() {
                    rowDiv.remove();
                    if (languagesList.children.length === 0 && noLanguagesMsg) {
                        noLanguagesMsg.style.display = 'block';
                    }
                });
            }
        });
    }

    // ========== INTERESTS COLLECTION ==========
    const interestsWrapper = document.getElementById('interests-wrapper');
    const interestsList = document.getElementById('interests-list');
    const addInterestBtn = document.getElementById('add-interest');
    const noInterestsMsg = document.getElementById('no-interests-msg');
    
    if (addInterestBtn && interestsWrapper) {
        addInterestBtn.addEventListener('click', function() {
            console.log('Ajout d\'un centre d\'intérêt');
            const prototype = interestsWrapper.dataset.prototype;
            const index = interestsList.children.length;
            let newForm = prototype.replace(/__name__/g, index);
            
            // Create a temporary div to parse the HTML
            const tempDiv = document.createElement('div');
            tempDiv.innerHTML = newForm;
            
            // Create the row structure
            const rowDiv = document.createElement('div');
            rowDiv.className = 'row g-3 mb-3 interest-item';
            
            // Get the form fields
            const nomField = tempDiv.querySelector('[id$="_nom"]');
            const iconeField = tempDiv.querySelector('[id$="_icone"]');
            
            if (nomField && iconeField) {
                // Create columns
                const col1 = document.createElement('div');
                col1.className = 'col-md-5';
                nomField.className = 'form-control';
                nomField.placeholder = 'Ex: Programmation';
                col1.appendChild(nomField);
                
                const col2 = document.createElement('div');
                col2.className = 'col-md-5';
                iconeField.className = 'form-control';
                iconeField.placeholder = '💻 ou bi-code-slash';
                col2.appendChild(iconeField);
                
                const col3 = document.createElement('div');
                col3.className = 'col-md-2 d-flex align-items-center';
                col3.innerHTML = '<button type="button" class="btn btn-outline-danger remove-interest"><i class="bi bi-trash"></i></button>';
                
                rowDiv.appendChild(col1);
                rowDiv.appendChild(col2);
                rowDiv.appendChild(col3);
                
                interestsList.appendChild(rowDiv);
                
                // Hide the "no interests" message
                if (noInterestsMsg) {
                    noInterestsMsg.style.display = 'none';
                }
                
                // Add remove event
                rowDiv.querySelector('.remove-interest').addEventListener('click', function() {
                    rowDiv.remove();
                    if (interestsList.children.length === 0 && noInterestsMsg) {
                        noInterestsMsg.style.display = 'block';
                    }
                });
            }
        });
    }

    // Remove buttons for existing items
    document.querySelectorAll('.remove-language').forEach(btn => {
        btn.addEventListener('click', function() {
            const item = this.closest('.language-item');
            if (item) {
                item.remove();
                if (languagesList && languagesList.children.length === 0 && noLanguagesMsg) {
                    noLanguagesMsg.style.display = 'block';
                }
            }
        });
    });
    
    document.querySelectorAll('.remove-interest').forEach(btn => {
        btn.addEventListener('click', function() {
            const item = this.closest('.interest-item');
            if (item) {
                item.remove();
                if (interestsList && interestsList.children.length === 0 && noInterestsMsg) {
                    noInterestsMsg.style.display = 'block';
                }
            }
        });
    });
});
</script>

