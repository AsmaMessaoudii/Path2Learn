<main>
    <!-- =======================
    CV Form START -->
    <section class="py-5" style="background: linear-gradient(135deg, #f5f7fa 0%, #e9ecef 100%);">
        <div class="container">
            <!-- Header -->
            <div class="row mb-4">
                <div class="col-12">
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item"><a href="{{ path('home') }}" class="text-decoration-none">Accueil</a></li>
                            <li class="breadcrumb-item"><a href="{{ path('home_cv') }}" class="text-decoration-none">Mon CV</a></li>
                            <li class="breadcrumb-item active" aria-current="page">{{ isNew ? 'Créer mon CV' : 'Modifier mon CV' }}</li>
                        </ol>
                    </nav>
                </div>
                <div class="col-12 text-center">
                    <div class="d-inline-block bg-primary bg-opacity-10 px-4 py-2 rounded-pill mb-3">
                        <span class="small fw-bold text-primary">
                            <i class="bi bi-file-earmark-person me-2"></i>{{ isNew ? 'NOUVEAU CV' : 'MODIFICATION' }}
                        </span>
                    </div>
                    <h2 class="display-5 fw-bold mb-3">
                        {{ isNew ? 'Créez votre' : 'Modifiez votre' }} <span class="text-primary">CV</span>
                    </h2>
                    <p class="lead text-muted col-lg-8 mx-auto">
                        {{ isNew ? 'Remplissez vos informations pour générer un CV professionnel' : 'Mettez à jour vos informations personnelles' }}
                    </p>
                </div>
            </div>

            <!-- Form Card -->
            <div class="row justify-content-center">
                <div class="col-lg-10">
                    <div class="card border-0 shadow-lg rounded-4">
                        <div class="card-body p-4 p-xl-5">
                            {{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': 'novalidate', 'enctype': 'multipart/form-data'}}) }}
                            
                            <!-- Informations de base -->
                            <div class="mb-5">
                                <h5 class="fw-bold mb-4 pb-2 border-bottom">
                                    <i class="bi bi-person-circle text-primary me-2"></i>Informations personnelles
                                </h5>
                                <div class="row g-4">
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label class="form-label fw-bold">Nom <span class="text-danger">*</span></label>
                                            <input type="text" class="form-control bg-light" value="{{ app.user.nom }} {{ app.user.prenom }}" readonly disabled>
                                            <small class="text-muted">Récupéré de votre profil</small>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label class="form-label fw-bold">Email <span class="text-danger">*</span></label>
                                            <input type="email" class="form-control bg-light" value="{{ app.user.email }}" readonly disabled>
                                            <small class="text-muted">Récupéré de votre profil</small>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        {{ form_row(form.telephone, {
                                            'attr': {'class': 'form-control', 'placeholder': 'Ex: +216 20 123 456'},
                                            'label': 'Téléphone',
                                            'label_attr': {'class': 'form-label fw-bold'}
                                        }) }}
                                    </div>
                                    <div class="col-md-6">
                                        {{ form_row(form.date_naissance, {
                                            'attr': {'class': 'form-control'},
                                            'label': 'Date de naissance',
                                            'label_attr': {'class': 'form-label fw-bold'}
                                        }) }}
                                    </div>
                                    <div class="col-12">
                                        {{ form_row(form.adresse, {
                                            'attr': {'class': 'form-control', 'rows': 3, 'placeholder': 'Votre adresse complète'},
                                            'label': 'Adresse',
                                            'label_attr': {'class': 'form-label fw-bold'}
                                        }) }}
                                    </div>
                                </div>
                            </div>

                            <!-- Réseaux et photo -->
                            <div class="mb-5">
                                <h5 class="fw-bold mb-4 pb-2 border-bottom">
                                    <i class="bi bi-share text-primary me-2"></i>Réseaux et photo
                                </h5>
                                <div class="row g-4">
                                    <div class="col-md-8">
                                        {{ form_row(form.linkedin, {
                                            'attr': {'class': 'form-control', 'placeholder': 'https://www.linkedin.com/in/...'},
                                            'label': 'Profil LinkedIn',
                                            'label_attr': {'class': 'form-label fw-bold'}
                                        }) }}
                                    </div>
                                    <div class="col-md-4">
                                        <div class="mb-3">
                                            <label class="form-label fw-bold">Photo de profil</label>
                                            
                                            <!-- Bouton simple qui fonctionne à coup sûr -->
                                            <div class="border rounded-3 p-3 text-center bg-light">
                                                {{ form_widget(form.photoFile, {
                                                    'attr': {
                                                        'class': 'form-control',
                                                        'accept': 'image/*',
                                                        'style': 'padding: 10px; border: 1px solid #ced4da; border-radius: 5px; width: 100%;',
                                                        'onchange': 'previewFile(this)'
                                                    }
                                                }) }}
                                                <p class="text-muted small mt-2">JPG, PNG, GIF, WEBP (Max 2MB)</p>
                                            </div>

                                            <!-- Aperçu de l'image -->
                                            <div id="preview-container" class="mt-3 text-center {% if not cvInfo.photo %}d-none{% endif %}">
                                                {% if cvInfo.photo %}
                                                    <img src="{{ asset('uploads/cv_photos/' ~ cvInfo.photo) }}" 
                                                         alt="Preview" 
                                                         class="img-thumbnail" 
                                                         style="max-width: 150px; max-height: 150px;">
                                                    <p class="small text-muted mt-1">Photo actuelle</p>
                                                {% else %}
                                                    <img id="preview-img" src="#" alt="Aperçu" class="img-thumbnail d-none" style="max-width: 150px; max-height: 150px;">
                                                {% endif %}
                                            </div>
                                            
                                            {{ form_errors(form.photoFile) }}
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Langues -->
                            <div class="mb-5">
