<!-- MODAL QR CODE - Version avec données intégrées -->
<div class="modal fade" id="qrCodeModal" tabindex="-1" aria-labelledby="qrCodeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white border-0">
                <h5 class="modal-title" id="qrCodeModalLabel">
                    <i class="fas fa-qrcode me-2"></i>
                    QR Code du cours
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            
            <div class="modal-body text-center p-4">
                {# Préparer toutes les données du cours #}
                {% set images = resources|filter(r => r.fileName and r.fileName|lower|split('.')|last in ['jpg', 'jpeg', 'png', 'gif', 'webp', 'svg', 'bmp', 'tiff']) %}
                {% set videos = resources|filter(r => r.fileName and r.fileName|lower|split('.')|last in ['mp4', 'mov', 'avi', 'mkv', 'webm', 'wmv', 'flv', 'm4v']) %}
                {% set pdfs = resources|filter(r => r.fileName and r.fileName|lower|split('.')|last == 'pdf') %}
                {% set audios = resources|filter(r => r.fileName and r.fileName|lower|split('.')|last in ['mp3', 'wav', 'ogg', 'm4a', 'flac', 'aac']) %}
                {% set documents = resources|filter(r => r.fileName and r.fileName|lower|split('.')|last in ['doc', 'docx', 'xls', 'xlsx', 'ppt', 'pptx']) %}
                {% set links = resources|filter(r => r.url) %}
                
                {# Créer un objet avec toutes les informations #}
                {% set courseContent = {
                    'titre': course.titre,
                    'description': course.description|striptags,
                    'matiere': course.matiere|default('Général'),
                    'niveau': course.niveau|default('Tous niveaux'),
                    'duree': course.duree|default(0),
                    'formateur': course.emailProf|default('Path2Learn'),
                    'date': course.dateCreation|date('d/m/Y'),
                    'statistiques': {
                        'total_ressources': resources|length,
                        'pdfs': pdfs|length,
                        'videos': videos|length,
                        'images': images|length,
                        'audios': audios|length,
                        'documents': documents|length,
                        'liens': links|length
                    },
                    'ressources_details': []
                } %}
                
                {# Ajouter les détails des premières ressources (limité à 5 pour ne pas surcharger) #}
                {% for resource in resources|slice(0, 5) %}
                    {% if resource.fileName %}
                        {% set extension = resource.fileName|lower|split('.')|last %}
                        {% set type = 'fichier' %}
                        {% if extension in ['jpg', 'jpeg', 'png'] %} {% set type = 'image' %}
                        {% elseif extension in ['mp4', 'mov'] %} {% set type = 'video' %}
                        {% elseif extension == 'pdf' %} {% set type = 'pdf' %}
                        {% elseif extension in ['mp3', 'wav'] %} {% set type = 'audio' %}
                        {% endif %}
                        
                        {% set courseContent = courseContent|merge({
                            'ressources_details': courseContent.ressources_details|merge([{
                                'titre': resource.titre|default(resource.fileName),
                                'type': type,
                                'extension': extension
                            }])
                        }) %}
                    {% elseif resource.url %}
                        {% set courseContent = courseContent|merge({
                            'ressources_details': courseContent.ressources_details|merge([{
                                'titre': resource.titre|default('Lien externe'),
                                'type': 'lien',
                                'url': resource.url
                            }])
                        }) %}
                    {% endif %}
                {% endfor %}
                
                {# Convertir en JSON #}
                {% set jsonData = courseContent|json_encode %}
                
                {# QR code avec les données JSON #}
                <div class="mb-4 p-3 bg-light rounded-3">
                    <img src="https://api.qrserver.com/v1/create-qr-code/?size=250x250&data={{ jsonData|url_encode }}" 
                         alt="QR Code" 
                         class="img-fluid"
                         style="max-width: 250px;">
                </div>
                
                <!-- Aperçu des données -->
                <div class="text-start mb-3 p-3 bg-light rounded-3" style="max-height: 200px; overflow-y: auto;">
                    <h6 class="fw-bold mb-2">📋 Contenu du QR code :</h6>
                    <small class="text-muted">
                        <i class="fas fa-check-circle text-success me-1"></i>{{ course.titre }}<br>
                        <i class="fas fa-align-left me-1"></i>{{ course.description|striptags|slice(0, 100) }}...<br>
                        <i class="fas fa-layer-group me-1"></i>{{ resources|length }} ressources<br>
                        {% if pdfs|length > 0 %}📄 {{ pdfs|length }} PDF • {% endif %}
                        {% if videos|length > 0 %}🎬 {{ videos|length }} vidéos • {% endif %}
                        {% if images|length > 0 %}🖼️ {{ images|length }} images{% endif %}
                    </small>
                </div>
                
                <!-- Boutons d'action -->
                <div class="d-flex gap-2 justify-content-center">
                    <a href="https://api.qrserver.com/v1/create-qr-code/?size=400x400&data={{ jsonData|url_encode }}" 
                       class="btn btn-primary rounded-pill px-4"
                       target="_blank">
                        <i class="fas fa-download me-2"></i>Télécharger le QR code
                    </a>
                    
                    <button type="button" 
                            class="btn btn-outline-secondary rounded-pill px-4"
                            onclick="previewQRData({{ jsonData|json_encode|raw }})">
                        <i class="fas fa-eye me-2"></i>Aperçu
                    </button>
                </div>
                
                <div class="mt-3">
                    <small class="text-muted">
                        <i class="fas fa-info-circle me-1"></i>
                        Ce QR code contient directement la description et les {{ resources|length }} ressources du cours
                    </small>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
function previewQRData(data) {
    // Afficher un aperçu des données dans une alerte
    let message = "📦 DONNÉES DU COURS\n\n";
    message += `📚 Titre : ${data.titre}\n`;
    message += `📝 Description : ${data.description.substring(0, 100)}...\n`;
    message += `🏷️ Matière : ${data.matiere}\n`;
    message += `📊 Niveau : ${data.niveau}\n`;
    message += `⏱️ Durée : ${data.duree} minutes\n`;
    message += `👨‍🏫 Formateur : ${data.formateur}\n`;
    message += `📅 Date : ${data.date}\n\n`;
    message += `📊 STATISTIQUES\n`;
    message += `📄 PDF : ${data.statistiques.pdfs}\n`;
    message += `🎬 Vidéos : ${data.statistiques.videos}\n`;
    message += `🖼️ Images : ${data.statistiques.images}\n`;
    message += `🎵 Audios : ${data.statistiques.audios}\n`;
    message += `📑 Documents : ${data.statistiques.documents}\n`;
    message += `🔗 Liens : ${data.statistiques.liens}\n`;
    
    if (data.ressources_details.length > 0) {
        message += `\n📋 PREMIÈRES RESSOURCES\n`;
        data.ressources_details.slice(0, 3).forEach(r => {
            let emoji = r.type === 'pdf' ? '📄' : 
                       r.type === 'video' ? '🎬' :
                       r.type === 'image' ? '🖼️' :
                       r.type === 'audio' ? '🎵' :
                       r.type === 'lien' ? '🔗' : '📁';
            message += `${emoji} ${r.titre}\n`;
        });
    }
    
    alert(message);
}
</script>
