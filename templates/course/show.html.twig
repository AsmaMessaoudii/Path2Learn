    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
}
.chatbot-time {
    font-size: 10px; color: #aaa; margin-top: 4px; padding: 0 4px;
    display: flex; align-items: center; gap: 8px;
}
.chatbot-typing { padding: 0 16px 8px; background: #f8f9ff; }
.chatbot-typing .chatbot-bubble {
    display: flex; gap: 5px; align-items: center;
    padding: 12px 16px; background: white;
    border-radius: 16px; border-bottom-left-radius: 4px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.08); width: fit-content;
}
.typing-dot {
    width: 8px; height: 8px; background: #667eea;
    border-radius: 50%; animation: typingBounce 1.2s infinite;
}
.typing-dot:nth-child(2) { animation-delay: 0.2s; }
.typing-dot:nth-child(3) { animation-delay: 0.4s; }
@keyframes typingBounce {
    0%, 80%, 100% { transform: scale(0.7); opacity: 0.5; }
    40%           { transform: scale(1);   opacity: 1;   }
}
.chatbot-input-area {
    padding: 12px 14px; background: white;
    border-top: 1px solid #eee;
    display: flex; gap: 10px; align-items: flex-end;
}
.chatbot-input {
    flex: 1; border: 1.5px solid #e0e0e0;
    border-radius: 12px; padding: 10px 14px;
    font-size: 14px; resize: none; outline: none;
    font-family: inherit; max-height: 100px; transition: border-color 0.2s;
}
.chatbot-input:focus { border-color: #667eea; }
.chatbot-send-btn {
    background: linear-gradient(135deg, #667eea, #764ba2);
    border: none; color: white; width: 42px; height: 42px;
    border-radius: 12px; cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    transition: all 0.2s; flex-shrink: 0;
}
.chatbot-send-btn:hover   { transform: scale(1.05); }
.chatbot-send-btn:disabled { opacity: 0.5; cursor: not-allowed; transform: none; }
.chatbot-footer {
    text-align: center; font-size: 10px; color: #bbb;
    padding: 4px 0 8px; background: white;
}
.chatbot-error .chatbot-bubble {
    background: #fff0f0 !important; color: #e53e3e !important;
    border: 1px solid #fed7d7;
}
/* ✅ Bouton TTS */
.chatbot-speak-btn {
    background: none; border: none; cursor: pointer;
    font-size: 13px; padding: 2px 5px;
    border-radius: 6px; transition: background 0.2s; line-height: 1;
}
.chatbot-speak-btn:hover { background: rgba(102,126,234,0.1); }
@media (max-width: 480px) {
    .chatbot-window { width: calc(100vw - 20px); right: -10px; }
    .chatbot-wrapper { bottom: 20px; right: 20px; }
}
</style>

{# ====== JavaScript ====== #}
<script>
(function () {
    const ASK_URL   = '{{ path('chatbot_ask', {id: course.id}) }}';
    const HIST_URL  = '{{ path('chatbot_history', {id: course.id}) }}';
    const CLEAR_URL = '{{ path('chatbot_clear', {id: course.id}) }}';

    const toggle    = document.getElementById('chatbot-toggle');
    const window_   = document.getElementById('chatbot-window');
    const iconOpen  = document.getElementById('chatbot-icon-open');
    const iconClose = document.getElementById('chatbot-icon-close');
    const messages  = document.getElementById('chatbot-messages');
    const input     = document.getElementById('chatbot-input');
    const sendBtn   = document.getElementById('chatbot-send');
    const typing    = document.getElementById('chatbot-typing');
    const clearBtn  = document.getElementById('chatbot-clear');
    const badge     = document.getElementById('chatbot-badge');
    const stopTtsBtn = document.getElementById('chatbot-stop-tts');

    let isOpen    = false;
    let isSending = false;
    let lastSentTime = 0;
    let currentUtterance = null;

    // ── Ouvrir / Fermer ──────────────────────────────────────────────
    toggle.addEventListener('click', () => {
        isOpen = !isOpen;
        window_.style.display = isOpen ? 'flex' : 'none';
        iconOpen.style.display  = isOpen ? 'none' : 'flex';
        iconClose.style.display = isOpen ? 'flex' : 'none';
        badge.style.display = 'none';
        if (isOpen) {
            loadHistory();
            setTimeout(() => input.focus(), 300);
        }
    });

    // ── Charger l'historique ─────────────────────────────────────────
    function loadHistory() {
        fetch(HIST_URL)
            .then(r => r.json())
            .then(data => {
                if (data.success && data.messages.length > 0) {
                    data.messages.forEach(m => {
                        appendMessage(m.question, 'user', m.created_at);
                        appendMessage(m.answer,   'bot',  m.created_at);
                    });
                    scrollToBottom();
                }
            })
            .catch(() => {});
    }

    // ── Envoyer une question ─────────────────────────────────────────
    function sendQuestion() {
        const question = input.value.trim();
        if (!question || isSending) return;

        const now = Date.now();
        if (now - lastSentTime < 5000) {
            const remaining = Math.ceil((5000 - (now - lastSentTime)) / 1000);
            appendMessage(`⏳ Attendez encore ${remaining} seconde(s).`, 'bot-error');
            scrollToBottom();
            return;
        }

        isSending = true;
        lastSentTime = now;
        sendBtn.disabled = true;
        input.value = '';
        autoResize();
        appendMessage(question, 'user');
        showTyping(true);
        scrollToBottom();

        fetch(ASK_URL, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ question })
        })
        .then(r => r.json())
        .then(data => {
            showTyping(false);
            if (data.success) {
                appendMessage(data.answer, 'bot', data.time);
            } else {
                appendMessage(data.error || 'Une erreur est survenue.', 'bot-error');
                lastSentTime = 0;
            }
        })
        .catch(() => {
            showTyping(false);
            appendMessage('Erreur réseau.', 'bot-error');
            lastSentTime = 0;
        })
        .finally(() => {
            isSending = false;
            setTimeout(() => { sendBtn.disabled = false; input.focus(); }, 5000);
            scrollToBottom();
        });
    }

    // ── Ajouter un message ───────────────────────────────────────────
    function appendMessage(text, type, time) {
        const div = document.createElement('div');
        div.className = 'chatbot-msg ' + (type === 'user' ? 'user' : 'bot') + (type === 'bot-error' ? ' chatbot-error' : '');

        const bubble = document.createElement('div');
        bubble.className = 'chatbot-bubble';
        bubble.textContent = text;

        const timeDiv = document.createElement('div');
        timeDiv.className = 'chatbot-time';
        timeDiv.textContent = time || getCurrentTime();

        // ✅ Bouton TTS uniquement pour les réponses du bot
        if (type === 'bot') {
            const speakBtn = document.createElement('button');
            speakBtn.className = 'chatbot-speak-btn';
            speakBtn.title = 'Écouter la réponse';
            speakBtn.innerHTML = '🔊';
            speakBtn.onclick = () => speakText(text, speakBtn);
            timeDiv.appendChild(speakBtn);
        }

        div.appendChild(bubble);
        div.appendChild(timeDiv);
        messages.appendChild(div);
    }

    // ── Text-to-Speech ───────────────────────────────────────────────
function speakText(text, btn, lang = 'fr-FR') {
    const cleanText = text.replace(/\*\*/g, '').replace(/\*/g, '').replace(/#{1,6}\s/g, '').replace(/_/g, '').replace(/`/g, '').trim();

    if (window.speechSynthesis.speaking) {
        window.speechSynthesis.cancel();
        document.querySelectorAll('.chatbot-speak-btn').forEach(b => b.innerHTML = '🔊');
        if (currentUtterance && currentUtterance._btn === btn) {
            currentUtterance = null;
            return;
        }
    }

    const utterance = new SpeechSynthesisUtterance(cleanText);
    utterance.lang = lang; // ✅ dynamique
    utterance.rate = 0.95;
    utterance.pitch = 1;
    utterance._btn = btn;
    currentUtterance = utterance;

    const voices = window.speechSynthesis.getVoices();
    const voice = voices.find(v => v.lang.startsWith(lang.split('-')[0]));
    if (voice) utterance.voice = voice;

    btn.innerHTML = '⏹️';
    utterance.onend = () => { btn.innerHTML = '🔊'; currentUtterance = null; };
    utterance.onerror = () => { btn.innerHTML = '🔊'; currentUtterance = null; };
    window.speechSynthesis.speak(utterance);
}

    // ── Bouton Stop TTS ──────────────────────────────────────────────
    stopTtsBtn.addEventListener('click', () => {
        window.speechSynthesis.cancel();
        document.querySelectorAll('.chatbot-speak-btn').forEach(b => b.innerHTML = '🔊');
        stopTtsBtn.style.display = 'none';
        currentUtterance = null;
    });

    setInterval(() => {
        stopTtsBtn.style.display = window.speechSynthesis.speaking ? 'block' : 'none';
    }, 500);

    // ── Effacer l'historique ─────────────────────────────────────────
    clearBtn.addEventListener('click', () => {
        if (!confirm('Effacer tout l\'historique ?')) return;
        fetch(CLEAR_URL, { method: 'POST' })
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    messages.innerHTML = `
                        <div class="chatbot-msg bot">
                            <div class="chatbot-bubble">🗑️ Historique effacé.</div>
                            <div class="chatbot-time">${getCurrentTime()}</div>
                        </div>`;
                }
            });
    });

    // ── Helpers ──────────────────────────────────────────────────────
    function showTyping(show) { typing.style.display = show ? 'block' : 'none'; if (show) scrollToBottom(); }
    function scrollToBottom() { setTimeout(() => { messages.scrollTop = messages.scrollHeight; }, 50); }
    function getCurrentTime() { return new Date().toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' }); }
    function autoResize() { input.style.height = 'auto'; input.style.height = Math.min(input.scrollHeight, 100) + 'px'; }

    input.addEventListener('input', autoResize);
    input.addEventListener('keydown', e => { if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); sendQuestion(); } });
    sendBtn.addEventListener('click', sendQuestion);

    // Précharger les voix TTS
    window.speechSynthesis.onvoiceschanged = () => window.speechSynthesis.getVoices();
// ── Traduction ───────────────────────────────────────────────
const COURSE_DESC = {{ course.description|striptags|json_encode|raw }};
const COURSE_TITRE = {{ course.titre|json_encode|raw }};

window.translateCourse = function(lang) {
    const langNames = { 'en': 'anglais', 'ar': 'arabe', 'fr': 'français' };
    const langName = langNames[lang];

    // Désactiver les boutons pendant la traduction
    document.querySelectorAll('.chatbot-translate-btn').forEach(b => b.disabled = true);

    const question = `Traduis en ${langName} le titre et la description suivants du cours. 
Titre : "${COURSE_TITRE}"
Description : "${COURSE_DESC.substring(0, 400)}"
Réponds UNIQUEMENT avec :
**Titre :** [traduction du titre]
**Description :** [traduction de la description]`;

    appendMessage(`🌐 Traduction en ${langName}...`, 'user');
    showTyping(true);
    scrollToBottom();

    fetch(ASK_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ question })
    })
    .then(r => r.json())
    .then(data => {
        showTyping(false);
        if (data.success) {
            // Pour l'arabe, afficher en RTL
            const isArabic = lang === 'ar';
            appendMessageTranslation(data.answer, isArabic);
        } else {
            appendMessage(data.error || 'Erreur de traduction.', 'bot-error');
        }
    })
    .catch(() => {
        showTyping(false);
        appendMessage('Erreur réseau.', 'bot-error');
    })
    .finally(() => {
        document.querySelectorAll('.chatbot-translate-btn').forEach(b => b.disabled = false);
        scrollToBottom();
    });
};

// Message spécial pour la traduction (support RTL arabe)
function appendMessageTranslation(text, isRTL = false) {
    const div = document.createElement('div');
    div.className = 'chatbot-msg bot';

    const bubble = document.createElement('div');
    bubble.className = 'chatbot-bubble';
    bubble.textContent = text.replace(/\*\*/g, '').replace(/\*/g, '');

    if (isRTL) {
        bubble.style.direction = 'rtl';
        bubble.style.textAlign = 'right';
        bubble.style.fontFamily = 'Arial, sans-serif';
    }

    const timeDiv = document.createElement('div');
    timeDiv.className = 'chatbot-time';
    timeDiv.textContent = getCurrentTime();

    const speakBtn = document.createElement('button');
    speakBtn.className = 'chatbot-speak-btn';
    speakBtn.title = 'Écouter';
    speakBtn.innerHTML = '🔊';
    speakBtn.onclick = () => speakText(text, speakBtn, isRTL ? 'ar-TN' : 'fr-FR');
    timeDiv.appendChild(speakBtn);

    div.appendChild(bubble);
    div.appendChild(timeDiv);
    messages.appendChild(div);
}
})();
</script>
{% endif %}

{% endblock %}