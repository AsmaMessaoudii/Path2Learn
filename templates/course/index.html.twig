                        </div>
                        <div>
                            <h5 class="mb-0 fw-bold">{{ pagination.getTotalItemCount }}</h5>
                            <p class="mb-0 small text-muted">Cours publiés</p>
                        </div>
                    </div>
                    <div class="d-flex align-items-center">
                        <div class="stat-icon bg-success-soft rounded-circle p-3 me-3">
                            <i class="bi bi-clock-fill text-success fs-4"></i>
                        </div>
                        <div>
                            <h5 class="mb-0 fw-bold">{{ totalHours }}min</h5>
                            <p class="mb-0 small text-muted">Heures de contenu</p>
