                    <div class="d-flex align-items-center">
                        <div class="stat-icon bg-warning-soft rounded-circle p-3 me-3">
                            <i class="bi bi-award-fill text-warning fs-4"></i>
                        </div>
                        <div>
                            <h5 class="mb-0 fw-bold">100%</h5>
                            <p class="mb-0 small text-muted">Contenu vérifié</p>
                        </div>
                    </div>
                </div>

                <!-- Section d'export PDF -->
                <div class="mb-4">
                    <div class="d-flex flex-wrap gap-2 align-items-center">
                        <span class="text-muted">Export PDF :</span>
                        <a href="{{ path('all_courses_pdf') }}" class="btn btn-sm btn-outline-danger rounded-pill px-4" target="_blank">
                            <i class="fas fa-file-pdf me-2"></i>Tous les cours
                        </a>
                        {% if coursesWithData|length > 0 %}
                        <div class="dropdown">
                            <button class="btn btn-sm btn-outline-primary rounded-pill px-4 dropdown-toggle" type="button" id="exportDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="fas fa-download me-2"></i>Exporter
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0" aria-labelledby="exportDropdown">
                                {% for courseData in coursesWithData|slice(0, 5) %}
                                <li>
                                    <a class="dropdown-item" href="{{ path('course_pdf', {'id': courseData.course.id}) }}" target="_blank">
                                        <i class="fas fa-graduation-cap me-2 text-primary"></i>{{ courseData.course.titre|slice(0, 30) }}{% if courseData.course.titre|length > 30 %}...{% endif %}
                                    </a>
                                </li>
                                {% endfor %}
                                {% if coursesWithData|length > 5 %}
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item text-center fw-bold" href="{{ path('all_courses_pdf') }}" target="_blank">
                                        <i class="fas fa-list me-2"></i>Tous les cours
                                    </a>
                                </li>
                                {% endif %}
                            </ul>
                        </div>
                        {% endif %}
                    </div>
                </div>
                
            </div>
            <!-- Left content END -->

