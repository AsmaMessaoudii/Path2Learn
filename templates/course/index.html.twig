Main Banner END -->

<!-- =======================
Tabs filter START -->
<section class="pt-4 pb-5">
    <div class="container">
        <!-- Tabs navigation -->
        <div class="d-flex justify-content-center mb-5">
            <ul class="nav nav-pills custom-nav-pills" id="courses-pills-tab" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active rounded-pill px-4 py-2 mx-1" id="courses-pills-all-tab" data-bs-toggle="pill" data-bs-target="#courses-pills-tabs-all" type="button" role="tab" aria-controls="courses-pills-tabs-all" aria-selected="true">
                        <i class="fas fa-th-large me-2"></i>Tous les cours
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link rounded-pill px-4 py-2 mx-1" id="courses-pills-dev-tab" data-bs-toggle="pill" data-bs-target="#courses-pills-tabs-dev" type="button" role="tab" aria-controls="courses-pills-tabs-dev" aria-selected="false">
                        <i class="fas fa-code me-2"></i>Développement
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link rounded-pill px-4 py-2 mx-1" id="courses-pills-design-tab" data-bs-toggle="pill" data-bs-target="#courses-pills-tabs-design" type="button" role="tab" aria-controls="courses-pills-tabs-design" aria-selected="false">
                        <i class="fas fa-paint-brush me-2"></i>Design
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link rounded-pill px-4 py-2 mx-1" id="courses-pills-business-tab" data-bs-toggle="pill" data-bs-target="#courses-pills-tabs-business" type="button" role="tab" aria-controls="courses-pills-tabs-business" aria-selected="false">
                        <i class="fas fa-chart-line me-2"></i>Business
                    </button>
                </li>
            </ul>
        </div>

        <!-- Tabs content START -->
        <div class="tab-content" id="courses-pills-tabContent">
            <!-- All courses START -->
            <div class="tab-pane fade show active" id="courses-pills-tabs-all" role="tabpanel" aria-labelledby="courses-pills-all-tab">
                <div class="row g-4">
                    {% if pagination|length > 0 %}
                        {% for course in pagination %}
                            {# Trouver les données correspondantes dans coursesWithData #}
                            {% set courseData = null %}
                            {% for data in coursesWithData %}
                                {% if data.course.id == course.id %}
                                    {% set courseData = data %}
                                {% endif %}
                            {% endfor %}
                            
                            {% if courseData %}
                                {% set resources = courseData.resources %}
                                {% set likes = courseData.likes %}
                                {% set dislikes = courseData.dislikes %}
                                {% set averageRating = courseData.averageRating %}
                                {% set userReaction = courseData.userReaction %}
                                {% set userEvaluation = courseData.userEvaluation %}
                            {% else %}
                                {% set resources = [] %}
                                {% set likes = 0 %}
                                {% set dislikes = 0 %}
                                {% set averageRating = null %}
                                {% set userReaction = null %}
                                {% set userEvaluation = null %}
                            {% endif %}
                            
                            <!-- Font Awesome -->
                            <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
                            
                            <!-- Card item START -->
                            <div class="col-sm-6 col-lg-4 col-xl-3">
                                <div class="card shadow-sm h-100 position-relative course-card border-0" data-course-id="{{ course.id }}">
                                    <!-- Badge QR code -->
                                    <div class="position-absolute top-0 start-0 m-3 z-3 d-flex gap-2">
                                        <button type="button" 
                                            class="btn btn-sm btn-light rounded-circle p-2 qr-code-btn" 
                                            data-course-id="{{ course.id }}"
                                            data-course-title="{{ course.titre|escape('js') }}"
                                            data-course-url="{{ absolute_url(path('course_show', {'id': course.id}))|escape('js') }}"
                                            data-bs-toggle="tooltip" 
                                            title="Voir le QR code"
                                            style="width: 35px; height: 35px; background: rgba(255,255,255,0.9); border: none;">
                                            <i class="fas fa-qrcode text-primary"></i>
                                        </button>
                                    </div>

<div class="position-absolute top-0 end-0 m-3 z-3">
    <a href="#" class="favorite-btn" 
       data-course-id="{{ course.id }}" 
       onclick="event.preventDefault(); event.stopPropagation(); toggleFavorite({{ course.id }})">
        {% if course.id in userFavorites %}
            <i class="fas fa-heart" style="color: #ff3366; filter: drop-shadow(0 2px 8px rgba(255,51,102,0.5));"></i>
        {% else %}
            <i class="far fa-heart" style="color: white; text-shadow: 0 2px 4px rgba(0,0,0,0.5);"></i>
        {% endif %}
    </a>
</div>
                                    
                                    <div class="card-body p-4">
                                        <!-- Matière et niveau -->
                                        <div class="d-flex gap-2 mb-3 flex-wrap">
                                            <span class="badge bg-primary-soft text-primary px-3 py-2 rounded-pill">
                                                <i class="fas fa-tag me-1"></i>{{ course.matiere|default('Général') }}
                                            </span>
                                            <span class="badge bg-info-soft text-info px-3 py-2 rounded-pill">
                                                <i class="fas fa-signal me-1"></i>{{ course.niveau|default('Tous niveaux') }}
                                            </span>
                                        </div>
                                        
                                        <!-- Titre -->
                                        <h5 class="card-title mb-3">
                                            <a href="{{ path('course_show', {'id': course.id}) }}" class="text-dark text-decoration-none course-title-link">
                                                {{ course.titre }}
                                            </a>
                                        </h5>
                                        
                                        <p class="text-muted small mb-3">{{ course.description|default('Description non disponible')|slice(0, 100) }}...</p>
                                        
                                        <!-- Instructeur avec avatar -->
                                        <div class="d-flex align-items-center mb-4">
                                            <div class="avatar me-2">
                                                <i class="fas fa-user-circle fa-2x text-primary"></i>
                                            </div>
                                            <div>
                                                <h6 class="mb-0 small fw-semibold">{{ course.emailProf|default('Formateur Path2Learn') }}</h6>
                                                <small class="text-muted">Instructeur</small>
                                            </div>
                                        </div>
                                        
                                        <!-- Section LIKE/DISLIKE -->
                                        <div class="mb-4">
                                            <div class="d-flex align-items-center justify-content-between">
                                                <!-- Like/Dislike buttons -->
                                                <div class="d-flex gap-2">
                                                    <button type="button" 
                                                            class="reaction-btn {% if userReaction == 'like' %}active{% endif %}"
                                                            onclick="handleReaction({{ course.id }}, 'like')"
                                                            data-course-id="{{ course.id }}">
                                                        <span class="reaction-icon">
                                                            <i class="{% if userReaction == 'like' %}fas{% else %}far{% endif %} fa-thumbs-up"></i>
                                                        </span>
                                                        <span class="reaction-count likes-count">{{ likes }}</span>
                                                    </button>
                                                    
                                                    <button type="button" 
                                                            class="reaction-btn {% if userReaction == 'dislike' %}active dislike{% endif %}"
                                                            onclick="handleReaction({{ course.id }}, 'dislike')"
                                                            data-course-id="{{ course.id }}">
                                                        <span class="reaction-icon">
                                                            <i class="{% if userReaction == 'dislike' %}fas{% else %}far{% endif %} fa-thumbs-down"></i>
                                                        </span>
                                                        <span class="reaction-count dislikes-count">{{ dislikes }}</span>
                                                    </button>
                                                </div>
                                                
                                                <!-- Note moyenne -->
                                                <div class="rating-modern" data-bs-toggle="tooltip" title="Note moyenne sur 100">
                                                    {% if averageRating is not null and averageRating > 0 %}
                                                        <div class="d-flex align-items-center">
                                                            <div class="rating-circle">
                                                                <span class="rating-value">{{ averageRating|number_format(1) }}</span>
                                                            </div>
                                                            <span class="rating-max ms-1">/100</span>
                                                        </div>
                                                    {% else %}
                                                        <span class="badge bg-light text-muted px-3 py-2 rounded-pill">
                                                            <i class="far fa-star me-1"></i>Non noté
                                                        </span>
                                                    {% endif %}
                                                </div>
                                            </div>
                                            
                                            <!-- Note utilisateur -->
                                            {% if app.user %}
                                                <div class="user-rating-modern mt-3 p-3" onclick="event.stopPropagation()">
                                                    <div class="d-flex align-items-center justify-content-between mb-2">
                                                        <span class="small fw-semibold text-muted">
                                                            <i class="far fa-star me-1"></i>Votre note
                                                        </span>
                                                        <span class="small text-primary fw-bold" id="rating-percent-{{ course.id }}">
                                                            {% if userEvaluation is not null %}{{ userEvaluation }}%{% else %}0%{% endif %}
                                                        </span>
                                                    </div>
                                                    <div class="rating-slider-container">
                                                        <input type="range" 
                                                               class="rating-slider" 
                                                               min="0" 
                                                               max="100" 
                                                               step="1"
                                                               value="{{ userEvaluation is not null ? userEvaluation : 0 }}"
                                                               id="rating-slider-{{ course.id }}"
                                                               oninput="updateRatingValue({{ course.id }}, this.value)">
                                                        <div class="rating-scale d-flex justify-content-between px-1 mt-1">
                                                            <span class="small text-muted">0</span>
                                                            <span class="small text-muted">25</span>
                                                            <span class="small text-muted">50</span>
                                                            <span class="small text-muted">75</span>
                                                            <span class="small text-muted">100</span>
                                                        </div>
                                                    </div>
                                                    <div class="d-flex justify-content-end mt-2">
                                                        <button class="btn btn-sm btn-primary px-4 rounded-pill" 
                                                                onclick="submitModernRating({{ course.id }})">
                                                            <i class="fas fa-check me-1"></i>Noter
                                                        </button>
                                                    </div>
                                                </div>
                                            {% endif %}
                                        </div>
                                        
                                        <!-- Section des ressources -->
                                        {% if resources|length > 0 %}
                                            <div class="mb-3">
                                                <div class="d-flex flex-wrap gap-2">
                                                    {% for resource in resources|slice(0, 3) %}
                                                        <span class="resource-badge" onclick="event.stopPropagation()">
                                                            {% if resource.type == '-' or (resource.type is not defined and 'pdf' in resource.titre|lower) %}
                                                                <i class="fas fa-file-pdf text-danger"></i>
                                                            {% elseif resource.type == 'video' or (resource.type is not defined and 'vidéo' in resource.titre|lower) %}
                                                                <i class="fas fa-play-circle text-primary"></i>
                                                            {% elseif resource.type == 'lien' or resource.type == 'link' %}
                                                                <i class="fas fa-link text-success"></i>
                                                            {% elseif resource.type == 'image' or (resource.type is not defined and 'image' in resource.titre|lower) %}
                                                                <i class="fas fa-image text-info"></i>
                                                            {% else %}
                                                                <i class="fas fa-file-alt text-secondary"></i>
                                                            {% endif %}
                                                            <span class="ms-1">{{ resource.titre|slice(0, 8) }}{% if resource.titre|length > 8 %}...{% endif %}</span>
                                                        </span>
                                                    {% endfor %}
                                                    {% if resources|length > 3 %}
                                                        <span class="resource-badge more">
                                                            <i class="fas fa-plus-circle"></i>
                                                            <span class="ms-1">{{ resources|length - 3 }}</span>
                                                        </span>
                                                    {% endif %}
                                                </div>
                                            </div>
                                        {% else %}
                                            <div class="mb-3">
                                                <p class="small text-muted mb-0">
                                                    <i class="far fa-folder-open me-1"></i>Aucune ressource
                                                </p>
                                            </div>
                                        {% endif %}
                                        
                                        <!-- Durée et date -->
                                        <div class="d-flex justify-content-between align-items-center border-top pt-3 mt-3">
                                            <div class="d-flex align-items-center text-muted small">
                                                <i class="far fa-clock me-1"></i>
                                                <span>{{ course.duree|default(0) }} min</span>
                                            </div>
                                            <div class="d-flex align-items-center text-muted small">
                                                <i class="far fa-calendar-alt me-1"></i>
                                                <span>{{ course.dateCreation|date('d M Y') }}</span>
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <!-- Card footer avec boutons PDF -->
                                    <div class="card-footer bg-light border-0 p-3" onclick="event.stopPropagation()">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <!-- Boutons PDF -->
                                            <div class="dropdown">
                                                <button class="btn btn-sm btn-outline-secondary rounded-pill px-3" type="button" id="pdfDropdown{{ course.id }}" data-bs-toggle="dropdown" aria-expanded="false">
                                                    <i class="fas fa-file-pdf me-1"></i>PDF
                                                </button>
                                                <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0" aria-labelledby="pdfDropdown{{ course.id }}">
                                                    <li>
                                                        <a class="dropdown-item" href="{{ path('course_pdf', {'id': course.id}) }}" target="_blank">
                                                            <i class="fas fa-graduation-cap me-2 text-primary"></i>Fiche du cours
                                                        </a>
                                                    </li>
                                                    <li>
                                                        <a class="dropdown-item" href="{{ path('course_ressources_pdf', {'id': course.id}) }}" target="_blank">
                                                            <i class="fas fa-book me-2 text-success"></i>Ressources PDF
                                                        </a>
                                                    </li>
                                                </ul>
                                            </div>
                                            <!-- Bouton Voir le cours -->
                                            <a href="{{ path('course_show', {'id': course.id}) }}" class="btn btn-sm btn-primary rounded-pill px-4">
                                                Voir le cours
                                                <i class="fas fa-arrow-right ms-1"></i>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <!-- Card item END -->
                        {% endfor %}
                    {% else %}
                        <div class="col-12">
                            <div class="text-center py-5">
                                {% if searchQuery %}
                                    <i class="fas fa-search display-1 text-muted mb-4"></i>
                                    <h3 class="mb-3">Aucun résultat trouvé</h3>
                                    <p class="text-muted mb-4">
                                        Aucun cours ne correspond à votre recherche : <strong>"{{ searchQuery }}"</strong>
                                    </p>
                                    <div class="d-flex justify-content-center gap-3">
                                        <a href="{{ path('app_courses') }}" class="btn btn-primary rounded-pill px-5 py-3">
                                            <i class="fas fa-undo me-2"></i>Afficher tous les cours
                                        </a>
