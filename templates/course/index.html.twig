<script>
// Gestion du scroll après changement de page
document.addEventListener('DOMContentLoaded', function() {
    // Vérifier si on vient d'un changement de page
    if (window.location.hash === '#courses-list') {
        setTimeout(function() {
            const target = document.getElementById('courses-list');
            if (target) {
                const headerHeight = document.querySelector('.navbar-sticky')?.offsetHeight || 100;
                const targetPosition = target.getBoundingClientRect().top + window.pageYOffset - headerHeight - 20;
                
                window.scrollTo({
                    top: targetPosition,
                    behavior: 'smooth'
                });
            }
        }, 100);
    }
    
    // Intercepter les clics sur les liens de pagination
    document.querySelectorAll('.pagination a.page-link').forEach(link => {
        link.addEventListener('click', function(e) {
            sessionStorage.setItem('scrollPosition', window.pageYOffset);
            sessionStorage.setItem('targetPage', this.getAttribute('href').split('page=')[1]?.split('&')[0] || '1');
        });
    });
    
    // Restaurer la position si on revient en arrière
    const savedPosition = sessionStorage.getItem('scrollPosition');
    if (savedPosition && document.referrer.includes(window.location.hostname)) {
        setTimeout(() => {
            window.scrollTo({
                top: parseInt(savedPosition),
                behavior: 'smooth'
            });
            sessionStorage.removeItem('scrollPosition');
        }, 100);
    }
    
    // Ajouter data-course-id aux cartes pour faciliter la sélection
    document.querySelectorAll('.course-card').forEach(card => {
        const courseId = card.querySelector('[data-course-id]')?.dataset.courseId;
        if (courseId) {
            card.setAttribute('data-course-id', courseId);
        }
    });
    
    // Attacher les événements aux boutons QR code
    document.querySelectorAll('.qr-code-btn').forEach(btn => {
        btn.addEventListener('click', function(e) {
            e.stopPropagation();
            e.preventDefault();
            const courseId = this.dataset.courseId;
            const courseTitle = this.dataset.courseTitle;
            const courseUrl = this.dataset.courseUrl;
            openQRModal(courseId, courseTitle, courseUrl);
        });
    });
    
    // Empêcher la propagation des clics sur les éléments interactifs
    document.querySelectorAll('[onclick], .dropdown, .btn, .badge, .resource-badge, .favorite-btn').forEach(element => {
        element.addEventListener('click', function(e) {
            e.stopPropagation();
        });
    });
    
    // Ajouter des écouteurs pour les liens PDF
    document.querySelectorAll('a[href*="pdf"]').forEach(link => {
        link.addEventListener('click', function(e) {
            if (!this.target || this.target === '_self') {
                e.preventDefault();
                window.open(this.href, '_blank');
                showPdfNotification();
            }
        });
    });
});

// Variables globales pour le modal de notation
let currentRatingCourseId = null;
let currentRatingValue = 0;

// Fonction pour mettre à jour la valeur du rating
window.updateRatingValue = function(courseId, value) {
    const percentSpan = document.getElementById(`rating-percent-${courseId}`);
    if (percentSpan) {
        percentSpan.textContent = value + '%';
    }
};

// UNE SEULE FONCTION submitModernRating (celle avec les logs)
window.submitModernRating = function(courseId) {
    console.log('submitModernRating appelé pour courseId:', courseId);
    
    if (!isAuthenticated) {
        showNotification('Veuillez vous connecter pour noter les cours.', 'warning');
        setTimeout(() => {
            window.location.href = '{{ path("app_login") }}';
        }, 2000);
        return;
    }
    
    const slider = document.getElementById(`rating-slider-${courseId}`);
    if (!slider) {
        console.error('Slider non trouvé pour courseId:', courseId);
        return;
    }
    
    const note = parseInt(slider.value);
    console.log('Note sélectionnée:', note);
    
    // Si note < 30, afficher le modal de raisons
    if (note < 30) {
        console.log('Note inférieure à 30, affichage du modal');
        currentRatingCourseId = courseId;
        currentRatingValue = note;
        showRatingReasonModal(courseId, note);
    } else {
        console.log('Note supérieure ou égale à 30, envoi direct');
        // Sinon, envoyer directement la note
        submitRating(courseId, note);
    }
};

// Fonction pour soumettre la note (avec ou sans raison)
function submitRating(courseId, note, reason = null, customReason = null) {
    console.log('submitRating appelé', {courseId, note, reason, customReason});
    
    // Utiliser le path Symfony au lieu de construire l'URL manuellement
    let url;
    if (reason) {
        // Utiliser la route Symfony
        url = '{{ path("course_rate_with_reason", {"id": "COURSE_ID"}) }}'.replace('COURSE_ID', courseId);
    } else {
        url = '{{ path("course_rate", {"id": "COURSE_ID"}) }}'.replace('COURSE_ID', courseId);
    }
    
    const data = reason 
        ? { note: note, reason: reason, customReason: customReason }
        : { note: note };
    
    fetch(url, {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'X-Requested-With': 'XMLHttpRequest'
        },
        body: JSON.stringify(data)
    })
    .then(response => {
        if (!response.ok) {
            return response.json().then(err => { throw new Error(err.error || 'Erreur réseau'); });
        }
        return response.json();
    })
    .then(data => {
        console.log('Réponse reçue:', data);
        
        if (data.success) {
            // Mettre à jour le cercle de notation
            const card = document.querySelector(`.course-card[data-course-id="${courseId}"]`);
            if (card) {
                const ratingCircle = card.querySelector('.rating-value');
                if (ratingCircle && data.averageRating) {
                    ratingCircle.textContent = data.averageRating.toFixed(1);
                }
                
                // Mettre à jour le tooltip
                const ratingBadge = card.querySelector('.rating-modern');
                if (ratingBadge) {
                    ratingBadge.setAttribute('title', `Note moyenne : ${data.averageRating.toFixed(1)}/100`);
                }
            }
            
            showNotification(data.message, 'success');
            
            // Fermer le modal si ouvert
            const modalElement = document.getElementById('ratingReasonModal');
            if (modalElement) {
                const modal = bootstrap.Modal.getInstance(modalElement);
                if (modal) {
                    modal.hide();
                }
            }
        }
    })
    .catch(error => {
        console.error('Error:', error);
        showNotification('Erreur: ' + error.message, 'danger');
    });
}

// Fonction pour afficher le modal des raisons
function showRatingReasonModal(courseId, note) {
    const modalHtml = `
        <div class="modal fade" id="ratingReasonModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content border-0 shadow">
                    <div class="modal-header bg-warning text-dark border-0">
                        <h5 class="modal-title">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            Note faible : ${note}/100
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    
                    <div class="modal-body p-4">
                        <p class="mb-3">Vous avez donné une note inférieure à 30. Pour nous aider à améliorer ce cours, pourriez-vous nous indiquer la raison ?</p>
                        
                        <div class="mb-3">
                            <label class="form-label fw-bold">Raison principale :</label>
                            <div class="rating-reasons">
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="radio" name="ratingReason" id="reasonDifficile" value="contenu_difficile">
                                    <label class="form-check-label" for="reasonDifficile">
                                        Contenu trop difficile
                                    </label>
                                </div>
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="radio" name="ratingReason" id="reasonSimple" value="contenu_simple">
                                    <label class="form-check-label" for="reasonSimple">
                                        Contenu trop simple
                                    </label>
                                </div>
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="radio" name="ratingReason" id="reasonQualite" value="qualite_mediocre">
                                    <label class="form-check-label" for="reasonQualite">
                                        Qualité du cours médiocre
                                    </label>
                                </div>
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="radio" name="ratingReason" id="reasonTechnique" value="problemes_techniques">
                                    <label class="form-check-label" for="reasonTechnique">
                                        Problèmes techniques
                                    </label>
                                </div>
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="radio" name="ratingReason" id="reasonFormateur" value="formateur_peu_clair">
                                    <label class="form-check-label" for="reasonFormateur">
                                        Formateur peu clair
                                    </label>
                                </div>
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="radio" name="ratingReason" id="reasonExercices" value="manque_exercices">
                                    <label class="form-check-label" for="reasonExercices">
                                        Manque d'exercices pratiques
                                    </label>
                                </div>
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="radio" name="ratingReason" id="reasonRessources" value="ressources_insuffisantes">
                                    <label class="form-check-label" for="reasonRessources">
                                        Ressources insuffisantes
                                    </label>
                                </div>
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="radio" name="ratingReason" id="reasonAutre" value="autre">
                                    <label class="form-check-label" for="reasonAutre">
                                        Autre
                                    </label>
                                </div>
                            </div>
                        </div>
                        
                        <div class="mb-3 d-none" id="customReasonContainer">
                            <label for="customReason" class="form-label">Précisez votre raison :</label>
                            <textarea class="form-control" id="customReason" rows="3" placeholder="Expliquez pourquoi vous avez donné cette note..."></textarea>
                        </div>
                    </div>
                    
                    <div class="modal-footer border-0">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                        <button type="button" class="btn btn-primary" onclick="submitRatingWithReason()">
                            <i class="fas fa-paper-plane me-2"></i>Envoyer
                        </button>
                    </div>
                </div>
            </div>
        </div>
    `;
    
    // Supprimer l'ancien modal s'il existe
    const oldModal = document.getElementById('ratingReasonModal');
    if (oldModal) {
        oldModal.remove();
    }
    
    // Ajouter le nouveau modal
    document.body.insertAdjacentHTML('beforeend', modalHtml);
    
    // Gérer l'affichage du champ personnalisé
    document.querySelectorAll('input[name="ratingReason"]').forEach(radio => {
        radio.addEventListener('change', function() {
            const container = document.getElementById('customReasonContainer');
            if (this.value === 'autre') {
                container.classList.remove('d-none');
            } else {
                container.classList.add('d-none');
            }
        });
    });
    
    // Afficher le modal
    const modal = new bootstrap.Modal(document.getElementById('ratingReasonModal'));
    modal.show();
}

// Fonction pour soumettre la note avec la raison
function submitRatingWithReason() {
    const selectedReason = document.querySelector('input[name="ratingReason"]:checked');
    
    if (!selectedReason) {
        showNotification('Veuillez sélectionner une raison', 'warning');
        return;
    }
    
    const reason = selectedReason.value;
    let customReason = null;
    
    if (reason === 'autre') {
        customReason = document.getElementById('customReason').value;
        if (!customReason.trim()) {
            showNotification('Veuillez préciser votre raison', 'warning');
            return;
        }
    }
    
    submitRating(currentRatingCourseId, currentRatingValue, reason, customReason);
}

// Fonction pour gérer les réactions (like/dislike)
window.handleReaction = function(courseId, type) {
    if (!isAuthenticated) {
        showNotification('Veuillez vous connecter pour interagir avec les cours.', 'warning');
        setTimeout(() => {
            window.location.href = '{{ path("app_login") }}';
        }, 2000);
        return;
    }
    
    const url = type === 'like' 
        ? '{{ path("course_like", {"id": "COURSE_ID"}) }}'.replace('COURSE_ID', courseId)
        : '{{ path("course_dislike", {"id": "COURSE_ID"}) }}'.replace('COURSE_ID', courseId);
    
    fetch(url, {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'X-Requested-With': 'XMLHttpRequest'
        }
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            // Mettre à jour l'affichage
            const courseCard = document.querySelector(`.course-card[data-course-id="${courseId}"]`);
            if (courseCard) {
                // Mettre à jour les compteurs
                const likeCounts = courseCard.querySelectorAll('.likes-count');
                const dislikeCounts = courseCard.querySelectorAll('.dislikes-count');
                
                likeCounts.forEach(span => span.textContent = data.likes);
                dislikeCounts.forEach(span => span.textContent = data.dislikes);
                
                // Mettre à jour les classes actives
                const likeBtns = courseCard.querySelectorAll('.reaction-btn[onclick*="like"]');
                const dislikeBtns = courseCard.querySelectorAll('.reaction-btn[onclick*="dislike"]');
                
                likeBtns.forEach(btn => {
                    btn.classList.remove('active');
                    const icon = btn.querySelector('i');
                    if (icon) icon.className = 'far fa-thumbs-up';
                });
                
                dislikeBtns.forEach(btn => {
                    btn.classList.remove('active', 'dislike');
                    const icon = btn.querySelector('i');
                    if (icon) icon.className = 'far fa-thumbs-down';
                });
                
                if (data.userReaction === 'like') {
                    likeBtns.forEach(btn => {
                        btn.classList.add('active');
                        const icon = btn.querySelector('i');
                        if (icon) icon.className = 'fas fa-thumbs-up';
                    });
                } else if (data.userReaction === 'dislike') {
                    dislikeBtns.forEach(btn => {
                        btn.classList.add('active', 'dislike');
                        const icon = btn.querySelector('i');
                        if (icon) icon.className = 'fas fa-thumbs-down';
                    });
                }
            }
            
            showNotification(data.message, 'success');
        }
    })
    .catch(error => {
        console.error('Error:', error);
        showNotification('Une erreur est survenue', 'danger');
    });
};

// Fonction pour toggle favorite
window.toggleFavorite = function(courseId) {
    if (!isAuthenticated) {
        showNotification('Veuillez vous connecter pour ajouter aux favoris.', 'warning');
        setTimeout(() => { window.location.href = '{{ path("app_login") }}'; }, 2000);
        return;
    }
    
    const favoriteBtn = document.querySelector(`.favorite-btn[data-course-id="${courseId}"]`);
    if (!favoriteBtn) return;
    
    const heartIcon = favoriteBtn.querySelector('i');
    const url = '{{ path("course_toggle_favorite", {"id": "COURSE_ID"}) }}'.replace('COURSE_ID', courseId);
    
    fetch(url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' }
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            if (data.isFavorite) {
                // ✅ Remplir le cœur
                heartIcon.classList.remove('far');
                heartIcon.classList.add('fas');
                heartIcon.style.color = '#ff3366';
                heartIcon.style.filter = 'drop-shadow(0 2px 8px rgba(255,51,102,0.5))';
                heartIcon.style.textShadow = '';
                showNotification('❤️ Cours ajouté aux favoris', 'success');
            } else {
                // ✅ Vider le cœur
                heartIcon.classList.remove('fas');
                heartIcon.classList.add('far');
                heartIcon.style.color = 'white';
                heartIcon.style.filter = '';
                heartIcon.style.textShadow = '0 2px 4px rgba(0,0,0,0.5)';
                showNotification('Cours retiré des favoris', 'info');
            }
        }
    })
    .catch(() => showNotification('Une erreur est survenue', 'danger'));
};
// Search Recommendation Debounce
let searchTimeout;
window.debounceSearch = function(val) {
    clearTimeout(searchTimeout);
    searchTimeout = setTimeout(() => {
        searchRecommendations(val);
    }, 500);
};

window.searchRecommendations = function(interest) {
    const resultContainer = document.getElementById('recommendationResults');
    const list = document.getElementById('resultsList');
    
    if (!interest || interest.length < 2) {
        resultContainer.classList.add('d-none');
        return;
    }
    
    const url = '{{ path("course_recommendation_search") }}?interest=' + encodeURIComponent(interest);
    
    fetch(url)
        .then(response => response.json())
        .then(data => {
            list.innerHTML = '';
            if (data.results && data.results.length > 0) {
                resultContainer.classList.remove('d-none');
                data.results.forEach(course => {
                    const item = document.createElement('a');
                    item.href = '{{ path("course_show", {"id": 0}) }}'.replace('0', course.id);
                    item.className = 'list-group-item list-group-item-action bg-transparent text-white border-bottom border-secondary d-flex justify-content-between align-items-center px-0 py-2';
                    item.innerHTML = `
                        <div>
                            <h6 class="mb-0 text-white">${course.title}</h6>
                            <small class="text-white-50">${course.level} • ${course.author}</small>
                        </div>
                        <span class="badge bg-primary rounded-pill">${course.rating || 'N/A'}</span>
                    `;
                    list.appendChild(item);
                });
            } else {
                resultContainer.classList.remove('d-none');
                list.innerHTML = '<div class="text-white-50 text-center py-2">Aucun résultat</div>';
            }
        })
        .catch(err => console.error(err));
};

// Fonction pour afficher une notification
function showNotification(message, type) {
    const notification = document.createElement('div');
    notification.className = `alert alert-${type} alert-dismissible fade show notification`;
    notification.innerHTML = `
        <div class="d-flex align-items-center">
            <i class="fas ${type === 'success' ? 'fa-check-circle' : type === 'warning' ? 'fa-exclamation-triangle' : 'fa-info-circle'} me-2"></i>
            <span>${message}</span>
            <button type="button" class="btn-close ms-3" data-bs-dismiss="alert"></button>
        </div>
    `;
    document.body.appendChild(notification);
    
    setTimeout(() => {
        notification.classList.remove('show');
        setTimeout(() => notification.remove(), 300);
    }, 3000);
}

// Fonction pour afficher une notification PDF
window.showPdfNotification = function() {
    showNotification('PDF généré avec succès !', 'success');
};

// Fonction pour ouvrir le modal QR code
function openQRModal(courseId, courseTitle, courseUrl) {
    fetch(`/cours/qr-data/${courseId}`)
        .then(response => response.json())
        .then(data => {
            const jsonData = encodeURIComponent(JSON.stringify(data));
            
            const modalHtml = `
                <div class="modal fade" id="qrModal-${courseId}" tabindex="-1">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content border-0 shadow">
                            <div class="modal-header bg-primary text-white border-0">
                                <h5 class="modal-title">
                                    <i class="fas fa-qrcode me-2"></i>
                                    QR Code - ${courseTitle}
                                </h5>
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                            </div>
                            
                            <div class="modal-body text-center p-4">
                                <div class="mb-4 p-3 bg-light rounded-3">
                                    <img src="https://api.qrserver.com/v1/create-qr-code/?size=250x250&data=${jsonData}" 
                                         alt="QR Code" 
                                         class="img-fluid"
                                         style="max-width: 250px;">
                                </div>
                                
                                <h5 class="fw-bold">${courseTitle}</h5>
                                
                                <div class="text-start mb-3 p-2 bg-light rounded-3">
                                    <small class="text-muted">
                                        <i class="fas fa-info-circle me-1"></i>
                                        Ce QR code contient ${data.ressources_details ? data.ressources_details.length : 0} ressources
                                    </small>
                                </div>
                                
                                <div class="d-flex gap-2 justify-content-center mt-3">
                                    <a href="https://api.qrserver.com/v1/create-qr-code/?size=400x400&data=${jsonData}" 
                                       class="btn btn-primary rounded-pill px-4"
                                       target="_blank">
                                        <i class="fas fa-download me-2"></i>Télécharger
                                    </a>
                                    
                                    <button type="button" 
                                            class="btn btn-outline-secondary rounded-pill px-4"
                                            onclick="showQRPreview(${JSON.stringify(data).replace(/"/g, '&quot;')})">
                                        <i class="fas fa-eye me-2"></i>Aperçu
                                    </button>
                                    
                                    <button type="button" class="btn btn-outline-dark rounded-pill px-4" data-bs-dismiss="modal">
                                        Fermer
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            `;
            
            const oldModal = document.getElementById(`qrModal-${courseId}`);
            if (oldModal) oldModal.remove();
            
            document.body.insertAdjacentHTML('beforeend', modalHtml);
            
            const modal = new bootstrap.Modal(document.getElementById(`qrModal-${courseId}`));
            modal.show();
            
            document.getElementById(`qrModal-${courseId}`).addEventListener('hidden.bs.modal', function() {
                this.remove();
            });
        })
        .catch(error => {
            console.error('Erreur:', error);
            alert('Impossible de charger les données du cours');
        });
}

// Fonction pour montrer l'aperçu du QR code
function showQRPreview(data) {
    let message = "📦 DONNÉES DU QR CODE\n\n";
    message += `📚 Titre : ${data.titre}\n`;
    message += `📝 Description : ${data.description?.substring(0, 100)}...\n`;
    message += `📊 Ressources : ${data.ressources_details?.length || 0}\n`;
    if (data.statistiques) {
        message += `📄 PDF : ${data.statistiques.pdfs}\n`;
        message += `🎬 Vidéos : ${data.statistiques.videos}\n`;
        message += `🖼️ Images : ${data.statistiques.images}\n`;
    }
    alert(message);
}
// Dans votre fichier JS global ou dans la balise script
function generateSummary(courseId) {
    if (!isAuthenticated) {
        showNotification('Veuillez vous connecter pour générer un résumé', 'warning');
        setTimeout(() => {
            window.location.href = '{{ path("app_login") }}';
        }, 2000);
        return;
    }
    
    // Afficher un loader
    const btn = event?.target?.closest('button');
    if (btn) {
        btn.disabled = true;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Génération...';
    }
    
    const url = '{{ path("summary_generate", {"id": 0}) }}'.replace('0', courseId);
    
    fetch(url, {
        method: 'POST',
        headers: {
            'X-Requested-With': 'XMLHttpRequest'
        }
    })
    .then(response => response.json())
    .then(data => {
        if (btn) {
            btn.disabled = false;
            btn.innerHTML = '<i class="fas fa-sync-alt me-2"></i>Générer un résumé';
        }
        
        if (data.success) {
            showNotification(data.message, 'success');
            
            // Rediriger vers la page de résumé
            setTimeout(() => {
                window.location.href = '{{ path("summary_view", {"id": 0}) }}'.replace('0', courseId);
            }, 1500);
        } else {
            showNotification(data.error || 'Erreur lors de la génération', 'danger');
        }
    })
    .catch(error => {
        if (btn) {
            btn.disabled = false;
            btn.innerHTML = '<i class="fas fa-sync-alt me-2"></i>Générer un résumé';
        }
        
        console.error('Error:', error);
        showNotification('Erreur de connexion', 'danger');
    });
}
</script>


