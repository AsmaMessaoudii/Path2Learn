Recommendation Section START -->
<section class="pt-5 pb-0">
    <div class="container">
        <div class="row g-4">
            <!-- Recommendation Box -->
            <div class="col-lg-8">
                <div class="card bg-primary bg-opacity-10 h-100 p-4 border-0 rounded-4 overflow-hidden position-relative">
                    <!-- Decor -->
                    <div class="position-absolute top-0 end-0 mt-n3 me-n3">
                         <i class="bi bi-patch-check-fill display-1 text-primary opacity-10"></i>
                    </div>
                    
                    <div class="row g-4 align-items-center relative z-index-1">
                        <div class="col-md-6">
                            <div class="badge bg-primary text-white mb-3">Recommandé pour vous</div>
                            {% if topCourseData %}
                                <h3 class="mb-2">{{ topCourseData.course.titre }}</h3>
                                <p class="mb-3 text-truncate-2">{{ topCourseData.course.description|striptags|slice(0, 100) }}...</p>
                                
                                <div class="d-flex align-items-center mb-3">
                                    <div class="d-flex align-items-center me-4">
                                        <i class="fas fa-star text-warning me-1"></i>
                                        <span class="fw-bold text-dark">{{ topCourseData.averageRating|number_format(1) }}</span>
                                    </div>
                                    <div class="d-flex align-items-center">
                                        <i class="fas fa-thumbs-up text-success me-1"></i>
                                        <span class="fw-bold text-dark">{{ topCourseData.likes }} likes</span>
                                    </div>
                                </div>
                                
                                <a href="{{ path('course_show', {'id': topCourseData.course.id}) }}" class="btn btn-dark rounded-pill">
                                    Découvrir ce cours
                                </a>
                            {% else %}
                                <h3 class="mb-2">Découvrez nos meilleurs cours</h3>
                                <p class="mb-3">Explorez notre catalogue pour trouver le cours parfait pour vous.</p>
                                <a href="#courses-list" class="btn btn-dark rounded-pill">
                                    Voir tous les cours
                                </a>
                            {% endif %}
                        </div>
                        <div class="col-md-6 text-center">
                        </div>
                    </div>
                </div>
            </div>

            <!-- Interest Search Box -->
            <div class="col-lg-4">
                <div class="card bg-dark text-white h-100 p-4 border-0 rounded-4">
                    <h4 class="text-white mb-3">Vos centres d'intérêt</h4>
                    <p class="text-white-50 mb-4">Dites-nous ce que vous cherchez, nous trouverons les cours adaptés.</p>
                    
                    <div class="position-relative">
                        <input type="text" 
                               class="form-control form-control-lg bg-white bg-opacity-25 text-white border-0 mb-3" 
                               id="interestInput"
                               placeholder="Ex: Design, Python, Business..."
                               style="color: white !important; background-color: rgba(255,255,255,0.15) !important;"
                               onkeyup="debounceSearch(this.value)">
                        <span class="position-absolute top-50 end-0 translate-middle-y me-3">
                            <i class="fas fa-search text-white-50"></i>
                        </span>
                    </div>

                    <!-- Results Container -->
                    <div id="recommendationResults" class="d-none">
                        <h6 class="text-white mt-3 mb-2">Suggestions :</h6>
                        <div class="list-group list-group-flush bg-transparent" id="resultsList" style="max-height: 300px; overflow-y: auto;">
                            <!-- JS generates lines here -->
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
