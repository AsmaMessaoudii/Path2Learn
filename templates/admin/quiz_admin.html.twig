{# templates/admin/quiz_admin.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Quiz & Évaluations - IA activée{% endblock %}

{% block body %}
<div class="d-flex">

    <!-- SIDEBAR (inchangé) -->
    <nav class="sidebar vh-100 sticky-top bg-dark">
        <div class="p-4 h-100 d-flex flex-column">
            <h5 class="text-white mb-4">
                <i class="bi bi-patch-question-fill me-2"></i> Gestion des Quiz
            </h5>

            <div class="list-group list-group-flush flex-grow-1">
                <a class="list-group-item active" href="#">Questions</a>
                <a class="list-group-item" href="{{ path('questions_stats') }}">
                    <i class="bi bi-bar-chart-line me-2"></i>Statistiques
                </a>
                <a class="list-group-item mt-3" href="{{ path('admin_dashboard') }}">
                    ⬅ Retour Dashboard
                </a>
            </div>
        </div>
    </nav>

    <!-- MAIN CONTENT -->
    <div class="flex-grow-1 p-4" style="background:#f4f6f9;">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <h4>Questions & Choix</h4>
            <div>
                <span class="badge bg-info text-dark p-2">
                    <i class="bi bi-robot me-1"></i> IA Activée
                </span>
            </div>
        </div>

        {# BARRE DE RECHERCHE ET TRI (inchangé) #}
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body p-3">
                <div class="row align-items-center mb-3">
                    <div class="col-md-4">
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0">
                                <i class="bi bi-search"></i>
                            </span>
                            <input type="text" 
                                   id="searchInput" 
                                   class="form-control border-start-0" 
                                   placeholder="Rechercher une question..."
                                   autocomplete="off">
                        </div>
                    </div>
                    
                    <div class="col-md-3">
                        <select id="searchType" class="form-select">
                            <option value="titre">Par titre</option>
                            <option value="duree">Par durée</option>
                            <option value="noteMax">Par note max</option>
                            <option value="description">Par description</option>
                        </select>
                    </div>
                    
                    <div class="col-md-3">
                        <button type="button" id="searchBtn" class="btn btn-primary w-100">
                            <i class="bi bi-search me-2"></i>Rechercher
                        </button>
                    </div>
                    
                    <div class="col-md-2">
                        <button type="button" id="clearSearch" class="btn btn-outline-secondary w-100">
                            <i class="bi bi-x-circle me-2"></i>Effacer
                        </button>
                    </div>
                </div>
                
                {# OPTIONS DE TRI (inchangé) #}
                <div class="row align-items-center">
                    <div class="col-md-4">
                        <div class="d-flex align-items-center">
                            <span class="me-2 text-muted">
                                <i class="bi bi-sort-down"></i> Trier par:
                            </span>
                            <select id="sortBy" class="form-select form-select-sm">
                                <option value="titre">Titre</option>
                                <option value="duree">Durée</option>
                                <option value="noteMax">Note max</option>
                            </select>
                        </div>
                    </div>
                    
                    <div class="col-md-4">
                        <div class="btn-group btn-group-sm" role="group">
                            <input type="radio" class="btn-check" name="sortOrder" id="sortAsc" value="asc" checked>
                            <label class="btn btn-outline-primary" for="sortAsc">
                                <i class="bi bi-sort-alpha-down"></i> A-Z
                            </label>
                            
                            <input type="radio" class="btn-check" name="sortOrder" id="sortDesc" value="desc">
                            <label class="btn btn-outline-primary" for="sortDesc">
                                <i class="bi bi-sort-alpha-up"></i> Z-A
                            </label>
                        </div>
                    </div>
                    
                    <div class="col-md-4">
                        <button type="button" id="applySort" class="btn btn-primary btn-sm w-100">
                            <i class="bi bi-check-circle me-1"></i> Appliquer le tri
                        </button>
                    </div>
                </div>
            </div>
        </div>

        {# FLASH MESSAGES (inchangé) #}
        {% for message in app.flashes('success') %}
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle me-2"></i>{{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}
        
        {% for message in app.flashes('error') %}
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle me-2"></i>{{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}

        {# RÉSULTATS DE RECHERCHE (inchangé) #}
        <div id="searchResultsInfo" class="alert alert-info d-none">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <i class="bi bi-funnel me-2"></i>
                    <span id="resultsText"></span>
                    <span class="ms-2 text-muted" id="sortText"></span>
                </div>
                <div>
                    <span id="resultsCount" class="badge bg-primary me-2"></span>
                    <button type="button" id="clearSort" class="btn btn-sm btn-outline-secondary d-none">
                        <i class="bi bi-arrow-clockwise"></i> Réinitialiser
                    </button>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-end mb-3">
            <a href="{{ path('quiz_pdf') }}" class="btn btn-danger me-2">
                <i class="bi bi-file-earmark-pdf-fill me-2"></i>
                Exporter en PDF
            </a>
            <button type="button" class="btn btn-info" id="globalAIHelp">
                <i class="bi bi-magic me-2"></i>
                Assistance IA globale
            </button>
        </div>

        {# QUESTIONS #}
        <div id="questionsContainer">
            {% for question in questions %}
                <div class="card border-0 shadow-sm mb-4 question-card" data-question-id="{{ question.id }}">
                    <div class="card-body">
                        <!-- HEADER avec boutons IA -->
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <h5 class="mb-1">{{ question.titre }}</h5>
                                <small class="text-muted">
                                    ⏱ {{ question.duree }} min · 🎯 {{ question.noteMax }} pts
                                    {% if question.user %} · 👤 {{ question.user.nom }}{% endif %}
                                </small>
                            </div>

                            <!-- ACTIONS QUESTION + IA -->
                            <div class="d-flex gap-2">
                                <!-- Bouton IA Générer choix -->
                                <button type="button" 
                                        class="btn btn-sm btn-outline-info generate-choices-btn" 
                                        data-question-id="{{ question.id }}"
                                        data-question-title="{{ question.titre }}"
                                        title="Générer des choix avec IA">
                                    <i class="bi bi-robot"></i> Générer choix
                                </button>
                                
                                <!-- Bouton IA Expliquer réponse -->
                                {% if question.choix|length > 0 %}
                                <button type="button" 
                                        class="btn btn-sm btn-outline-warning explain-answer-btn" 
                                        data-question-id="{{ question.id }}"
                                        title="Expliquer la bonne réponse">
                                    <i class="bi bi-question-circle"></i> Expliquer
                                </button>
                                {% endif %}
                                {% if question.choix|length > 0 %}


{# ← NOUVEAU BOUTON #}
<button type="button" 
        class="btn btn-sm btn-outline-purple analyze-difficulty-btn" 
        data-question-id="{{ question.id }}"
        title="Analyser le niveau de difficulté"
        style="border-color: #6f42c1; color: #6f42c1;">
    <i class="bi bi-speedometer2"></i> Niveau
</button>
{% endif %}

                                <!-- Boutons existants -->
                                <div class="btn-group btn-group-sm">
                                    <a href="{{ path('edit_question', {'id': question.id}) }}"
                                       class="btn btn-outline-success" title="Modifier">
                                        <i class="bi bi-pencil"></i>
                                    </a>

                                    <form method="post"
                                          action="{{ path('delete_question', {'id': question.id}) }}"
                                          onsubmit="return confirm('Supprimer cette question ?');"
                                          class="d-inline">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete_question_' ~ question.id) }}">
                                        <button class="btn btn-outline-danger" title="Supprimer">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>

                        <!-- DESCRIPTION -->
                        <p class="text-secondary mb-3">{{ question.description }}</p>

                        <!-- ZONE D'EXPLICATION IA (cachée initialement) -->
                        <div class="ai-explanation alert alert-info d-none mb-3" id="explanation-{{ question.id }}">
                            <i class="bi bi-info-circle me-2"></i>
                            <span class="explanation-text"></span>
                            <button type="button" class="btn-close float-end" aria-label="Close"></button>
                        </div>

                        <!-- CHOIX -->
                        <ul class="list-group list-group-flush mb-3">
                            {% for choix in question.choix %}
                                <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                    <div>
                                        {{ choix.contenu }}
                                        {% if choix.estCorrect %}
                                            <span class="badge bg-success ms-2">Correct</span>
                                        {% else %}
                                            <span class="badge bg-light text-muted ms-2">Incorrect</span>
                                        {% endif %}
                                    </div>

                                    <!-- ACTIONS CHOIX -->
                                    <div class="d-flex gap-2">
                                        <a href="{{ path('edit_choix', {'id': choix.id}) }}"
                                           class="text-success" title="Modifier">
                                            <i class="bi bi-pencil"></i>
                                        </a>

                                        <form method="post"
                                              action="{{ path('delete_choix', {'id': choix.id}) }}"
                                              onsubmit="return confirm('Supprimer ce choix ?');"
                                              class="d-inline">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete_choix_' ~ choix.id) }}">
                                            <button class="btn btn-link text-danger p-0" title="Supprimer">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </li>
                            {% else %}
                                <li class="list-group-item text-muted px-0">Aucun choix ajouté</li>
                            {% endfor %}
                        </ul>

                        <!-- AJOUT CHOIX MANUEL ET IA -->
                        <div class="d-flex gap-2">
                            <a href="{{ path('add_choix', {'questionId': question.id}) }}"
                               class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-plus-circle"></i> Ajouter manuellement
                            </a>
                            
                            <button type="button" 
                                    class="btn btn-sm btn-outline-info generate-choices-mini-btn" 
                                    data-question-id="{{ question.id }}">
                                <i class="bi bi-magic"></i> Générer avec IA
                            </button>
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="alert alert-info">
                    <i class="bi bi-info-circle me-2"></i>Aucune question disponible.
                </div>
            {% endfor %}
        </div>

        {# FORMULAIRE QUESTION (inchangé) #}
        <div class="card border-0 shadow-sm mt-5">
            <div class="card-header bg-white fw-bold">
                {% if editMode %}
                    ✏ Modifier la question
                {% else %}
                    ➕ Ajouter une question
                {% endif %}
            </div>

            <div class="card-body">
                {{ form_start(form, {'attr': {'id': 'question_form', 'novalidate': 'novalidate'}}) }}
                <input type="hidden" name="form_name" value="{{ form.vars.name }}">
                
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="mb-3">
                            {{ form_label(form.titre, "Titre *", {'label_attr': {'class': 'form-label fw-bold'}}) }}
                            {{ form_widget(form.titre, {'attr': {'class': 'form-control' ~ (form.titre.vars.errors|length > 0 ? ' is-invalid' : '')}}) }}
                            <div class="text-danger small mt-1">
                                {{ form_errors(form.titre) }}
                            </div>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="mb-3">
                            {{ form_label(form.duree, "Durée (minutes) *", {'label_attr': {'class': 'form-label fw-bold'}}) }}
                            {{ form_widget(form.duree, {'attr': {'class': 'form-control' ~ (form.duree.vars.errors|length > 0 ? ' is-invalid' : '')}}) }}
                            <div class="text-danger small mt-1">
                                {{ form_errors(form.duree) }}
                            </div>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="mb-3">
                            {{ form_label(form.noteMax, "Note maximale *", {'label_attr': {'class': 'form-label fw-bold'}}) }}
                            {{ form_widget(form.noteMax, {'attr': {'class': 'form-control' ~ (form.noteMax.vars.errors|length > 0 ? ' is-invalid' : '')}}) }}
                            <div class="text-danger small mt-1">
                                {{ form_errors(form.noteMax) }}
                            </div>
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="mb-3">
                            {{ form_label(form.description, "Description *", {'label_attr': {'class': 'form-label fw-bold'}}) }}
                            {{ form_widget(form.description, {'attr': {'class': 'form-control' ~ (form.description.vars.errors|length > 0 ? ' is-invalid' : ''), 'rows': 4}}) }}
                            <div class="text-danger small mt-1">
                                {{ form_errors(form.description) }}
                            </div>
                        </div>
                    </div>

                    <div class="col-12 d-flex gap-2">
                        <button type="submit"
                                class="btn {% if editMode %}btn-success{% else %}btn-primary{% endif %}">
                            <i class="bi {% if editMode %}bi-check-circle-fill{% else %}bi-plus-circle-fill{% endif %}"></i>
                            {% if editMode %} Mettre à jour {% else %} Ajouter {% endif %}
                        </button>

                        {% if editMode %}
                            <a href="{{ path('quiz_admin') }}" class="btn btn-secondary">
                                Annuler
                            </a>
                        {% endif %}
                    </div>
                </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>

<!-- Modal pour afficher les explications IA -->
<div class="modal fade" id="aiExplanationModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title">
                    <i class="bi bi-robot me-2"></i>
                    Explication IA
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="aiExplanationContent"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button>
            </div>
        </div>
    </div>
</div>
{% endblock %}
{% block javascripts %}
{{ parent() }}
<script>
document.addEventListener('DOMContentLoaded', function () {
    // ================= RECHERCHE ET TRI AJAX =================
    const searchInput = document.getElementById('searchInput');
    const searchType = document.getElementById('searchType');
    const searchBtn = document.getElementById('searchBtn');
    const clearSearch = document.getElementById('clearSearch');
    const sortBy = document.getElementById('sortBy');
    const sortAsc = document.getElementById('sortAsc');
    const sortDesc = document.getElementById('sortDesc');
    const applySort = document.getElementById('applySort');
    const clearSort = document.getElementById('clearSort');
    const questionsContainer = document.getElementById('questionsContainer');
    const searchResultsInfo = document.getElementById('searchResultsInfo');
    const resultsText = document.getElementById('resultsText');
    const sortText = document.getElementById('sortText');
    const resultsCount = document.getElementById('resultsCount');
    
    let searchTimeout;
    
    // ================= FONCTIONS DE RECHERCHE =================
    function performSearch() {
        const searchTerm = searchInput.value.trim();
        const type = searchType.value;
        const sortOrder = document.querySelector('input[name="sortOrder"]:checked').value;
        const sortByValue = sortBy.value;
        
        questionsContainer.innerHTML = `
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Chargement...</span>
                </div>
                <p class="mt-3 text-muted">Chargement des questions...</p>
            </div>
        `;
        
        fetch(`/admin/quiz/search?search=${encodeURIComponent(searchTerm)}&type=${type}&sort=${sortOrder}&sortBy=${sortByValue}`, {
            method: 'GET',
            headers: {
                'X-Requested-With': 'XMLHttpRequest'
            }
        })
        .then(response => response.json())
        .then(data => {
            questionsContainer.innerHTML = data.html;
            
            if (searchTerm !== '' || sortByValue !== 'titre' || sortOrder !== 'asc') {
                searchResultsInfo.classList.remove('d-none');
                clearSort.classList.remove('d-none');
                
                if (searchTerm !== '') {
                    resultsText.textContent = `Résultats pour "${searchTerm}"`;
                } else {
                    resultsText.textContent = `Toutes les questions`;
                }
                
                resultsCount.textContent = `${data.count} question${data.count !== 1 ? 's' : ''}`;
            } else {
                searchResultsInfo.classList.add('d-none');
                clearSort.classList.add('d-none');
            }
            
            initializeAIButtons();
        })
        .catch(error => {
            console.error('Erreur recherche:', error);
        });
    }
    
    // ================= FONCTIONS IA CORRIGÉES =================
    
    /**
     * Initialise tous les boutons IA
     */
    function initializeAIButtons() {
        // Boutons de génération de choix
        document.querySelectorAll('.generate-choices-btn, .generate-choices-mini-btn').forEach(btn => {
            // Supprimer les anciens listeners pour éviter les doublons
            btn.removeEventListener('click', handleGenerateClick);
            btn.addEventListener('click', handleGenerateClick);
        });
        
        // Boutons d'explication
        document.querySelectorAll('.explain-answer-btn').forEach(btn => {
            btn.removeEventListener('click', handleExplainClick);
            btn.addEventListener('click', handleExplainClick);
        });
        
        // Boutons de fermeture
        document.querySelectorAll('.ai-explanation .btn-close').forEach(btn => {
            btn.addEventListener('click', function() {
                this.closest('.ai-explanation').classList.add('d-none');
            });
        });
        
        // Bouton d'assistance globale
        const globalAIHelp = document.getElementById('globalAIHelp');
        if (globalAIHelp) {
            globalAIHelp.addEventListener('click', showGlobalAIAssistance);
        }
    }
    
    /**
     * Handler pour la génération de choix
     */
    function handleGenerateClick(e) {
        e.preventDefault();
        const btn = e.currentTarget;
        const questionId = btn.dataset.questionId;
        const questionTitle = btn.dataset.questionTitle || 'Question';
        generateChoicesWithAI(questionId, questionTitle, btn);
    }
    
    /**
     * Handler pour l'explication
     */
    function handleExplainClick(e) {
        e.preventDefault();
        const btn = e.currentTarget;
        const questionId = btn.dataset.questionId;
        explainAnswerWithAI(questionId);
    }
    
    /**
     * Génère des choix avec IA (VERSION CORRIGÉE)
     */
    function generateChoicesWithAI(questionId, questionTitle, btn) {
        if (!confirm(`Générer des choix avec IA pour la question "${questionTitle}" ?`)) {
            return;
        }
        
        const originalText = btn.innerHTML;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status"></span> Génération...';
        btn.disabled = true;
        
       // Au lieu de fetch(`/admin/ai/generate-choices/${questionId}`)
// Utilisez :
fetch(`/admin/ai-quiz/generate-choices/${questionId}`, {
    method: 'POST',
    headers: {
        'X-Requested-With': 'XMLHttpRequest',
        'Accept': 'application/json'
    }
})
        .then(async response => {
            const text = await response.text();
            try {
                const data = JSON.parse(text);
                if (!response.ok) {
                    throw new Error(data.message || `Erreur ${response.status}`);
                }
                return data;
            } catch (e) {
                console.error('Réponse non-JSON:', text.substring(0, 200));
                throw new Error('Le serveur a renvoyé une réponse invalide');
            }
        })
        .then(data => {
            if (data.success) {
                showNotification('success', data.message || 'Génération réussie !');
                if (data.explanation) {
                    showExplanation(questionId, data.explanation);
                }
                setTimeout(() => location.reload(), 1500);
            } else {
                showNotification('error', data.message || 'Erreur lors de la génération');
            }
        })
        .catch(error => {
            console.error('Erreur détaillée:', error);
            showNotification('error', error.message || 'Erreur de communication avec le serveur');
        })
        .finally(() => {
            btn.innerHTML = originalText;
            btn.disabled = false;
        });
    }
    
    /**
     * Explique la bonne réponse avec IA
     */
    function explainAnswerWithAI(questionId) {
        const explanationDiv = document.getElementById(`explanation-${questionId}`);
        if (!explanationDiv) return;
        
        const explanationText = explanationDiv.querySelector('.explanation-text');
        
        explanationDiv.classList.remove('d-none');
        explanationText.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Génération...';
        
      fetch(`/admin/ai-quiz/explain-answer/${questionId}`, {
    method: 'GET',
    headers: {
        'X-Requested-With': 'XMLHttpRequest',
        'Accept': 'application/json'
    }
})
        .then(async response => {
            const text = await response.text();
            try {
                return JSON.parse(text);
            } catch (e) {
                console.error('Réponse non-JSON:', text.substring(0, 200));
                throw new Error('Réponse serveur invalide');
            }
        })
        .then(data => {
            if (data.success) {
                explanationText.innerHTML = data.explanation;
            } else {
                explanationText.innerHTML = '⚠️ ' + (data.message || 'Erreur');
            }
        })
        .catch(error => {
            console.error('Erreur explication:', error);
            explanationText.innerHTML = '⚠️ Erreur de communication';
        });
    }
    
    /**
     * Affiche une notification
     */
    function showNotification(type, message) {
        const alertDiv = document.createElement('div');
        alertDiv.className = `alert alert-${type === 'success' ? 'success' : 'danger'} alert-dismissible fade show position-fixed top-0 end-0 m-3`;
        alertDiv.style.zIndex = '9999';
        alertDiv.style.maxWidth = '400px';
        alertDiv.innerHTML = `
            <div class="d-flex align-items-center">
                <i class="bi bi-${type === 'success' ? 'check-circle-fill' : 'exclamation-triangle-fill'} me-2"></i>
                <div class="flex-grow-1">${message}</div>
                <button type="button" class="btn-close ms-2" data-bs-dismiss="alert"></button>
            </div>
        `;
        document.body.appendChild(alertDiv);
        
        setTimeout(() => {
            if (alertDiv.parentNode) {
                alertDiv.remove();
            }
        }, 5000);
    }
    
    /**
     * Affiche une explication dans le modal
     */
    function showExplanation(questionId, explanation) {
        const modalElement = document.getElementById('aiExplanationModal');
        if (!modalElement) return;
        
        const content = document.getElementById('aiExplanationContent');
        content.innerHTML = `<div class="p-2">${explanation.replace(/\n/g, '<br>')}</div>`;
        
        const modal = new bootstrap.Modal(modalElement);
        modal.show();
    }
    
    /**
     * Affiche l'assistance IA
     */
    function showGlobalAIAssistance() {
        const modalElement = document.getElementById('aiExplanationModal');
        if (!modalElement) return;
        
        const content = document.getElementById('aiExplanationContent');
        content.innerHTML = `
            <div class="p-3">
                <h5 class="text-info mb-3">
                    <i class="bi bi-robot me-2"></i>Assistant IA - Guide
                </h5>
                <hr>
                <p><strong>Fonctionnalités :</strong></p>
                <ul class="list-unstyled">
                    <li class="mb-2"><span class="badge bg-info me-2">Générer</span> Crée automatiquement des choix pertinents</li>
                    <li class="mb-2"><span class="badge bg-warning me-2">Expliquer</span> Obtient une explication pédagogique</li>
                </ul>
                <div class="alert alert-info mt-3">
                    <i class="bi bi-lightbulb me-2"></i>
                    L'IA vous assiste, mais validez toujours le contenu !
                </div>
            </div>
        `;
        
        const modal = new bootstrap.Modal(modalElement);
        modal.show();
    }
    
    // ================= EVENT LISTENERS RECHERCHE =================
    searchBtn.addEventListener('click', function() {
        clearTimeout(searchTimeout);
        performSearch();
    });
    
    searchInput.addEventListener('input', function() {
        clearTimeout(searchTimeout);
        searchTimeout = setTimeout(performSearch, 800);
    });
    
    clearSearch.addEventListener('click', function() {
        searchInput.value = '';
        searchType.value = 'titre';
        sortBy.value = 'titre';
        sortAsc.checked = true;
        location.reload();
    });
    
    applySort.addEventListener('click', function() {
        clearTimeout(searchTimeout);
        performSearch();
    });
    
    clearSort.addEventListener('click', function() {
        sortBy.value = 'titre';
        sortAsc.checked = true;
        clearTimeout(searchTimeout);
        performSearch();
    });
    document.querySelectorAll('.analyze-difficulty-btn').forEach(btn => {
    btn.removeEventListener('click', handleDifficultyClick);
    btn.addEventListener('click', handleDifficultyClick);
});
function handleDifficultyClick(e) {
    e.preventDefault();
    const btn = e.currentTarget;
    const questionId = btn.dataset.questionId;
    analyzeDifficultyWithAI(questionId, btn);
}

function analyzeDifficultyWithAI(questionId, btn) {
    const originalText = btn.innerHTML;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';
    btn.disabled = true;

    fetch(`/admin/ai-quiz/analyze-difficulty/${questionId}`, {
        method: 'GET',
        headers: {
            'X-Requested-With': 'XMLHttpRequest',
            'Accept': 'application/json'
        }
    })
    .then(r => r.json())
    .then(data => {
        if (data.success) {
            showDifficultyModal(data.data);
        } else {
            showNotification('error', data.message || 'Erreur analyse');
        }
    })
    .catch(error => {
        showNotification('error', 'Erreur de communication');
    })
    .finally(() => {
        btn.innerHTML = originalText;
        btn.disabled = false;
    });
}

function showDifficultyModal(data) {
    const niveauColors = {
        'Facile': 'success',
        'Moyen': 'warning',
        'Difficile': 'danger',
        'Expert': 'dark'
    };
    const etudiantIcons = {
        'Débutant': 'bi-star',
        'Intermédiaire': 'bi-star-half',
        'Avancé': 'bi-star-fill',
        'Expert': 'bi-trophy-fill'
    };

    const color = niveauColors[data.niveau] || 'secondary';
    const icon = etudiantIcons[data.niveau_etudiant] || 'bi-person';
    const score = data.score_difficulte || 5;
    const competences = (data.competences_requises || []).map(c => `<span class="badge bg-light text-dark me-1">${c}</span>`).join('');

    const content = document.getElementById('aiExplanationContent');
    content.innerHTML = `
        <div class="p-2">
            <div class="row g-3 mb-3">
                <div class="col-6">
                    <div class="card border-0 bg-light text-center p-3">
                        <div class="fs-1 mb-1">🎯</div>
                        <div class="fw-bold text-muted small">Niveau de difficulté</div>
                        <span class="badge bg-${color} fs-6 mt-1">${data.niveau}</span>
                    </div>
                </div>
                <div class="col-6">
                    <div class="card border-0 bg-light text-center p-3">
                        <div class="fs-1 mb-1"><i class="bi ${icon}"></i></div>
                        <div class="fw-bold text-muted small">Profil étudiant cible</div>
                        <span class="badge bg-info text-dark fs-6 mt-1">${data.niveau_etudiant}</span>
                    </div>
                </div>
            </div>

            <div class="mb-3">
                <div class="d-flex justify-content-between mb-1">
                    <small class="fw-bold">Score de difficulté</small>
                    <small class="text-muted">${score}/10</small>
                </div>
                <div class="progress" style="height: 10px;">
                    <div class="progress-bar bg-${color}" style="width: ${score * 10}%" role="progressbar"></div>
                </div>
            </div>

            <div class="alert alert-light border mb-3">
                <i class="bi bi-lightbulb me-2 text-warning"></i>
                <strong>Analyse :</strong> ${data.justification}
            </div>

            ${competences ? `
            <div class="mb-3">
                <strong class="small">Compétences requises :</strong><br>
                <div class="mt-1">${competences}</div>
            </div>` : ''}

            <div class="alert alert-info mb-0">
                <i class="bi bi-person-check me-2"></i>
                <strong>Conseil étudiant :</strong> ${data.conseils_etudiant}
            </div>
        </div>
    `;

    const modalEl = document.getElementById('aiExplanationModal');
    modalEl.querySelector('.modal-title').innerHTML = '<i class="bi bi-speedometer2 me-2"></i>Analyse du niveau de difficulté';
    new bootstrap.Modal(modalEl).show();
}
    
    // Initialisation
    initializeAIButtons();
});
</script>
{% endblock %}