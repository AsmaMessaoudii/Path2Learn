{% extends 'base.html.twig' %}

{% block title %}Tous les QR codes - Path2Learn{% endblock %}

{% block body %}
<div class="container py-5">
    <!-- En-tête -->
    <div class="text-center mb-5">
        <div class="bg-primary bg-opacity-10 rounded-circle d-inline-flex p-4 mb-3">
            <i class="fas fa-qrcode fa-3x text-primary"></i>
        </div>
        <h1 class="display-5 fw-bold">QR Codes des cours</h1>
        <p class="lead text-muted">Scannez pour accéder instantanément aux cours</p>
        <div class="mt-3">
            <button class="btn btn-outline-primary rounded-pill me-2" onclick="window.print()">
                <i class="fas fa-print me-2"></i>Imprimer tout
            </button>
            <a href="{{ path('app_courses') }}" class="btn btn-outline-secondary rounded-pill">
                <i class="fas fa-arrow-left me-2"></i>Retour aux cours
            </a>
        </div>
    </div>
    
    <!-- Grille des QR codes -->
    <div class="row g-4">
        {% for courseData in coursesWithData %}
            {% set course = courseData.course %}
            <div class="col-md-4 col-lg-3">
                <div class="card h-100 border-0 shadow-sm hover-lift">
                    <div class="card-body text-center p-4">
                        <!-- QR code avec QR Server -->
                        <div class="mb-3 p-3 bg-light rounded-3">
                            {% set courseUrl = absolute_url(path('course_show', {'id': course.id})) %}
                           <img src="https://api.qrserver.com/v1/create-qr-code/?size=250x250&data={{ absolute_url(path('course_show', {'id': course.id}))|url_encode }}" 
     alt="QR Code" 
     class="img-fluid">
                        </div>
                        
                        <!-- Informations -->
                        <h6 class="fw-bold text-truncate" title="{{ course.titre }}">
                            {{ course.titre }}
                        </h6>
                        <div class="d-flex justify-content-center gap-2 mb-3">
                            <span class="badge bg-primary-soft text-primary px-2 py-1 rounded-pill">
                                <i class="fas fa-tag me-1"></i>{{ course.matiere|default('Général') }}
                            </span>
                            <span class="badge bg-info-soft text-info px-2 py-1 rounded-pill">
                                <i class="fas fa-signal me-1"></i>{{ course.niveau|default('Débutant') }}
                            </span>
                        </div>
                        
                        <!-- Statistiques -->
                        <div class="d-flex justify-content-center gap-3 small text-muted mb-3">
                            <span><i class="fas fa-heart text-danger me-1"></i>{{ courseData.likes }}</span>
                            <span><i class="fas fa-star text-warning me-1"></i>{{ courseData.averageRating|number_format(1) }}</span>
                        </div>
                        
                        <!-- Boutons d'action -->
                        <div class="d-flex gap-2 justify-content-center">
                            <a href="https://api.qrserver.com/v1/create-qr-code/?size=400x400&data={{ courseUrl|url_encode }}" 
                               class="btn btn-sm btn-primary rounded-pill"
                               target="_blank"
                               data-bs-toggle="tooltip"
                               title="Télécharger QR code">
                                <i class="fas fa-download"></i>
                            </a>
                            <a href="{{ path('course_show', {'id': course.id}) }}" 
                               class="btn btn-sm btn-outline-primary rounded-pill"
                               data-bs-toggle="tooltip"
                               title="Voir le cours">
                                <i class="fas fa-external-link-alt"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
</div>

<!-- Style supplémentaire -->
<style>
.hover-lift {
    transition: transform 0.2s ease, box-shadow 0.2s ease;
}
.hover-lift:hover {
    transform: translateY(-5px);
    box-shadow: 0 15px 30px rgba(0,0,0,0.1) !important;
}
@media print {
    .btn, .badge, .modal-footer, .btn-close {
        display: none !important;
    }
    .card {
        break-inside: avoid;
        page-break-inside: avoid;
        box-shadow: none !important;
        border: 1px solid #ddd !important;
    }
}
/* Styles pour les QR codes */
.btn-qr-mini {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 35px;
    height: 35px;
    background: rgba(0, 0, 0, 0.3);
    border-radius: 50%;
    transition: all 0.2s ease;
    text-decoration: none;
    backdrop-filter: blur(2px);
}

.btn-qr-mini:hover {
    transform: scale(1.1);
    background: rgba(0, 0, 0, 0.5);
}

/* Modal QR code */
.modal-content {
    border-radius: 20px;
    overflow: hidden;
}

.modal-header.bg-primary {
    background: linear-gradient(135deg, #4361ee, #6c5ce7) !important;
}

/* Animation du modal */
.modal.fade .modal-dialog {
    transform: scale(0.9);
    transition: transform 0.3s ease;
}

.modal.show .modal-dialog {
    transform: scale(1);
}

/* Impression */
@media print {
    .modal-footer,
    .btn-close,
    .btn,
    .alert {
        display: none !important;
    }
    
    .modal-content {
        box-shadow: none !important;
        border: 1px solid #ddd !important;
    }
    
    .modal-body {
        text-align: center !important;
    }
}
</style>
{% endblock %}