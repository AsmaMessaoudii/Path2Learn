{# templates/resume/cours.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Résumé - {{ cours.titre }}{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    .question-interactive {
        background: white;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        margin-bottom: 10px;
        overflow: hidden;
    }
    .question-interactive .question {
        padding: 15px;
        background: #f8f9fa;
        cursor: pointer;
        font-weight: 600;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    .question-interactive .question:hover {
        background: #e9ecef;
    }
    .question-interactive .question i {
        transition: transform 0.3s;
    }
    .question-interactive .question.active i {
        transform: rotate(180deg);
    }
    .question-interactive .reponse {
        padding: 0 15px;
        max-height: 0;
        overflow: hidden;
        transition: max-height 0.3s ease-out, padding 0.3s ease-out;
        background: white;
    }
    .question-interactive .reponse.show {
        padding: 15px;
        max-height: 500px;
        border-top: 1px solid #dee2e6;
    }
    .ressource-lien {
        display: inline-block;
        margin-top: 10px;
        padding: 5px 10px;
        background: #007bff;
        color: white;
        text-decoration: none;
        border-radius: 5px;
    }
    .ressource-lien:hover {
        background: #0056b3;
        color: white;
    }
</style>
{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="row">
        <div class="col-md-10 mx-auto">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1>
                    <i class="bi bi-file-text"></i> 
                    Résumé du cours : {{ cours.titre }}
                </h1>
                <div>
                    <a href="{{ path('app_resume_fiche', {'id': cours.id}) }}" class="btn btn-primary">
                        <i class="bi bi-eye"></i> Fiche complète
                    </a>
                    <a href="{{ path('app_resume_download', {'id': cours.id}) }}" class="btn btn-success">
                        <i class="bi bi-download"></i> Télécharger
                    </a>
                </div>
                <a href="{{ path('app_resume_ressources_cours', {'id': cours.id}) }}" 
   class="btn btn-info">
    <i class="bi bi-files"></i> Analyser les ressources
</a>
            </div>
            
            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <h5 class="card-title">📊 Statistiques</h5>
                    <div class="row text-center">
                        <div class="col-3">
                            <div class="h3">{{ resume.statistiques.totalRessources }}</div>
                            <small>Ressources</small>
                        </div>
                        <div class="col-3">
                            <div class="h3">{{ resume.statistiques.dureeTotale }}min</div>
                            <small>Durée</small>
                        </div>
                        <div class="col-3">
                            <div class="h3">{{ resume.motsCles|length }}</div>
                            <small>Mots-clés</small>
                        </div>
                        <div class="col-3">
                            <div class="h3">{{ resume.questionsRevision|length }}</div>
                            <small>Questions</small>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <h5 class="card-title">📝 Résumé</h5>
                    <p class="lead">{{ resume.court }}</p>
                    
                    <h5 class="card-title mt-4">🔑 Mots-clés</h5>
                    <div class="d-flex flex-wrap gap-2">
                        {% for mot in resume.motsCles %}
                            <span class="badge bg-info p-2">{{ mot }}</span>
                        {% endfor %}
                    </div>
                </div>
            </div>
            
            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <h5 class="card-title">📎 Ressources disponibles</h5>
                    <div class="list-group">
                        {% for ressource in resume.ressourcesAvecLiens %}
                            <div class="list-group-item">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <i class="bi {{ ressource.icone }} me-2"></i>
                                        <strong>{{ ressource.titre }}</strong>
                                        <span class="badge bg-secondary ms-2">{{ ressource.type }}</span>
                                        <small class="text-muted d-block">{{ ressource.description }}</small>
                                    </div>
                                    <div>
                                        {% if ressource.lien and ressource.lien != '#' %}
                                            <a href="{{ ressource.lien }}" target="_blank" class="btn btn-sm btn-outline-primary">
                                                {% if ressource.typeLien == 'fichier' %}
                                                    <i class="bi bi-download"></i> Télécharger
                                                {% else %}
                                                    <i class="bi bi-box-arrow-up-right"></i> Voir
                                                {% endif %}
                                            </a>
                                        {% else %}
                                            <span class="text-muted">Non disponible</span>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            </div>
            
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">❓ Questions de révision</h5>
                    <p class="text-muted small">Cliquez sur une question pour voir la réponse</p>
                    
                    {% for qr in resume.questionsReponses %}
                        <div class="question-interactive">
                            <div class="question" onclick="toggleQuestion(this)">
                                {{ qr.question }}
                                <span class="badge bg-secondary">{{ qr.categorie }}</span>
                                <i class="bi bi-chevron-down"></i>
                            </div>
                            <div class="reponse">
                                {{ qr.reponse|nl2br }}
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
</div>

<script>
function toggleQuestion(element) {
    // Toggle active class on question
    element.classList.toggle('active');
    
    // Get the response div (next sibling)
    const reponse = element.nextElementSibling;
    
    // Toggle show class
    reponse.classList.toggle('show');
    
    // Toggle icon
    const icon = element.querySelector('i');
    if (reponse.classList.contains('show')) {
        icon.classList.remove('bi-chevron-down');
        icon.classList.add('bi-chevron-up');
    } else {
        icon.classList.remove('bi-chevron-up');
        icon.classList.add('bi-chevron-down');
    }
}
</script>
{% endblock %}