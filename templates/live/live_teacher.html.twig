{% extends 'base.html.twig' %}

{% block title %}Live Enseignant - {{ course.titre }}{% endblock %}

{% block body %}
<div class="live-wrapper">

    {# ── SIDEBAR CHAT ── #}
    <aside class="live-sidebar">
        <div class="sidebar-header">
            <span class="sidebar-title">💬 Chat en direct</span>
            <span class="viewer-count" id="viewer-count">0 spectateurs</span>
        </div>
        <div class="chat-messages" id="chat-messages">
            <div class="chat-placeholder">
                <span>🎤</span>
                <p>Les messages des étudiants apparaîtront ici une fois le live démarré.</p>
            </div>
        </div>
        <div class="chat-footer">
            <p class="text-muted small text-center mb-0">Mode lecture seule pour l'enseignant</p>
        </div>
    </aside>

    {# ── MAIN AREA ── #}
    <main class="live-main">

        {# Top bar #}
        <div class="live-topbar">
            <div class="course-info">
                <span class="course-title">{{ course.titre }}</span>
                <span class="badge-live" id="live-badge">🔴 EN DIRECT</span>
            </div>
            <div class="topbar-actions">
                <span class="time-elapsed" id="time-elapsed" style="display:none">⏱ 00:00</span>
            </div>
        </div>

        {# Video #}
        <div class="video-area" id="video-area">
            <div id="jitsi-container"></div>

            {# Pre-live overlay #}
            <div class="prelive-overlay" id="prelive-overlay">
                <div class="prelive-card">
                    <div class="prelive-icon">🎬</div>
                    <h3>Prêt à démarrer ?</h3>
                    <p>Votre caméra et votre micro seront activés. Un email sera envoyé à tous les étudiants.</p>
                    <button id="start-live-btn" class="btn-start">
                        <span id="start-btn-text">▶ Démarrer le Live</span>
                        <span id="start-btn-spinner" style="display:none">⏳ Démarrage...</span>
                    </button>
                </div>
            </div>

            {# Reaction layer #}
            <div class="reaction-layer" id="reaction-layer"></div>
        </div>

        {# Bottom controls #}
        <div class="live-controls" id="live-controls" style="display:none">
            <div class="controls-left">
                <span class="live-dot">🔴 LIVE</span>
            </div>
            <div class="controls-right">
                <button id="end-live-btn" class="btn-end">
                    ⏹ Terminer le Live
                </button>
            </div>
        </div>

    </main>
</div>

{# Notification toast #}
<div class="toast-container" id="toast-container"></div>

<style>
/* ── Layout ── */
* { box-sizing: border-box; }

.live-wrapper {
    display: flex;
    height: calc(100vh - 70px);
    background: #0a0f1e;
    margin: -20px;
    font-family: 'Segoe UI', sans-serif;
    overflow: hidden;
}

/* ── Sidebar ── */
.live-sidebar {
    width: 320px;
    background: #111827;
    border-right: 1px solid #1f2937;
    display: flex;
    flex-direction: column;
    flex-shrink: 0;
}

.sidebar-header {
    padding: 16px 20px;
    border-bottom: 1px solid #1f2937;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.sidebar-title {
    color: #f1f5f9;
    font-weight: 600;
    font-size: 0.95rem;
}

.viewer-count {
    color: #64748b;
    font-size: 0.78rem;
    background: #1e293b;
    padding: 3px 10px;
    border-radius: 20px;
}

.chat-messages {
    flex: 1;
    padding: 16px;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.chat-placeholder {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: #475569;
    text-align: center;
    gap: 10px;
}

.chat-placeholder span { font-size: 2rem; }
.chat-placeholder p { font-size: 0.85rem; line-height: 1.5; }

.message-bubble {
    background: #1e293b;
    border-radius: 12px;
    padding: 10px 14px;
    color: #e2e8f0;
    font-size: 0.875rem;
    max-width: 100%;
}

.message-bubble .user-name {
    display: block;
    font-size: 0.75rem;
    color: #60a5fa;
    font-weight: 600;
    margin-bottom: 4px;
}

.chat-footer {
    padding: 12px 16px;
    border-top: 1px solid #1f2937;
    color: #475569;
}

/* ── Main ── */
.live-main {
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow: hidden;
}

/* Top bar */
.live-topbar {
    background: #111827;
    padding: 14px 24px;
    border-bottom: 1px solid #1f2937;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
}

.course-info {
    display: flex;
    align-items: center;
    gap: 14px;
}

.course-title {
    color: #f1f5f9;
    font-size: 1rem;
    font-weight: 600;
}

.badge-live {
    background: #ef4444;
    color: white;
    font-size: 0.72rem;
    font-weight: 700;
    padding: 3px 10px;
    border-radius: 20px;
    letter-spacing: 0.5px;
    display: none;
    animation: pulse 2s infinite;
}

@keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.55; }
}

.time-elapsed {
    color: #94a3b8;
    font-size: 0.85rem;
    font-variant-numeric: tabular-nums;
}

/* Video area */
.video-area {
    flex: 1;
    position: relative;
    background: #000;
    overflow: hidden;
}

#jitsi-container {
    width: 100%;
    height: 100%;
}

/* Pre-live overlay */
.prelive-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10;
}

.prelive-card {
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.08);
    backdrop-filter: blur(10px);
    border-radius: 20px;
    padding: 48px 56px;
    text-align: center;
    max-width: 420px;
}

.prelive-icon {
    font-size: 3.5rem;
    margin-bottom: 16px;
}

.prelive-card h3 {
    color: #f1f5f9;
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 12px;
}

.prelive-card p {
    color: #94a3b8;
    font-size: 0.9rem;
    line-height: 1.6;
    margin-bottom: 28px;
}

.btn-start {
    background: linear-gradient(135deg, #ef4444, #dc2626);
    color: white;
    border: none;
    padding: 14px 36px;
    border-radius: 50px;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
    box-shadow: 0 4px 20px rgba(239,68,68,0.4);
}

.btn-start:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 28px rgba(239,68,68,0.5);
}

.btn-start:disabled {
    opacity: 0.6;
    cursor: not-allowed;
    transform: none;
}

/* Bottom controls */
.live-controls {
    background: #111827;
    border-top: 1px solid #1f2937;
    padding: 14px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
}

.live-dot {
    color: #ef4444;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 1px;
    animation: pulse 2s infinite;
}

.btn-end {
    background: transparent;
    color: #ef4444;
    border: 1.5px solid #ef4444;
    padding: 8px 22px;
    border-radius: 8px;
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
}

.btn-end:hover {
    background: #ef4444;
    color: white;
}

/* Reactions */
.reaction-layer {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
}

.floating-emoji {
    position: absolute;
    bottom: -50px;
    font-size: 2rem;
    animation: floatUp 3s ease-out forwards;
}

@keyframes floatUp {
    0%   { transform: translateY(0) scale(1); opacity: 1; }
    100% { transform: translateY(-400px) scale(1.5); opacity: 0; }
}

/* Toast */
.toast-container {
    position: fixed;
    bottom: 30px;
    right: 30px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    z-index: 9999;
}

.toast {
    padding: 14px 20px;
    border-radius: 10px;
    color: white;
    font-size: 0.875rem;
    font-weight: 500;
    box-shadow: 0 4px 20px rgba(0,0,0,0.3);
    animation: slideIn 0.3s ease;
    max-width: 340px;
}

.toast.success { background: #16a34a; }
.toast.error   { background: #dc2626; }
.toast.info    { background: #2563eb; }

@keyframes slideIn {
    from { transform: translateX(100px); opacity: 0; }
    to   { transform: translateX(0);     opacity: 1; }
}
</style>

<script src="https://meet.jit.si/external_api.js"></script>
<script>
    const courseId = {{ course.id }};
    const startBtn        = document.getElementById('start-live-btn');
    const startBtnText    = document.getElementById('start-btn-text');
    const startBtnSpinner = document.getElementById('start-btn-spinner');
    const endBtn          = document.getElementById('end-live-btn');
    const liveBadge       = document.getElementById('live-badge');
    const preliveOverlay  = document.getElementById('prelive-overlay');
    const liveControls    = document.getElementById('live-controls');
    const reactionLayer   = document.getElementById('reaction-layer');
    const timeElapsed     = document.getElementById('time-elapsed');
    const toastContainer  = document.getElementById('toast-container');

    let api = null;
    let timerInterval = null;
    let secondsElapsed = 0;

    // ── Toast helper ──
    function showToast(message, type = 'info', duration = 5000) {
        const toast = document.createElement('div');
        toast.className = `toast ${type}`;
        toast.textContent = message;
        toastContainer.appendChild(toast);
        setTimeout(() => toast.remove(), duration);
    }

    // ── Timer ──
    function startTimer() {
        secondsElapsed = 0;
        timeElapsed.style.display = 'inline';
        timerInterval = setInterval(() => {
            secondsElapsed++;
            const m = String(Math.floor(secondsElapsed / 60)).padStart(2, '0');
            const s = String(secondsElapsed % 60).padStart(2, '0');
            timeElapsed.textContent = `⏱ ${m}:${s}`;
        }, 1000);
    }

    // ── Start Live ──
    startBtn.addEventListener('click', async () => {
        // Disable button & show spinner
        startBtn.disabled = true;
        startBtnText.style.display = 'none';
        startBtnSpinner.style.display = 'inline';

        // Launch Jitsi
        const domain = "meet.jit.si";
        const roomName = "Path2Learn_Live_" + courseId + "_{{ course.user ? course.user.id : '0' }}";

        api = new JitsiMeetExternalAPI(domain, {
            roomName,
            width: '100%',
            height: '100%',
            parentNode: document.querySelector('#jitsi-container'),
            configOverwrite: {
                startWithAudioMuted: false,
                startWithVideoMuted: false,
                disableThirdPartyRequests: true
            },
            interfaceConfigOverwrite: {
                TOOLBAR_BUTTONS: ['microphone', 'camera', 'desktop', 'hangup', 'chat']
            }
        });

        // Send notification emails
        try {
            const response = await fetch("{{ path('app_live_start', {'courseId': course.id}) }}", {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: JSON.stringify({ roomName })
            });

            const result = await response.json();

            if (!response.ok) {
                if (result.errors && result.errors.length > 0) {
                    showToast('⚠️ Certains emails n\'ont pas pu être envoyés.', 'error', 7000);
                    console.warn('Email errors:', result.errors);
                } else {
                    showToast('Erreur serveur (' + response.status + ')', 'error');
                }
            } else {
                showToast('✅ Live démarré ! Les étudiants ont été notifiés par email.', 'success', 6000);
            }
        } catch (err) {
            console.error('Fetch error:', err);
            showToast('⚠️ Live démarré mais impossible de notifier les étudiants. Vérifiez votre connexion.', 'error', 8000);
        }

        // Show live UI
        preliveOverlay.style.display = 'none';
        liveControls.style.display = 'flex';
        liveBadge.style.display = 'inline-block';
        startTimer();
    });

    // ── End Live ──
    endBtn.addEventListener('click', async () => {
        if (!confirm('Voulez-vous vraiment terminer le live ?')) return;

        if (api) api.dispose();
        clearInterval(timerInterval);

        try {
            await fetch(`/live/end/${courseId}`, {
                method: 'POST',
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            });
        } catch (e) { /* ignore */ }

        showToast('Live terminé.', 'info', 3000);
        setTimeout(() => location.reload(), 1500);
    });

    // ── Reactions (demo) ──
    function showReaction(emoji) {
        const el = document.createElement('div');
        el.className = 'floating-emoji';
        el.innerText = emoji;
        el.style.left = (Math.random() * 80 + 10) + '%';
        reactionLayer.appendChild(el);
        setTimeout(() => el.remove(), 3000);
    }
</script>
{% endblock %}
