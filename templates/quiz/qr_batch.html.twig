{% extends 'base.html.twig' %}

{% block title %}Tous les QR Codes{% endblock %}

{% block body %}
<main class="pt-5 pb-5" style="min-height: calc(100vh - 200px); background: url('{{ asset('assets/images/pattern/04.png') }}') no-repeat center center; background-size: cover;">
    <div class="container">
        <!-- En-tête -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="display-6">
                <i class="bi bi-qr-code me-3 text-primary"></i>
                QR Codes des questions
            </h1>
            
            <div>
                <button onclick="window.print()" class="btn btn-outline-primary me-2">
                    <i class="bi bi-printer me-2"></i>
                    Imprimer
                </button>
                <a href="{{ path('quiz') }}" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-2"></i>
                    Retour
                </a>
            </div>
        </div>
        
        <!-- Grille des QR codes -->
        <div class="row g-4" id="qr-grid">
            {% for question in questions %}
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body text-center p-4">
                        <!-- QR Code miniature -->
                        <a href="{{ path('quiz_qr_view', {'id': question.id}) }}" 
                           class="d-block mb-3">
                            <img src="{{ path('quiz_qr_code', {'id': question.id}) }}" 
                                 alt="QR Question {{ question.id }}"
                                 class="img-fluid rounded-3 border"
                                 style="max-width: 150px;">
                        </a>
                        
                        <!-- Info question -->
                        <h6 class="fw-bold mb-1">{{ question.titre|length > 30 ? question.titre|slice(0, 30) ~ '...' : question.titre }}</h6>
                        <p class="small text-muted mb-3">
                            <i class="bi bi-star-fill text-warning me-1"></i>
                            {{ question.noteMax }} pts
                        </p>
                        
                        <!-- Actions -->
                        <div class="btn-group w-100" role="group">
                            <a href="{{ path('quiz_qr_view', {'id': question.id}) }}" 
                               class="btn btn-sm btn-primary"
                               title="Voir le QR code">
                                <i class="bi bi-eye"></i>
                            </a>
                            <a href="{{ path('quiz_qr_download', {'id': question.id}) }}" 
                               class="btn btn-sm btn-outline-primary"
                               title="Télécharger">
                                <i class="bi bi-download"></i>
                            </a>
                            <a href="{{ path('quiz_play', {'id': question.id}) }}" 
                               class="btn btn-sm btn-outline-secondary"
                               title="Voir la question">
                                <i class="bi bi-arrow-right"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
            {% endfor %}
        </div>
    </div>
</main>

<style>
@media print {
    .btn, .navbar, footer, header, .back-top {
        display: none !important;
    }
    
    #qr-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
    }
    
    .card {
        border: 1px solid #ddd !important;
        box-shadow: none !important;
        break-inside: avoid;
    }
    
    main {
        background: none !important;
        padding: 20px !important;
    }
}
</style>
{% endblock %}