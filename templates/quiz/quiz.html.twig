<main class="pt-5 pb-5" style="min-height: calc(100vh - 200px); background: url('{{ asset('assets/images/pattern/04.png') }}') no-repeat center center; background-size: cover;">
    <div class="container">
        <!-- Information de l'utilisateur connecté -->
        <div class="card border-0 shadow mb-4">
            <div class="card-body p-4">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0">
                        <div class="avatar avatar-lg rounded-circle bg-primary text-white d-flex align-items-center justify-content-center" style="width: 60px; height: 60px; font-size: 24px;">
                            {{ currentUser.prenom|first|upper }}{{ currentUser.nom|first|upper }}
                        </div>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h4 class="mb-1">Bienvenue, {{ currentUser.prenom }} {{ currentUser.nom }} !</h4>
                        <p class="text-muted mb-0">
                            {{ currentUser.email }} • 
                            {% if 'ROLE_ADMIN' in currentUser.roles %}
                                Administrateur
                            {% elseif 'ROLE_TEACHER' in currentUser.roles %}
                                Enseignant
                            {% elseif 'ROLE_STUDENT' in currentUser.roles %}
                                Étudiant
                            {% endif %}
                            {% if not canAnswer %}
                                • <span class="text-warning"><i class="bi bi-eye me-1"></i>Mode lecture seule</span>
                            {% endif %}
                        </p>
                    </div>
                    <div>
                        <span class="badge bg-primary p-2">
                            <i class="bi bi-check-circle me-1"></i>
                            {{ userResponses|length }} / {{ questions|length }} questions complétées
                        </span>
                    </div>
                </div>
            </div>
        </div>
        <!-- Après la carte d'information utilisateur (ligne ~70) -->
<!-- Bouton d'attestation - Visible uniquement pour les étudiants -->
{% if 'ROLE_STUDENT' in currentUser.roles %}
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-end">
                <a href="{{ path('attestation_view') }}" class="btn btn-outline-primary btn-lg">
                    <i class="bi bi-award-fill me-2"></i>Voir mon attestation
                </a>
            </div>
        </div>
    </div>
{% endif %}

        <!-- Section de recommandation et filtres -->
        <div class="card border-0 shadow mb-4" id="recommendation-section">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="mb-0"><i class="bi bi-lightbulb me-2"></i>Recommandations et filtres</h5>
                    <div id="progress-info">
                        <span id="unworked-count" class="badge bg-danger me-2">0 non travaillées</span>
                        <span id="worked-count" class="badge bg-success">0 travaillées</span>
                    </div>
                </div>
                
                <!-- Barre de progression -->
                <div class="mb-3">
                    <div class="d-flex align-items-center">
                        <div class="progress flex-grow-1" style="height: 10px;">
                            <div id="progress-bar" class="progress-bar bg-success" 
                                 role="progressbar" style="width: 0%" 
                                 aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                        <span class="ms-3 fw-bold" id="progress-percentage">0%</span>
                    </div>
                </div>
                
                <!-- Filtres -->
                <div class="d-flex flex-wrap gap-2">
                    <button class="btn btn-sm btn-outline-primary active filter-btn" data-filter="all">
                        <i class="bi bi-grid-3x3-gap me-1"></i>Toutes
                    </button>
                    <button class="btn btn-sm btn-outline-danger filter-btn" data-filter="unworked">
                        <i class="bi bi-exclamation-circle me-1"></i>Non travaillées
                    </button>
                    <button class="btn btn-sm btn-outline-success filter-btn" data-filter="worked">
                        <i class="bi bi-check-circle me-1"></i>Travaillées
                    </button>
                </div>
            </div>
        </div>
        

        <!-- Liste des questions -->
        <div class="row">
            <div class="col-12">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h1 class="display-5 mb-0">Liste des Questions</h1>
                </div>
                
                <div id="quiz-list">
                    {% for question in questions %}
                        {% set response = userResponses['question_' ~ question.id] ?? null %}
                        <div class="card border-0 shadow mb-4 question-card" 
                             data-question-id="{{ question.id }}"
                             data-has-response="{{ response ? 'true' : 'false' }}">
                            <div class="card-body p-4">
                                <div class="d-flex justify-content-between align-items-start mb-3">
                                    <div class="flex-grow-1">
                                        <!-- En-tête avec indicateur -->
                                        <div class="d-flex align-items-center mb-2">
                                            <div class="question-indicator me-3">
                                                {% if response %}
                                                    <i class="bi bi-check-circle-fill fs-4 text-success"></i>
                                                {% else %}
                                                    <i class="bi bi-question-circle fs-4 text-danger"></i>
                                                {% endif %}
                                            </div>
                                            <div>
                                                <h5 class="card-title mb-1">{{ question.titre }}</h5>
                                                <div class="d-flex flex-wrap gap-2">
                                                    <span class="badge bg-primary">
                                                        <i class="bi bi-star me-1"></i>{{ question.noteMax }} pts
                                                    </span>
                                                    {% if question.duree %}
                                                    <span class="badge bg-secondary">
                                                        <i class="bi bi-clock me-1"></i>{{ question.duree }} min
                                                    </span>
                                                    {% endif %}
                                                    <span class="badge bg-info">
                                                        <i class="bi bi-list-check me-1"></i>{{ question.choix|length }} choix
                                                    </span>
                                                </div>
                                            </div>
                                        </div>
                                        
                                        <p class="text-muted mb-0">{{ question.description|length > 150 ? question.description|slice(0, 150) ~ '...' : question.description }}</p>
                                    </div>
                                    
                                    <!-- Badge de recommandation -->
                                    <div class="recommendation-badge">
                                        {% if not response %}
                                            <span class="badge bg-danger">
                                                <i class="bi bi-exclamation-triangle me-1"></i>À faire
                                            </span>
                                        {% elseif response.isCorrect %}
                                            <span class="badge bg-success">
                                                <i class="bi bi-trophy me-1"></i>Réussi
                                            </span>
                                        {% else %}
                                            <span class="badge bg-warning">
                                                <i class="bi bi-clock-history me-1"></i>À revoir
                                            </span>
                                        {% endif %}
                                    </div>
                                </div>
                                
                                <div class="row mt-3">
                                    <div class="col-md-8">
                                        <!-- Métadonnées -->
                                        <div class="mb-3">
                                            <span class="badge bg-dark me-2">
                                                <i class="bi bi-question-diamond me-1"></i>Q{{ loop.index }}
                                            </span>
                                            
                                            {% if question.duree and question.duree <= 5 %}
                                            <span class="badge bg-success me-2">
                                                <i class="bi bi-lightning me-1"></i>Rapide
                                            </span>
                                            {% elseif question.duree and question.duree > 10 %}
                                            <span class="badge bg-warning me-2">
                                                <i class="bi bi-hourglass-split me-1"></i>Longue
                                            </span>
                                            {% endif %}
                                            
                                            {% if question.noteMax >= 10 %}
                                            <span class="badge bg-danger me-2">
                                                <i class="bi bi-trophy me-1"></i>Importante
                                            </span>
                                            {% endif %}
                                        </div>
                                        
                                        <!-- Statut -->
                                        <div id="question-status-{{ question.id }}">
                                            {% if response %}
                                                <div class="alert alert-{{ response.isCorrect ? 'success' : 'danger' }} py-2 mb-0">
                                                    <i class="bi bi-{{ response.isCorrect ? 'check-circle' : 'x-circle' }} me-2"></i>
                                                    <strong>{{ response.isCorrect ? 'Correct' : 'À revoir' }}</strong> - 
                                                    Score: {{ response.score }}/{{ question.noteMax }} pts
                                                </div>
                                            {% else %}
                                                <div class="alert alert-light py-2 mb-0 border">
                                                    <i class="bi bi-clock me-2"></i>
                                                    <strong>Non travaillée</strong>
                                                    <small class="text-muted ms-2">À découvrir</small>
                                                </div>
                                            {% endif %}
                                        </div>
                                    </div>
                                    
                                    <div class="col-md-4 text-end">
    <div class="d-flex align-items-center justify-content-end gap-2">
        <!-- SEULEMENT QR Code Texte -->
        <a href="{{ path('quiz_qr_view_text', {'id': question.id}) }}" 
           class="btn btn-sm btn-outline-success"
           title="QR code - Voir la question sans internet"
           data-bs-toggle="tooltip">
            <i class="bi bi-qr-code fs-5"></i>
            <span class="d-none d-md-inline ms-1">QR</span>
        </a>
        
        <!-- Bouton d'action principal -->
        <a href="{{ path('quiz_play', {'id': question.id}) }}" 
           class="btn {% if response %}btn-outline-secondary{% else %}btn-primary{% endif %}">
            {% if response %}
                <i class="bi bi-eye me-2"></i>Voir
            {% else %}
                <i class="bi bi-play-circle me-2"></i>
                {% if canAnswer %}Commencer{% else %}Voir{% endif %}
            {% endif %}
        </a>
    </div>
</div>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
                
                {% if questions|length == 0 %}
                <div class="col-12">
                    <div class="alert alert-info">
                        <i class="bi bi-info-circle me-2"></i>
                        Aucune question disponible pour le moment.
                    </div>
                </div>
                {% endif %}
            </div>
        </div>
    </div>
</main>

