<!-- Back to top -->
<div class="back-top"><i class="bi bi-arrow-up-short position-absolute top-50 start-50 translate-middle"></i></div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const userId = {{ currentUser.id }};
    const canAnswer = {{ canAnswer ? 'true' : 'false' }};
    const userResponses = {{ userResponses|json_encode|raw }};
    
    // Initialiser l'affichage
    updateQuestionsAppearance();
    updateProgressStats();
    setupQuestionFilters();
    
    // Fonction pour mettre à jour l'apparence des questions
    function updateQuestionsAppearance() {
        const totalQuestions = document.querySelectorAll('.question-card').length;
        let unworkedCount = 0;
        let workedCount = 0;
        
        document.querySelectorAll('.question-card').forEach((card, index) => {
            const hasResponse = card.dataset.hasResponse === 'true';
            const questionIndicator = card.querySelector('.question-indicator i');
            
            // Reset classes
            card.classList.remove('unworked', 'worked');
            
            if (hasResponse) {
                workedCount++;
                card.classList.add('worked');
                
                if (questionIndicator) {
                    questionIndicator.className = 'bi bi-check-circle-fill fs-4 text-success';
                }
            } else {
                unworkedCount++;
                card.classList.add('unworked');
                
                if (questionIndicator) {
                    questionIndicator.className = 'bi bi-question-circle fs-4 text-danger';
                }
            }
        });
        
        // Mettre à jour les compteurs
        document.getElementById('unworked-count').textContent = `${unworkedCount} non travaillées`;
        document.getElementById('worked-count').textContent = `${workedCount} travaillées`;
        
        // Mettre à jour la barre de progression
        const percentage = totalQuestions > 0 ? Math.round((workedCount / totalQuestions) * 100) : 0;
        const progressBar = document.getElementById('progress-bar');
        const progressPercentage = document.getElementById('progress-percentage');
        
        if (progressBar) {
            progressBar.style.width = `${percentage}%`;
            progressBar.className = `progress-bar ${
                percentage < 30 ? 'bg-danger' : 
                percentage < 70 ? 'bg-warning' : 'bg-success'
            }`;
        }
        
        if (progressPercentage) {
            progressPercentage.textContent = `${percentage}%`;
            progressPercentage.className = `ms-3 fw-bold ${
                percentage < 30 ? 'text-danger' : 
                percentage < 70 ? 'text-warning' : 'text-success'
            }`;
        }
    }
    
    // Fonction pour mettre à jour les statistiques
    function updateProgressStats() {
        const totalQuestions = document.querySelectorAll('.question-card').length;
        const workedCount = document.querySelectorAll('.question-card[data-has-response="true"]').length;
        
        document.getElementById('unworked-count').textContent = `${totalQuestions - workedCount} non travaillées`;
        document.getElementById('worked-count').textContent = `${workedCount} travaillées`;
    }
    
    // Fonction pour configurer les filtres
    function setupQuestionFilters() {
        const filterButtons = document.querySelectorAll('.filter-btn');
        
        filterButtons.forEach(btn => {
            btn.addEventListener('click', function() {
                // Retirer la classe active de tous les boutons
                filterButtons.forEach(b => b.classList.remove('active'));
                // Ajouter la classe active au bouton cliqué
                this.classList.add('active');
                
                const filter = this.dataset.filter;
                filterQuestions(filter);
            });
        });
    }
    
    // Fonction pour filtrer les questions
    function filterQuestions(filter) {
        const cards = document.querySelectorAll('.question-card');
        
        cards.forEach(card => {
            const hasResponse = card.dataset.hasResponse === 'true';
            
            switch(filter) {
                case 'all':
                    card.style.display = 'block';
                    break;
                case 'unworked':
                    card.style.display = !hasResponse ? 'block' : 'none';
                    break;
                case 'worked':
                    card.style.display = hasResponse ? 'block' : 'none';
                    break;
            }
        });
    }
});
</script>
<style>
html, body {
    background-color: #ffffff !important;
    height: 100%;
    margin: 0;
}

.layout-page {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
}

.page-content {
    flex: 1;
    background-color: #ffffff;
}

.site-footer {
    background-color: #0d6efd;
    color: white;
}

/* Styles pour les questions */
.question-card {
    transition: all 0.3s ease;
    border-left: 4px solid transparent;
}

.question-card.unworked {
    border-left-color: #ff6b6b;
    background: linear-gradient(135deg, #fff8f8 0%, #ffffff 100%);
    box-shadow: 0 4px 15px rgba(255, 107, 107, 0.1);
}

.question-card.unworked:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 25px rgba(255, 107, 107, 0.2);
}

.question-card.worked {
    border-left-color: #51cf66;
    background: linear-gradient(135deg, #f8fff9 0%, #ffffff 100%);
}

/* Filtres */
.filter-btn {
    transition: all 0.3s ease;
    border: 2px solid transparent;
}

.filter-btn.active {
    transform: scale(1.05);
    border-color: currentColor;
}

/* Animations */
.start-question-btn {
    transition: all 0.3s ease;
    padding: 0.5rem 1.5rem;
}

.start-question-btn:hover:not(:disabled) {
    transform: translateY(-2px);
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
}

/* Indicateur de question */
.question-indicator i {
    transition: all 0.3s ease;
}

/* Badge de recommandation */
.recommendation-badge {
    opacity: 0;
    transform: translateX(10px);
    transition: all 0.3s ease;
}

.question-card:hover .recommendation-badge {
    opacity: 1;
    transform: translateX(0);
}

/* Animation pour les badges */
@keyframes pulse {
    0% { transform: scale(1); }
    50% { transform: scale(1.05); }
    100% { transform: scale(1); }
}

.badge.bg-danger {
    animation: pulse 2s infinite;
}
</style>
{% endblock %}