<script>
// === HINT SYSTEM === EN DEHORS du DOMContentLoaded ===
let hintUsed = false;

function requestHint() {
    if (hintUsed) return;

    document.getElementById('hint-btn').disabled = true;
    document.getElementById('hint-loading').classList.remove('d-none');

    fetch('{{ path("quiz_ai_hint", {"id": question.id}) }}')
        .then(res => res.json())
        .then(data => {
            document.getElementById('hint-loading').classList.add('d-none');

            if (data.success) {
                hintUsed = true;
                document.getElementById('hint-text').textContent = data.hint;
                document.getElementById('hint-box').classList.remove('d-none');
                document.getElementById('hint-btn').innerHTML =
                    '<i class="bi bi-lightbulb-fill me-2"></i>Indice utilisé (-25%)';
                document.getElementById('hint-btn').classList.remove('btn-outline-warning');
                document.getElementById('hint-btn').classList.add('btn-warning');
            } else {
                document.getElementById('hint-btn').disabled = false;
                alert(data.error || 'Impossible de générer un indice.');
            }
        })
        .catch(() => {
            document.getElementById('hint-loading').classList.add('d-none');
            document.getElementById('hint-btn').disabled = false;
            alert('Erreur réseau. Réessayez.');
        });
}

// === VOICE RECOGNITION SYSTEM ===
let recognition = null;
let isRecording = false;
let voiceResultReceived = false; // ← NOUVEAU : flag pour savoir si on a eu un résultat

function startVoiceRecognition() {
    const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
    if (!SpeechRecognition) {
        alert('Votre navigateur ne supporte pas la reconnaissance vocale. Utilisez Chrome ou Edge.');
        return;
    }

    recognition = new SpeechRecognition();
    recognition.lang = 'fr-FR';
    recognition.continuous = false;
    recognition.interimResults = false;
    voiceResultReceived = false; // ← reset à chaque tentative

    isRecording = true;
    document.getElementById('voice-btn').classList.add('recording');
    document.getElementById('voice-btn').disabled = true;
    document.getElementById('voice-btn').innerHTML = '<i class="bi bi-mic-fill me-2"></i>Écoute en cours...';
    document.getElementById('voice-status').classList.remove('d-none');
    document.getElementById('voice-result').classList.add('d-none');

    recognition.onresult = function(event) {
        voiceResultReceived = true; // ← marquer qu'on a reçu un résultat
        const transcript = event.results[0][0].transcript.toLowerCase().trim();
        console.log('Transcription:', transcript);
        handleVoiceResult(transcript);
    };

    recognition.onerror = function(event) {
        console.error('Erreur reconnaissance vocale:', event.error);
        const messages = {
            'not-allowed': 'Accès au microphone refusé. Autorisez-le dans les paramètres du navigateur.',
            'no-speech':   'Aucune parole détectée. Réessayez.',
            'network':     'Erreur réseau. Vérifiez votre connexion.'
        };
        stopVoiceRecognition();
        alert(messages[event.error] || 'Erreur lors de la reconnaissance vocale.');
    };

    recognition.onend = function() {
        // ← Si onend se déclenche sans résultat, afficher message
        if (!voiceResultReceived) {
            document.getElementById('voice-result').classList.remove('d-none');
            document.getElementById('voice-transcript').textContent = '(aucune parole détectée)';
            document.getElementById('voice-match').innerHTML = `
                <span class="badge bg-secondary mt-1">
                    <i class="bi bi-mic-mute me-1"></i>
                    Rien entendu — réessayez ou sélectionnez manuellement
                </span>
            `;
        }
        stopVoiceRecognition();
    };

    recognition.start();
}

function stopVoiceRecognition() {
    isRecording = false;
    
    try {
        if (recognition) recognition.stop();
    } catch(e) {
        // Ignorer l'erreur si déjà arrêté
    }

    const voiceBtn = document.getElementById('voice-btn');
    if (voiceBtn) {
        voiceBtn.classList.remove('recording');
        voiceBtn.disabled = false;
        voiceBtn.innerHTML = '<i class="bi bi-mic me-2"></i>Répondre oralement';
    }

    const voiceStatus = document.getElementById('voice-status');
    if (voiceStatus) voiceStatus.classList.add('d-none');
}

function handleVoiceResult(transcript) {
    document.getElementById('voice-transcript').textContent = transcript;
    document.getElementById('voice-result').classList.remove('d-none');

    const choices = document.querySelectorAll('.choice-item');
    let bestMatch = null;
    let bestScore = 0;
    let bestChoiceText = '';

    // Nettoyer et normaliser le texte
    function normalize(text) {
        return text
            .toLowerCase()
            .normalize('NFD')                        // décomposer les accents
            .replace(/[\u0300-\u036f]/g, '')         // supprimer les accents
            .replace(/[^a-z0-9\s]/g, '')             // garder lettres/chiffres
            .trim();
    }

    const normalizedTranscript = normalize(transcript);
    const transcriptWords = normalizedTranscript.split(/\s+/).filter(w => w.length > 0);

    console.log('Transcript normalisé:', normalizedTranscript);

    choices.forEach(item => {
        const input = item.querySelector('input');
        const label = item.querySelector('.choice-text');
        if (!label || input.disabled) return;

        const choiceText = normalize(label.textContent);
        const choiceWords = choiceText.split(/\s+/).filter(w => w.length > 0);

        console.log('Choix normalisé:', choiceText);

        let score = 0;

        // ✅ Méthode 1 : correspondance exacte totale (score max)
        if (normalizedTranscript === choiceText) {
            score = 1.0;
        }

        // ✅ Méthode 2 : le transcript contient le texte du choix
        else if (normalizedTranscript.includes(choiceText)) {
            score = 0.95;
        }

        // ✅ Méthode 3 : le texte du choix contient le transcript
        else if (choiceText.includes(normalizedTranscript)) {
            score = 0.9;
        }

        // ✅ Méthode 4 : correspondance mot par mot (SANS limite de longueur)
        else {
            let matchCount = 0;

            transcriptWords.forEach(word => {
                // Chercher le mot dans les mots du choix
                if (choiceWords.some(cw => cw === word || cw.includes(word) || word.includes(cw))) {
                    matchCount++;
                }
            });

            // Score basé sur proportion de mots matchés
            const transcriptScore = matchCount / Math.max(transcriptWords.length, 1);
            const choiceScore     = matchCount / Math.max(choiceWords.length, 1);
            score = (transcriptScore + choiceScore) / 2;
        }

        console.log(`Score pour "${choiceText}": ${score}`);

        if (score > bestScore) {
            bestScore = score;
            bestMatch = input;
            bestChoiceText = label.textContent.trim();
        }
    });

    const matchDiv = document.getElementById('voice-match');

    // ✅ Seuil abaissé à 0.1 pour mots courts comme "Paris", "Oui", "Non"
    if (bestMatch && bestScore > 0.1) {
        // Décocher tous les choix
        document.querySelectorAll('.choice-input').forEach(cb => {
            cb.checked = false;
            const lbl = document.querySelector(`label[for="${cb.id}"]`);
            if (lbl) {
                lbl.classList.remove('active', 'bg-primary', 'text-white');
                lbl.classList.add('btn-outline-primary');
            }
        });

        // Cocher le meilleur match
        bestMatch.checked = true;
        const matchLabel = document.querySelector(`label[for="${bestMatch.id}"]`);
        if (matchLabel) {
            matchLabel.classList.add('active', 'bg-primary', 'text-white');
            matchLabel.classList.remove('btn-outline-primary');
        }

        // Déclencher change pour mettre à jour selectedChoiceIds
        bestMatch.dispatchEvent(new Event('change', { bubbles: true }));

        const confidence = Math.round(bestScore * 100);
        matchDiv.innerHTML = `
            <span class="badge bg-success fs-6 mt-1">
                <i class="bi bi-check-circle me-1"></i>
                "${bestChoiceText}" sélectionné (${confidence}% de confiance)
            </span>
            <small class="text-muted d-block mt-1">Vérifiez et cliquez sur "Valider" si c'est correct</small>
        `;
    } else {
        matchDiv.innerHTML = `
            <span class="badge bg-warning text-dark fs-6 mt-1">
                <i class="bi bi-exclamation-triangle me-1"></i>
                Aucune correspondance trouvée pour "<em>${transcript}</em>"
            </span>
            <small class="text-muted d-block mt-1">Sélectionnez manuellement ou réessayez</small>
        `;
    }
}

// === DOMCONTENTLOADED ===
document.addEventListener('DOMContentLoaded', function() {
    const questionId = {{ question.id }};
    const userId = {{ currentUser.id }};
    const maxTime = {{ question.duree ? question.duree * 60 : 0 }};
    const maxScore = {{ question.noteMax }};
    const correctCount = {{ correctCount }};
    const isMultipleChoice = correctCount > 1;
    const canAnswer = {{ canAnswer ? 'true' : 'false' }};
    const existingResponse = {{ existingResponse ? existingResponse|json_encode|raw : 'null' }};

    let timeLeft = maxTime;
    let timerInterval = null;
    let selectedChoiceIds = [];
    let isAnswered = false;

    const timerEl = document.getElementById('timer');
    const validateBtn = document.getElementById('validate-btn');

    if (existingResponse) {
        console.log('Mode consultation - réponse existante');
        document.getElementById('already-answered-alert').style.display = 'block';
        if (validateBtn) {
            validateBtn.disabled = true;
            validateBtn.textContent = 'Déjà répondu';
        }
        document.getElementById('current-score').textContent = existingResponse.score;
        document.getElementById('timer').textContent = 'Terminé';

        document.querySelectorAll('.choice-item').forEach(item => {
            const choiceId = parseInt(item.querySelector('input').value);
            const label = item.querySelector('label');
            const input = item.querySelector('input');

            input.disabled = true;

            if (!label.querySelector('.badge')) {
                const isCorrect = existingResponse.correctChoiceIds.includes(choiceId);
                const wasSelected = existingResponse.selectedChoiceIds.includes(choiceId);

                if (isCorrect && wasSelected) {
                    label.classList.remove('btn-outline-primary');
                    label.classList.add('btn-success', 'text-white');
                    label.innerHTML += '<span class="badge bg-success ms-2"><i class="bi bi-check-lg"></i> Bonne réponse choisie</span>';
                } else if (isCorrect && !wasSelected) {
                    label.classList.remove('btn-outline-primary');
                    label.classList.add('btn-warning', 'text-dark');
                    label.innerHTML += '<span class="badge bg-warning ms-2"><i class="bi bi-exclamation-lg"></i> Bonne réponse manquée</span>';
                } else if (!isCorrect && wasSelected) {
                    label.classList.remove('btn-outline-primary');
                    label.classList.add('btn-danger', 'text-white');
                    label.innerHTML += '<span class="badge bg-danger ms-2"><i class="bi bi-x-lg"></i> Mauvaise réponse choisie</span>';
                } else {
                    label.classList.remove('btn-outline-primary');
                    label.classList.add('btn-outline-secondary');
                }
            }
            label.style.cursor = 'not-allowed';
        });

        if (document.getElementById('feedback-section')) {
            showFeedback(
                existingResponse.isCorrect ? '✅' : '❌',
                existingResponse.isCorrect ? 'Correct !' : 'Incorrect',
                existingResponse.isCorrect ?
                    `Félicitations ! Vous avez obtenu ${existingResponse.score} points.` :
                    `Dommage ! Vous n'avez pas obtenu tous les points.`,
                existingResponse.isCorrect ? 'success' : 'danger'
            );
            document.getElementById('score-obtained').textContent = existingResponse.score;
        }

    } else if (!canAnswer) {
        console.log('Mode lecture seule');
        document.querySelectorAll('.choice-item input').forEach(input => {
            input.disabled = true;
        });
        document.querySelectorAll('.choice-item label').forEach(label => {
            label.style.cursor = 'not-allowed';
        });
        if (validateBtn) validateBtn.style.display = 'none';
        if (maxTime > 0) {
            updateTimerDisplay();
        } else {
            timerEl.textContent = '∞';
        }

    } else {
        console.log('Mode normal - Démarrage du timer');
        startTimer();

        document.querySelectorAll('.choice-input').forEach(input => {
            input.addEventListener('change', function() {
                if (isAnswered) return;

                if (this.checked) {
                    selectedChoiceIds.push(this.value);
                } else {
                    selectedChoiceIds = selectedChoiceIds.filter(id => id !== this.value);
                }

                if (validateBtn) {
                    validateBtn.disabled = selectedChoiceIds.length === 0;
                }

                document.querySelectorAll('.choice-item label').forEach(label => {
                    const inputId = label.getAttribute('for');
                    const input = document.getElementById(inputId);

                    if (input && input.checked) {
                        label.classList.add('active', 'bg-primary', 'text-white');
                        label.classList.remove('btn-outline-primary');
                    } else if (input) {
                        label.classList.remove('active', 'bg-primary', 'text-white');
                        label.classList.add('btn-outline-primary');
                    }
                });
            });
        });

        if (validateBtn) {
            validateBtn.addEventListener('click', function() {
                if (selectedChoiceIds.length === 0 || isAnswered) return;
                submitAnswer();
            });
        }
    }

    function startTimer() {
        if (maxTime > 0) {
            updateTimerDisplay();
            if (timerInterval) clearInterval(timerInterval);

            timerInterval = setInterval(() => {
                if (timeLeft > 0 && !isAnswered) {
                    timeLeft--;
                    updateTimerDisplay();
                }
                if (timeLeft <= 0 && !isAnswered) {
                    handleTimeOut();
                }
            }, 1000);
        } else {
            timerEl.textContent = '∞';
        }
    }

    function updateTimerDisplay() {
        if (!timerEl) return;
        if (maxTime === 0) { timerEl.textContent = '∞'; return; }
        const min = Math.floor(timeLeft / 60);
        const sec = timeLeft % 60;
        timerEl.textContent = `${min}:${sec.toString().padStart(2, '0')}`;

        if (timeLeft <= 30 && timeLeft > 10) {
            timerEl.className = 'display-4 fw-bold text-warning';
        } else if (timeLeft <= 10) {
            timerEl.className = 'display-4 fw-bold text-danger';
        } else {
            timerEl.className = 'display-4 fw-bold text-primary';
        }
    }

    function handleTimeOut() {
        isAnswered = true;
        clearInterval(timerInterval);

        // Arrêter la reconnaissance vocale si active
        if (isRecording) stopVoiceRecognition();

        if (validateBtn) {
            validateBtn.disabled = true;
            validateBtn.textContent = 'Temps écoulé';
        }
        document.querySelectorAll('.choice-item label').forEach(label => {
            label.classList.add('disabled');
            label.style.cursor = 'not-allowed';
            label.style.opacity = '0.6';
        });
        if (selectedChoiceIds.length > 0) {
            submitAnswer();
        } else {
            showFeedback('⏰', 'Temps écoulé !', 'Le temps pour répondre à cette question est terminé.', 'warning');
        }
    }

    function submitAnswer() {
        isAnswered = true;
        clearInterval(timerInterval);

        // Arrêter la reconnaissance vocale si active
        if (isRecording) stopVoiceRecognition();

        if (validateBtn) {
            validateBtn.disabled = true;
            validateBtn.textContent = 'Validation...';
        }

        fetch('{{ path("quiz_check_answer") }}', {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({
                questionId: questionId,
                selectedChoicesIds: selectedChoiceIds,
                hintUsed: hintUsed
            })
        })
        .then(res => res.json())
        .then(result => {
            if (!result.success) throw new Error(result.error);

            document.getElementById('current-score').textContent = result.score;

            document.querySelectorAll('.choice-item').forEach(item => {
                const choiceId = parseInt(item.querySelector('input').value);
                const label = item.querySelector('label');
                const input = item.querySelector('input');

                input.disabled = true;

                if (!label.querySelector('.badge')) {
                    const isCorrect = result.correctChoiceIds.includes(choiceId);
                    const wasSelected = selectedChoiceIds.includes(choiceId.toString());

                    if (isCorrect && wasSelected) {
                        label.classList.remove('btn-outline-primary');
                        label.classList.add('btn-success', 'text-white');
                        label.innerHTML += '<span class="badge bg-success ms-2"><i class="bi bi-check-lg"></i> Bonne réponse</span>';
                    } else if (isCorrect && !wasSelected) {
                        label.classList.remove('btn-outline-primary');
                        label.classList.add('btn-warning', 'text-dark');
                        label.innerHTML += '<span class="badge bg-warning ms-2"><i class="bi bi-exclamation-lg"></i> À cocher</span>';
                    } else if (!isCorrect && wasSelected) {
                        label.classList.remove('btn-outline-primary');
                        label.classList.add('btn-danger', 'text-white');
                        label.innerHTML += '<span class="badge bg-danger ms-2"><i class="bi bi-x-lg"></i> Fausse réponse</span>';
                    } else {
                        label.classList.remove('btn-outline-primary');
                        label.classList.add('btn-outline-secondary');
                    }
                }
                label.style.cursor = 'not-allowed';
            });

            // Feedback avec pénalité hint
            if (result.score > 0) {
                const hintNote = result.hintUsed
                    ? ` — Pénalité hint : -${result.penalite} pt(s)`
                    : '';
                if (isMultipleChoice) {
                    showFeedback('✅', 'Parfait !',
                        `Vous avez coché toutes les ${correctCount} bonnes réponses. Score: ${result.score}/${result.maxScore}${hintNote}`,
                        'success');
                } else {
                    showFeedback('✅', 'Correct !',
                        `Félicitations ! Score: ${result.score}/${result.maxScore}${hintNote}`,
                        'success');
                }
            } else {
                if (selectedChoiceIds.length === 0) {
                    showFeedback('❌', 'Aucune réponse', 'Vous n\'avez sélectionné aucune réponse.', 'warning');
                } else if (isMultipleChoice && selectedChoiceIds.length < correctCount) {
                    showFeedback('❌', 'Réponses manquantes',
                        `Vous devez cocher ${correctCount} réponse(s). Vous en avez coché ${selectedChoiceIds.length}.`,
                        'danger');
                } else {
                    showFeedback('❌', 'Incorrect', 'Vous avez fait une ou plusieurs erreurs dans votre sélection.', 'danger');
                }
            }

            document.getElementById('score-obtained').textContent = result.score;

            setTimeout(() => {
                window.location.href = "{{ path('quiz') }}";
            }, 3000);
        })
        .catch(error => {
            console.error('Error:', error);
            showFeedback('❌', 'Erreur', 'Une erreur est survenue lors de la soumission.', 'danger');
            if (validateBtn) {
                validateBtn.textContent = 'Erreur - Réessayer';
                validateBtn.disabled = false;
            }
            isAnswered = false;
        });
    }

    function showFeedback(icon, title, message, type) {
        const feedbackIcon = document.getElementById('feedback-icon');
        const feedbackTitle = document.getElementById('feedback-title');
        const feedbackMessage = document.getElementById('feedback-message');
        const feedbackSection = document.getElementById('feedback-section');

        if (feedbackIcon) {
            feedbackIcon.textContent = icon;
            feedbackIcon.className = `display-1 mb-3 text-${type}`;
        }
        if (feedbackTitle) {
            feedbackTitle.textContent = title;
            feedbackTitle.className = `mb-3 text-${type}`;
        }
        if (feedbackMessage) feedbackMessage.textContent = message;
        if (feedbackSection) {
            feedbackSection.style.display = 'block';
            feedbackSection.scrollIntoView({behavior: 'smooth'});
        }
    }
});
</script>
