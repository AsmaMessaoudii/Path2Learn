<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.controllers.RessourcesFrontController"
      style="-fx-background-color: #F5F5F5;"
      prefWidth="1200" prefHeight="800">

    <!-- HEADER FIXE -->
    <VBox style="-fx-background-color: white; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 10, 0, 0, 2);">
        <HBox alignment="CENTER_LEFT" spacing="30.0" style="-fx-padding: 15 40;">
            <!-- Logo -->
            <ImageView fitWidth="150" fitHeight="150" preserveRatio="true">
                <Image url="/0c0390ea-b94e-4e66-bdee-dc1608f0674c.jpg" />
            </ImageView>
            <Region HBox.hgrow="ALWAYS" />

            <!-- Liens -->
            <HBox spacing="25.0" alignment="CENTER">
                <Button fx:id="homeBtn" onAction="#handleHome" text="Accueil"
                        style="-fx-background-color: transparent; -fx-text-fill: #555555; -fx-font-size: 13px; -fx-cursor: hand; -fx-padding: 0 0 5 0;" />
                <Button fx:id="coursBtn" onAction="#handleCours" text="Cours"
                        style="-fx-background-color: transparent; -fx-text-fill: #555555; -fx-font-size: 13px; -fx-cursor: hand; -fx-padding: 0 0 5 0;" />
                <Button fx:id="ressourcesBtn" onAction="#handleRessources" text="Ressources"
                        style="-fx-background-color: transparent; -fx-text-fill: #4CAF50; -fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 0 0 5 0; -fx-border-color: transparent transparent #4CAF50 transparent; -fx-border-width: 0 0 2 0;" />
                <Button fx:id="questionsBtn" onAction="#handleQuestions" text="Quiz"
                        style="-fx-background-color: transparent; -fx-text-fill: #555555; -fx-font-size: 13px; -fx-cursor: hand; -fx-padding: 0 0 5 0;" />
                <Button fx:id="projetsBtn" onAction="#handleProjets" text="Projets"
                        style="-fx-background-color: transparent; -fx-text-fill: #555555; -fx-font-size: 13px; -fx-cursor: hand; -fx-padding: 0 0 5 0;" />
                <Button fx:id="evenementsBtn" onAction="#handleEvenements" text="Événements"
                        style="-fx-background-color: transparent; -fx-text-fill: #555555; -fx-font-size: 13px; -fx-cursor: hand; -fx-padding: 0 0 5 0;" />
                <Button fx:id="utilisateursBtn" onAction="#handleUtilisateurs" text="Communauté"
                        style="-fx-background-color: transparent; -fx-text-fill: #555555; -fx-font-size: 13px; -fx-cursor: hand; -fx-padding: 0 0 5 0;" />
            </HBox>

            <Region HBox.hgrow="ALWAYS" />

            <!-- Auth Buttons -->
            <HBox spacing="12.0" alignment="CENTER">
                <Button text="Se connecter"
                        style="-fx-background-color: transparent; -fx-text-fill: #4CAF50; -fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 6 18; -fx-border-color: #4CAF50; -fx-border-radius: 25; -fx-background-radius: 25;" />
                <Button text="S'inscrire"
                        style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 6 22; -fx-background-radius: 25;" />
            </HBox>
        </HBox>
    </VBox>

    <!-- ===== CONTENU PRINCIPAL ===== -->
    <VBox VBox.vgrow="ALWAYS" style="-fx-background-color: #F5F5F5;">

        <!-- Topbar -->
        <HBox style="-fx-background-color: white; -fx-padding: 18 30; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 5, 0, 0, 2);" alignment="CENTER_LEFT" spacing="10">
            <Button text="← Retour aux cours" onAction="#handleRetourCours"
                    style="-fx-background-color: #F5F5F5; -fx-text-fill: #666; -fx-font-size: 12px; -fx-padding: 6 14; -fx-background-radius: 20; -fx-border-color: #DDD; -fx-border-radius: 20; -fx-cursor: hand;" />
            <Label text="/" style="-fx-text-fill: #CCC;" />
            <Label fx:id="breadcrumbCours" text="Cours" style="-fx-font-size: 13px; -fx-text-fill: #999;" />
            <Label text="/" style="-fx-text-fill: #CCC;" />
            <Label text="Ressources" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #2E5C2E;" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="statsRessources" text="0 ressource" style="-fx-font-size: 12px; -fx-text-fill: #999; -fx-background-color: #F0F0F0; -fx-padding: 4 12; -fx-background-radius: 20;" />
        </HBox>

        <ScrollPane fitToWidth="true" style="-fx-background: #F5F5F5; -fx-background-color: #F5F5F5; -fx-border-width: 0;" VBox.vgrow="ALWAYS">
            <VBox spacing="20.0" style="-fx-padding: 28 36;">

                <!-- Carte info du cours -->
                <HBox fx:id="coursInfoBanner" spacing="16" alignment="CENTER_LEFT"
                      style="-fx-background-color: white; -fx-background-radius: 14; -fx-border-color: #E8E8E8; -fx-border-radius: 14; -fx-padding: 18 22; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 8, 0, 0, 2);">
                    <Label fx:id="coursEmoji" text="📚" style="-fx-font-size: 36px;" />
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label fx:id="coursTitreLabel" text="Titre du cours" style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #1A1A1A;" />
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <Label fx:id="coursNiveauLabel" text="Niveau" style="-fx-font-size: 11px; -fx-background-color: #E8F5E9; -fx-text-fill: #2E7D32; -fx-padding: 3 10; -fx-background-radius: 12; -fx-font-weight: bold;" />
                            <Label fx:id="coursMatiereLabel" text="Matière" style="-fx-font-size: 11px; -fx-background-color: #F0F4FF; -fx-text-fill: #3949AB; -fx-padding: 3 10; -fx-background-radius: 12;" />
                            <Label fx:id="coursDureeLabel" text="0h" style="-fx-font-size: 11px; -fx-text-fill: #AAAAAA;" />
                        </HBox>
                        <Label fx:id="coursDescLabel" text="Description du cours..." style="-fx-font-size: 12px; -fx-text-fill: #888888; -fx-wrap-text: true;" maxWidth="600" />
                    </VBox>
                </HBox>

                <!-- Barre de recherche ressources -->
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <HBox style="-fx-background-color: white; -fx-background-radius: 25; -fx-border-color: #E0E0E0; -fx-border-radius: 25; -fx-padding: 0 15;" alignment="CENTER_LEFT" spacing="8" HBox.hgrow="ALWAYS">
                        <Label text="🔍" style="-fx-font-size: 13px;" />
                        <TextField fx:id="searchField" promptText="Rechercher une ressource..."
                                   style="-fx-background-color: transparent; -fx-border-width: 0; -fx-font-size: 13px; -fx-padding: 9 0;"
                                   HBox.hgrow="ALWAYS" />
                    </HBox>
                    <ComboBox fx:id="typeFilter" promptText="Type" prefWidth="140"
                              style="-fx-background-radius: 20; -fx-border-color: #E0E0E0; -fx-border-radius: 20; -fx-font-size: 12px;" />
                    <Button text="Réinitialiser" onAction="#handleResetRecherche"
                            style="-fx-background-color: #F5F5F5; -fx-text-fill: #666; -fx-font-size: 12px; -fx-padding: 8 16; -fx-background-radius: 20; -fx-border-color: #E0E0E0; -fx-border-radius: 20; -fx-cursor: hand;" />
                </HBox>

                <!-- Liste des ressources (VBox dynamique) -->
                <VBox fx:id="ressourcesContainer" spacing="10" />

                <!-- État vide -->
                <VBox fx:id="emptyState" alignment="CENTER" spacing="12" style="-fx-padding: 60 0;" visible="false" managed="false">
                    <Label text="📂" style="-fx-font-size: 44px;" />
                    <Label text="Aucune ressource disponible" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #999;" />
                    <Label text="Ce cours n'a pas encore de ressources associées" style="-fx-font-size: 13px; -fx-text-fill: #BBB;" />
                </VBox>

            </VBox>
        </ScrollPane>
    </VBox>
</VBox>