<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.controllers.PortfolioDialogController"
      prefWidth="500"
      style="-fx-background-color: #F8FFF8;">
    <padding>
        <Insets bottom="0" left="0" right="0" top="0" />
    </padding>

    <!-- Header band -->
    <VBox style="-fx-background-color: #2E5C2E; -fx-padding: 25 30 20 30;" spacing="5">
        <Label text="💼" style="-fx-font-size: 32px;"/>
        <Label fx:id="dialogTitle" text="Créer mon portfolio"
               style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: white;"/>
        <Label text="Votre portfolio est votre vitrine professionnelle"
               style="-fx-font-size: 12px; -fx-text-fill: #A5D6A7;"/>
    </VBox>

    <!-- Form -->
    <VBox spacing="20" style="-fx-padding: 30;">

        <!-- Titre -->
        <VBox spacing="6">
            <Label text="📌  Titre du portfolio"
                   style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #2E5C2E;"/>
            <TextField fx:id="titreField"
                       promptText="Ex: Portfolio développeur Java..."
                       style="-fx-padding: 12; -fx-background-radius: 10;
                              -fx-border-color: #E0E0E0; -fx-border-radius: 10;
                              -fx-font-size: 13px; -fx-background-color: white;"/>
            <Label fx:id="titreError"
                   style="-fx-text-fill: #f44336; -fx-font-size: 11px; -fx-padding: 0 0 0 5;"/>
        </VBox>

        <!-- Description -->
        <VBox spacing="6">
            <Label text="📝  Description"
                   style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #2E5C2E;"/>
            <TextArea fx:id="descriptionArea"
                      promptText="Décrivez votre profil, vos compétences, vos objectifs..."
                      prefHeight="110" wrapText="true"
                      style="-fx-padding: 12; -fx-background-radius: 10;
                             -fx-border-color: #E0E0E0; -fx-border-radius: 10;
                             -fx-font-size: 13px; -fx-background-color: white;"/>
            <Label fx:id="descriptionError"
                   style="-fx-text-fill: #f44336; -fx-font-size: 11px; -fx-padding: 0 0 0 5;"/>
        </VBox>

        <!-- Buttons -->
        <HBox spacing="12" alignment="CENTER_RIGHT" style="-fx-padding: 10 0 0 0;">
            <Button onAction="#handleAnnuler" text="Annuler"
                    style="-fx-background-color: transparent; -fx-text-fill: #888888;
                           -fx-font-size: 13px; -fx-padding: 10 25;
                           -fx-border-color: #DDDDDD; -fx-border-radius: 25;
                           -fx-background-radius: 25; -fx-cursor: hand;"/>
            <Button fx:id="saveButton" onAction="#handleSauvegarder" text="✅  Sauvegarder"
                    style="-fx-background-color: #2E5C2E; -fx-text-fill: white;
                           -fx-font-weight: bold; -fx-font-size: 13px;
                           -fx-padding: 10 30; -fx-background-radius: 25; -fx-cursor: hand;"/>
        </HBox>
    </VBox>
</VBox>