<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.*?>

<HBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.controllers.MainMenuController"
      style="-fx-background-color: #F5F5F5;">

    <!-- ═══════════════════════════════════════════════════════ SIDEBAR -->
    <VBox style="-fx-background-color: white; -fx-border-color: #E0E0E0; -fx-border-width: 0 1 0 0;
                 -fx-min-width: 220; -fx-max-width: 220; -fx-pref-width: 220;"
          VBox.vgrow="ALWAYS">

        <!-- Logo -->
        <HBox alignment="CENTER_LEFT" spacing="10"
              style="-fx-padding: 20 16 16 16; -fx-border-color: #F0F0F0; -fx-border-width: 0 0 1 0;">
            <Label text="🌿" style="-fx-font-size: 22px;" />
            <Label text="Path2Learn"
                   style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #4CAF50;" />
        </HBox>

        <!-- Section Navigation -->
        <Label text="NAVIGATION"
               style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #AAAAAA; -fx-padding: 16 16 6 16;" />

        <Button fx:id="homeBtn" onAction="#handleHome" text="  Dashboard"
                style="-fx-background-color: #E8F5E9; -fx-text-fill: #2E7D32; -fx-font-size: 13px;
                       -fx-font-weight: bold; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;
                       -fx-padding: 10 16; -fx-background-radius: 0;
                       -fx-border-color: transparent #4CAF50 transparent transparent;
                       -fx-border-width: 0 3 0 0; -fx-max-width: Infinity;" />
        <Button fx:id="coursBtn" onAction="#handleCours" text="  Cours"
                style="-fx-background-color: transparent; -fx-text-fill: #555555; -fx-font-size: 13px;
                       -fx-alignment: CENTER_LEFT; -fx-cursor: hand; -fx-padding: 10 16;
                       -fx-background-radius: 0; -fx-max-width: Infinity;" />
        <Button fx:id="ressourcesBtn" onAction="#handleRessources" text="  Ressources"
                style="-fx-background-color: transparent; -fx-text-fill: #555555; -fx-font-size: 13px;
                       -fx-alignment: CENTER_LEFT; -fx-cursor: hand; -fx-padding: 10 16;
                       -fx-background-radius: 0; -fx-max-width: Infinity;" />
        <Button fx:id="questionsBtn" onAction="#handleQuestions" text="  Quiz"
                style="-fx-background-color: transparent; -fx-text-fill: #555555; -fx-font-size: 13px;
                       -fx-alignment: CENTER_LEFT; -fx-cursor: hand; -fx-padding: 10 16;
                       -fx-background-radius: 0; -fx-max-width: Infinity;" />
        <Button fx:id="projetsBtn" onAction="#handleProjets" text="  Projets"
                style="-fx-background-color: transparent; -fx-text-fill: #555555; -fx-font-size: 13px;
                       -fx-alignment: CENTER_LEFT; -fx-cursor: hand; -fx-padding: 10 16;
                       -fx-background-radius: 0; -fx-max-width: Infinity;" />

        <!-- Section Gestion -->
        <Label text="GESTION"
               style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #AAAAAA; -fx-padding: 16 16 6 16;" />

        <Button fx:id="evenementsBtn" onAction="#handleEvenements" text="  Événements"
                style="-fx-background-color: transparent; -fx-text-fill: #555555; -fx-font-size: 13px;
                       -fx-alignment: CENTER_LEFT; -fx-cursor: hand; -fx-padding: 10 16;
                       -fx-background-radius: 0; -fx-max-width: Infinity;" />
        <Button fx:id="utilisateursBtn" onAction="#handleUtilisateurs" text="  Communauté"
                style="-fx-background-color: transparent; -fx-text-fill: #555555; -fx-font-size: 13px;
                       -fx-alignment: CENTER_LEFT; -fx-cursor: hand; -fx-padding: 10 16;
                       -fx-background-radius: 0; -fx-max-width: Infinity;" />

        <Region VBox.vgrow="ALWAYS" />

        <!-- Footer utilisateur -->
        <HBox alignment="CENTER_LEFT" spacing="10"
              style="-fx-padding: 14 16; -fx-border-color: #F0F0F0; -fx-border-width: 1 0 0 0;">
            <Label text="AD"
                   style="-fx-background-color: #E8F5E9; -fx-text-fill: #2E7D32; -fx-font-size: 12px;
                          -fx-font-weight: bold; -fx-padding: 6 9; -fx-background-radius: 50;" />
            <VBox spacing="1">
                <Label text="Admin"
                       style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #333333;" />
                <Label text="Administrateur"
                       style="-fx-font-size: 11px; -fx-text-fill: #999999;" />
            </VBox>
        </HBox>
    </VBox>

    <!-- ═══════════════════════════════════════════════════════ MAIN -->
    <VBox HBox.hgrow="ALWAYS" style="-fx-background-color: #F5F5F5;">

        <!-- Topbar -->
        <HBox alignment="CENTER_LEFT" spacing="8"
              style="-fx-background-color: white; -fx-padding: 13 24;
                     -fx-border-color: #E0E0E0; -fx-border-width: 0 0 1 0;">
            <Label text="Dashboard" style="-fx-font-size: 12px; -fx-text-fill: #AAAAAA;" />
            <Label text="›" style="-fx-font-size: 12px; -fx-text-fill: #CCCCCC;" />
            <Label text="Accueil" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #333333;" />
        </HBox>

        <!-- Contenu scrollable -->
        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                    style="-fx-background: #F5F5F5; -fx-background-color: #F5F5F5; -fx-border-width: 0;">
            <VBox spacing="24" style="-fx-padding: 28 32;">

                <!-- En-tête de page -->
                <VBox spacing="4">
                    <Label text="Tableau de bord"
                           style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1A1A1A;" />
                    <Label text="Bienvenue sur Path2Learn — accédez rapidement à chaque section."
                           style="-fx-font-size: 13px; -fx-text-fill: #888888;" />
                </VBox>

                <!-- Cartes de statistiques -->
                <HBox spacing="16">
                    <VBox spacing="4"
                          style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 16 20;
                                 -fx-border-color: #EEEEEE; -fx-border-radius: 10;" HBox.hgrow="ALWAYS">
                        <Label text="COURS"
                               style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #AAAAAA;" />
                        <Label fx:id="statsCoursLabel" text="—"
                               style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #1A1A1A;" />
                        <Label text="cours au total"
                               style="-fx-font-size: 11px; -fx-text-fill: #888888;" />
                    </VBox>
                    <VBox spacing="4"
                          style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 16 20;
                                 -fx-border-color: #EEEEEE; -fx-border-radius: 10;" HBox.hgrow="ALWAYS">
                        <Label text="RESSOURCES"
                               style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #AAAAAA;" />
                        <Label fx:id="statsRessourcesLabel" text="—"
                               style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #1A1A1A;" />
                        <Label text="ressources disponibles"
                               style="-fx-font-size: 11px; -fx-text-fill: #888888;" />
                    </VBox>
                    <VBox spacing="4"
                          style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 16 20;
                                 -fx-border-color: #EEEEEE; -fx-border-radius: 10;" HBox.hgrow="ALWAYS">
                        <Label text="QUIZ"
                               style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #AAAAAA;" />
                        <Label fx:id="statsQuizLabel" text="—"
                               style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #1A1A1A;" />
                        <Label text="quiz créés"
                               style="-fx-font-size: 11px; -fx-text-fill: #888888;" />
                    </VBox>
                    <VBox spacing="4"
                          style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 16 20;
                                 -fx-border-color: #EEEEEE; -fx-border-radius: 10;" HBox.hgrow="ALWAYS">
                        <Label text="PROJETS"
                               style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #AAAAAA;" />
                        <Label fx:id="statsProjetsLabel" text="—"
                               style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #1A1A1A;" />
                        <Label text="projets soumis"
                               style="-fx-font-size: 11px; -fx-text-fill: #888888;" />
                    </VBox>
                </HBox>

                <!-- Raccourcis -->
                <VBox spacing="14">
                    <Label text="Accès rapide"
                           style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1A1A1A;" />

                    <GridPane hgap="16" vgap="16">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="33.33" />
                            <ColumnConstraints percentWidth="33.33" />
                            <ColumnConstraints percentWidth="33.33" />
                        </columnConstraints>

                        <VBox fx:id="coursCard" onMouseClicked="#handleCours" spacing="10"
                              style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20;
                                     -fx-cursor: hand; -fx-border-color: #EEEEEE; -fx-border-radius: 10;"
                              GridPane.columnIndex="0" GridPane.rowIndex="0">
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Label text="📚" style="-fx-font-size: 22px;" />
                                <Label text="Cours"
                                       style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1A1A1A;" />
                            </HBox>
                            <Label text="Gérer les cours disponibles sur la plateforme."
                                   style="-fx-font-size: 12px; -fx-text-fill: #888888; -fx-wrap-text: true;" />
                            <Label text="Ouvrir →"
                                   style="-fx-font-size: 12px; -fx-text-fill: #4CAF50; -fx-font-weight: bold;" />
                        </VBox>

                        <VBox fx:id="ressourcesCard" onMouseClicked="#handleRessources" spacing="10"
                              style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20;
                                     -fx-cursor: hand; -fx-border-color: #EEEEEE; -fx-border-radius: 10;"
                              GridPane.columnIndex="1" GridPane.rowIndex="0">
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Label text="📎" style="-fx-font-size: 22px;" />
                                <Label text="Ressources"
                                       style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1A1A1A;" />
                            </HBox>
                            <Label text="PDF, vidéos et templates pédagogiques."
                                   style="-fx-font-size: 12px; -fx-text-fill: #888888; -fx-wrap-text: true;" />
                            <Label text="Ouvrir →"
                                   style="-fx-font-size: 12px; -fx-text-fill: #4CAF50; -fx-font-weight: bold;" />
                        </VBox>

                        <VBox fx:id="questionsCard" onMouseClicked="#handleQuestions" spacing="10"
                              style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20;
                                     -fx-cursor: hand; -fx-border-color: #EEEEEE; -fx-border-radius: 10;"
                              GridPane.columnIndex="2" GridPane.rowIndex="0">
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Label text="❓" style="-fx-font-size: 22px;" />
                                <Label text="Quiz"
                                       style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1A1A1A;" />
                            </HBox>
                            <Label text="Créer et gérer les quiz interactifs."
                                   style="-fx-font-size: 12px; -fx-text-fill: #888888; -fx-wrap-text: true;" />
                            <Label text="Ouvrir →"
                                   style="-fx-font-size: 12px; -fx-text-fill: #4CAF50; -fx-font-weight: bold;" />
                        </VBox>

                        <VBox fx:id="projetsCard" onMouseClicked="#handleProjets" spacing="10"
                              style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20;
                                     -fx-cursor: hand; -fx-border-color: #EEEEEE; -fx-border-radius: 10;"
                              GridPane.columnIndex="0" GridPane.rowIndex="1">
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Label text="💼" style="-fx-font-size: 22px;" />
                                <Label text="Projets"
                                       style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1A1A1A;" />
                            </HBox>
                            <Label text="Suivre les portfolios et projets des apprenants."
                                   style="-fx-font-size: 12px; -fx-text-fill: #888888; -fx-wrap-text: true;" />
                            <Label text="Ouvrir →"
                                   style="-fx-font-size: 12px; -fx-text-fill: #4CAF50; -fx-font-weight: bold;" />
                        </VBox>

                        <VBox fx:id="evenementsCard" onMouseClicked="#handleEvenements" spacing="10"
                              style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20;
                                     -fx-cursor: hand; -fx-border-color: #EEEEEE; -fx-border-radius: 10;"
                              GridPane.columnIndex="1" GridPane.rowIndex="1">
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Label text="📅" style="-fx-font-size: 22px;" />
                                <Label text="Événements"
                                       style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1A1A1A;" />
                            </HBox>
                            <Label text="Webinaires et ateliers à venir."
                                   style="-fx-font-size: 12px; -fx-text-fill: #888888; -fx-wrap-text: true;" />
                            <Label text="Bientôt disponible"
                                   style="-fx-font-size: 12px; -fx-text-fill: #AAAAAA;" />
                        </VBox>

                        <VBox fx:id="utilisateursCard" onMouseClicked="#handleUtilisateurs" spacing="10"
                              style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20;
                                     -fx-cursor: hand; -fx-border-color: #EEEEEE; -fx-border-radius: 10;"
                              GridPane.columnIndex="2" GridPane.rowIndex="1">
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Label text="👥" style="-fx-font-size: 22px;" />
                                <Label text="Communauté"
                                       style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1A1A1A;" />
                            </HBox>
                            <Label text="Gérer les utilisateurs et formateurs."
                                   style="-fx-font-size: 12px; -fx-text-fill: #888888; -fx-wrap-text: true;" />
                            <Label text="Ouvrir →"
                                   style="-fx-font-size: 12px; -fx-text-fill: #4CAF50; -fx-font-weight: bold;" />
                        </VBox>
                    </GridPane>
                </VBox>

            </VBox>
        </ScrollPane>
    </VBox>
</HBox>
