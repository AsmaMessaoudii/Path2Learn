<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.controllers.EditUserController"
      alignment="CENTER"
      spacing="10"
      style="-fx-padding: 30;">

    <Label text="Modifier Profil" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <TextField fx:id="nomField" promptText="Nom"/>
    <TextField fx:id="prenomField" promptText="Prénom"/>
    <TextField fx:id="emailField" promptText="Email"/>
    <PasswordField fx:id="passwordField" promptText="Mot de passe"/>

    <Button text="Enregistrer"
            onAction="#handleSave"
            style="-fx-background-color: #4CAF50; -fx-text-fill: white;"/>
</VBox>
