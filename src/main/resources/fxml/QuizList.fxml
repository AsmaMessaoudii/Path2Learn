<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.controllers.QuizListController"
      style="-fx-background-color: #F5F5F5;"
      prefWidth="1200" prefHeight="800">

    <!-- HEADER FIXE -->
    <VBox style="-fx-background-color: white; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 10, 0, 0, 2);">
        <HBox alignment="CENTER_LEFT" spacing="30.0" style="-fx-padding: 15 40;">
            <ImageView fitWidth="150" fitHeight="150" preserveRatio="true">
                <Image url="/0c0390ea-b94e-4e66-bdee-dc1608f0674c.jpg" />
            </ImageView>
            <Region HBox.hgrow="ALWAYS" />
            <HBox spacing="25.0">
                <Button fx:id="homeBtn" onAction="#handleHome" text="Accueil"
                        style="-fx-background-color: transparent; -fx-text-fill: #555555; -fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 0 0 5 0;" />
                <Button fx:id="coursBtn" onAction="#handleCours" text="Cours"
                        style="-fx-background-color: transparent; -fx-text-fill: #555555; -fx-font-size: 13px; -fx-cursor: hand; -fx-padding: 0 0 5 0;" />
                <Button fx:id="ressourcesBtn" onAction="#handleRessources" text="Ressources"
                        style="-fx-background-color: transparent; -fx-text-fill: #555555; -fx-font-size: 13px; -fx-cursor: hand; -fx-padding: 0 0 5 0;" />
                <Button fx:id="questionsBtn" onAction="#handleQuestions" text="Quiz"
                        style="-fx-background-color: transparent; -fx-text-fill: #4CAF50; -fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 0 0 5 0; -fx-border-color: transparent transparent #4CAF50 transparent; -fx-border-width: 0 0 2 0;" />
                <Button fx:id="projetsBtn" onAction="#handleProjets" text="Projets"
                        style="-fx-background-color: transparent; -fx-text-fill: #555555; -fx-font-size: 13px; -fx-cursor: hand; -fx-padding: 0 0 5 0;" />
                <Button fx:id="evenementsBtn" onAction="#handleEvenements" text="Événements"
                        style="-fx-background-color: transparent; -fx-text-fill: #555555; -fx-font-size: 13px; -fx-cursor: hand; -fx-padding: 0 0 5 0;" />
                <Button fx:id="utilisateursBtn" onAction="#handleUtilisateurs" text="Communauté"
                        style="-fx-background-color: transparent; -fx-text-fill: #555555; -fx-font-size: 13px; -fx-cursor: hand; -fx-padding: 0 0 5 0;" />
            </HBox>
            <Region HBox.hgrow="ALWAYS" />
            <HBox spacing="12.0">
                <Button fx:id="loginBtn" onAction="#handleLogin" text="Se connecter"
                        style="-fx-background-color: transparent; -fx-text-fill: #4CAF50; -fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 6 18; -fx-border-color: #4CAF50; -fx-border-radius: 25; -fx-background-radius: 25;" />
                <Button fx:id="registerBtn" onAction="#handleRegister" text="S'inscrire"
                        style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 6 22; -fx-background-radius: 25;" />
                <Button fx:id="adminBtn" onAction="#handleGoToAdmin" text="⚙️ Administration"
                        style="-fx-background-color: #FF9800; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 5 15; -fx-background-radius: 20;"
                        visible="true" managed="true" />
            </HBox>
        </HBox>
    </VBox>

    <!-- HERO BAND -->
    <VBox style="-fx-background-color: #E8F5E9; -fx-padding: 28 50 22 50;" spacing="6">
        <Label text="❓ Quiz interactifs"
               style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #2E5C2E;"/>
        <Label text="Testez vos connaissances et suivez votre progression"
               style="-fx-font-size: 13px; -fx-text-fill: #666;"/>
    </VBox>

    <!-- STATS BAR -->
    <HBox style="-fx-background-color: white; -fx-padding: 10 50;
                 -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.04), 4, 0, 0, 1);">
        <Label fx:id="totalLabel" text="Chargement..."
               style="-fx-font-size: 13px; -fx-text-fill: #4CAF50; -fx-font-weight: bold;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="Cliquez sur « Commencer » pour répondre"
               style="-fx-font-size: 12px; -fx-text-fill: #aaa;"/>
    </HBox>

    <!-- CARDS AREA -->
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                style="-fx-background: #F5F5F5; -fx-background-color: #F5F5F5; -fx-border-width: 0;">
        <VBox style="-fx-background-color: #F5F5F5; -fx-padding: 28 50 40 50;">
            <FlowPane fx:id="quizCardsPane" hgap="20" vgap="20" style="-fx-background-color: transparent;"/>
            <VBox fx:id="emptyState" alignment="CENTER" spacing="14" style="-fx-padding: 80 0;" visible="false" managed="false">
                <Label text="📭" style="-fx-font-size: 58px;"/>
                <Label text="Aucun quiz disponible" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #aaa;"/>
                <Label text="Les quiz apparaîtront ici une fois créés." style="-fx-font-size: 13px; -fx-text-fill: #ccc;"/>
            </VBox>
        </VBox>
    </ScrollPane>
</VBox>