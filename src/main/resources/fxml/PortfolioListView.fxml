<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.controllers.PortfolioListController"
      style="-fx-background-color: #F5F5F5;">

    <!-- HEADER -->
    <VBox style="-fx-background-color: white; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 10, 0, 0, 2);">
        <HBox alignment="CENTER_LEFT" spacing="30.0" style="-fx-padding: 15 40;">
            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <Label text="🌿" style="-fx-font-size: 28px;" />
                <Label text="Path2Learn" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #81C784;" />
            </HBox>
            <Region HBox.hgrow="ALWAYS" />
            <HBox spacing="25.0">
                <Button fx:id="homeBtn" onAction="#handleHome" text="Accueil" style="-fx-background-color: transparent; -fx-text-fill: #555555; -fx-font-size: 13px; -fx-cursor: hand; -fx-padding: 0 0 5 0;" />
                <Button fx:id="coursBtn" onAction="#handleCours" text="Cours" style="-fx-background-color: transparent; -fx-text-fill: #555555; -fx-font-size: 13px; -fx-cursor: hand; -fx-padding: 0 0 5 0;" />
                <Button fx:id="ressourcesBtn" onAction="#handleRessources" text="Ressources" style="-fx-background-color: transparent; -fx-text-fill: #555555; -fx-font-size: 13px; -fx-cursor: hand; -fx-padding: 0 0 5 0;" />
                <Button fx:id="questionsBtn" onAction="#handleQuestions" text="Quiz" style="-fx-background-color: transparent; -fx-text-fill: #555555; -fx-font-size: 13px; -fx-cursor: hand; -fx-padding: 0 0 5 0;" />
                <Button fx:id="projetsBtn" onAction="#handleProjets" text="Projets" style="-fx-background-color: transparent; -fx-text-fill: #81C784; -fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 0 0 5 0; -fx-border-color: transparent transparent #81C784 transparent; -fx-border-width: 0 0 2 0;" />
                <Button fx:id="evenementsBtn" onAction="#handleEvenements" text="Événements" style="-fx-background-color: transparent; -fx-text-fill: #555555; -fx-font-size: 13px; -fx-cursor: hand; -fx-padding: 0 0 5 0;" />
                <Button fx:id="utilisateursBtn" onAction="#handleUtilisateurs" text="Communauté" style="-fx-background-color: transparent; -fx-text-fill: #555555; -fx-font-size: 13px; -fx-cursor: hand; -fx-padding: 0 0 5 0;" />
            </HBox>
            <Region HBox.hgrow="ALWAYS" />
            <HBox spacing="12.0">
                <Button text="Se connecter" style="-fx-background-color: transparent; -fx-text-fill: #81C784; -fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 6 18; -fx-border-color: #81C784; -fx-border-radius: 25; -fx-background-radius: 25;" />
                <Button text="S'inscrire" style="-fx-background-color: #81C784; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 6 22; -fx-background-radius: 25;" />
            </HBox>
        </HBox>
    </VBox>

    <!-- Contenu principal -->
    <VBox spacing="20.0" style="-fx-padding: 30 40;" VBox.vgrow="ALWAYS">

        <Label text="Gestion des Portfolios" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2E5C2E;"/>

        <!-- Barre d'outils -->
        <HBox spacing="15.0" alignment="CENTER_LEFT">
            <Button text="➕ Ajouter un portfolio" onAction="#handleAjouter"
                    style="-fx-background-color: #81C784; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 5; -fx-cursor: hand;"/>
            <Button text="✏️ Modifier" onAction="#handleModifier" fx:id="btnModifier"
                    style="-fx-background-color: #FFA726; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 5; -fx-cursor: hand;"/>
            <Button text="🗑️ Supprimer" onAction="#handleSupprimer" fx:id="btnSupprimer"
                    style="-fx-background-color: #EF5350; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 5; -fx-cursor: hand;"/>
            <Button text="📁 Voir les projets" onAction="#handleVoirProjets" fx:id="btnVoirProjets"
                    style="-fx-background-color: #42A5F5; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 5; -fx-cursor: hand;"/>
            <Button text="🔄 Actualiser" onAction="#handleActualiser"
                    style="-fx-background-color: #78909C; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 5; -fx-cursor: hand;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <TextField fx:id="searchField" promptText="Rechercher un portfolio..." prefWidth="250"
                       style="-fx-padding: 8; -fx-background-radius: 5;"/>
            <Button text="🔍" onAction="#handleRechercher"
                    style="-fx-background-color: #81C784; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15; -fx-background-radius: 5; -fx-cursor: hand;"/>
        </HBox>

        <Label fx:id="statusLabel" style="-fx-font-size: 12px;"/>

        <!-- Tableau -->
        <TableView fx:id="portfolioTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
                <TableColumn fx:id="colTitre" text="Titre" prefWidth="200"/>
                <TableColumn fx:id="colDescription" text="Description" prefWidth="300"/>
                <TableColumn fx:id="colDateCreation" text="Date création" prefWidth="120"/>
                <TableColumn fx:id="colDateMiseAjour" text="Mise à jour" prefWidth="120"/>
                <TableColumn fx:id="colUserId" text="User ID" prefWidth="80"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>

        <!-- Pagination -->
        <HBox alignment="CENTER" spacing="10.0">
            <Button text="◀ Précédent" onAction="#handlePrevious" style="-fx-cursor: hand;"/>
            <Label fx:id="pageLabel" text="Page 1 sur 1" style="-fx-font-size: 12px;"/>
            <Button text="Suivant ▶" onAction="#handleNext" style="-fx-cursor: hand;"/>
        </HBox>
    </VBox>
</VBox>