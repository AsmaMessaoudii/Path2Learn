<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.controllers.BadgeController"
      spacing="20.0"
      style="-fx-background-color: #F5F5F5;">

    <!-- HEADER -->
    <HBox alignment="CENTER_LEFT" spacing="20.0"
          style="-fx-background-color: white; -fx-padding: 20 40; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 10, 0, 0, 2);">
        <Label text="🏅" style="-fx-font-size: 28px;" />
        <Label text="Gestion des Badges"
               style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #81C784;" />
    </HBox>

    <!-- ACTION BUTTONS -->
    <HBox spacing="15.0" alignment="CENTER_LEFT"
          style="-fx-padding: 0 40;">

        <Button fx:id="addBadgeBtn"
                text="➕ Ajouter un badge"
                style="-fx-background-color: #81C784; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 8 18; -fx-background-radius: 25; -fx-cursor: hand;">
            <font>
                <Font name="System Bold" size="13"/>
            </font>
        </Button>

        <Button fx:id="backBtn"
                text="← Retour"
                onAction="#goBackToUsers"
                style="-fx-background-color: transparent; -fx-text-fill: #555; -fx-font-weight: bold; -fx-border-color: #555; -fx-border-radius: 25; -fx-background-radius: 25; -fx-padding: 8 18; -fx-cursor: hand;">
            <font>
                <Font name="System Bold" size="13"/>
            </font>
        </Button>
    </HBox>

    <!-- TABLE with editable property -->
    <TableView fx:id="badgeTable"
               VBox.vgrow="ALWAYS"
               prefHeight="500"
               editable="true"
               style="-fx-background-color: white; -fx-background-radius: 15; -fx-border-radius: 15; -fx-border-color: #e0e0e0; -fx-border-width: 1;">

        <!-- Style pour les colonnes -->
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>

        <columns>
            <TableColumn fx:id="idColumn" text="ID" prefWidth="60" editable="false" resizable="false"/>
            <TableColumn fx:id="nameColumn" text="Nom" prefWidth="150" editable="true"/>
            <TableColumn fx:id="descriptionColumn" text="Description" prefWidth="250" editable="true"/>
            <TableColumn fx:id="iconColumn" text="Icône" prefWidth="100" editable="true"
                         style="-fx-alignment: CENTER;"/>
            <TableColumn fx:id="requiredCoursesColumn" text="Cours requis" prefWidth="120" editable="true"
                         style="-fx-alignment: CENTER-RIGHT;"/>
            <TableColumn fx:id="actionsColumn" text="Actions" prefWidth="180" editable="false"
                         style="-fx-alignment: CENTER;"/>
        </columns>

        <!-- Style pour les lignes du tableau -->
        <style>
            .table-row-cell:odd {
            -fx-background-color: #f9f9f9;
            }
            .table-row-cell:selected {
            -fx-background-color: #81C784;
            -fx-text-fill: white;
            }
            .table-view .column-header {
            -fx-background-color: #e8f5e9;
            -fx-border-color: #c8e6c9;
            -fx-border-width: 0 0 1 0;
            }
            .table-view .column-header .label {
            -fx-font-weight: bold;
            -fx-text-fill: #2e7d32;
            }
        </style>
    </TableView>

    <!-- Barre de statut optionnelle -->
    <HBox spacing="10.0" alignment="CENTER_RIGHT"
          style="-fx-padding: 10 40 20 40;">
        <Label fx:id="statusLabel"
               style="-fx-font-size: 11px; -fx-text-fill: #666;">
            💡 Double-cliquez sur une cellule pour la modifier
        </Label>
    </HBox>

</VBox>