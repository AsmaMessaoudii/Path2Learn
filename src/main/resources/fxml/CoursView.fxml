<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.*?>

<HBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.controllers.CoursController"
      style="-fx-background-color: #F5F5F5;">

    <!-- ═══════════════════════════════════════════════════════ SIDEBAR -->
    <VBox style="-fx-background-color: white; -fx-border-color: #E0E0E0; -fx-border-width: 0 1 0 0;
                 -fx-min-width: 220; -fx-max-width: 220; -fx-pref-width: 220;"
          VBox.vgrow="ALWAYS">

        <!-- Logo -->
        <HBox alignment="CENTER_LEFT" spacing="10"
              style="-fx-padding: 20 16 16 16; -fx-border-color: #F0F0F0; -fx-border-width: 0 0 1 0;">
            <Label text="🌿" style="-fx-font-size: 22px;" />
            <Label text="Path2Learn"
                   style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #4CAF50;" />
        </HBox>

        <Label text="NAVIGATION"
               style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #AAAAAA; -fx-padding: 16 16 6 16;" />

        <Button fx:id="homeBtn" onAction="#handleHome" text="  Dashboard"
                style="-fx-background-color: transparent; -fx-text-fill: #555555; -fx-font-size: 13px;
                       -fx-alignment: CENTER_LEFT; -fx-cursor: hand; -fx-padding: 10 16;
                       -fx-background-radius: 0; -fx-max-width: Infinity;" />
        <!-- Cours = actif -->
        <Button fx:id="coursBtn" onAction="#handleCours" text="  Cours"
                style="-fx-background-color: #E8F5E9; -fx-text-fill: #2E7D32; -fx-font-size: 13px;
                       -fx-font-weight: bold; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;
                       -fx-padding: 10 16; -fx-background-radius: 0;
                       -fx-border-color: transparent #4CAF50 transparent transparent;
                       -fx-border-width: 0 3 0 0; -fx-max-width: Infinity;" />
        <Button fx:id="ressourcesBtn" onAction="#handleRessources" text="  Ressources"
                style="-fx-background-color: transparent; -fx-text-fill: #555555; -fx-font-size: 13px;
                       -fx-alignment: CENTER_LEFT; -fx-cursor: hand; -fx-padding: 10 16;
                       -fx-background-radius: 0; -fx-max-width: Infinity;" />
        <Button fx:id="questionsBtn" onAction="#handleQuestions" text="  Quiz"
                style="-fx-background-color: transparent; -fx-text-fill: #555555; -fx-font-size: 13px;
                       -fx-alignment: CENTER_LEFT; -fx-cursor: hand; -fx-padding: 10 16;
                       -fx-background-radius: 0; -fx-max-width: Infinity;" />
        <Button fx:id="projetsBtn" onAction="#handleProjets" text="  Projets"
                style="-fx-background-color: transparent; -fx-text-fill: #555555; -fx-font-size: 13px;
                       -fx-alignment: CENTER_LEFT; -fx-cursor: hand; -fx-padding: 10 16;
                       -fx-background-radius: 0; -fx-max-width: Infinity;" />

        <Label text="GESTION"
               style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #AAAAAA; -fx-padding: 16 16 6 16;" />

        <Button fx:id="evenementsBtn" onAction="#handleEvenements" text="  Événements"
                style="-fx-background-color: transparent; -fx-text-fill: #555555; -fx-font-size: 13px;
                       -fx-alignment: CENTER_LEFT; -fx-cursor: hand; -fx-padding: 10 16;
                       -fx-background-radius: 0; -fx-max-width: Infinity;" />
        <Button fx:id="utilisateursBtn" onAction="#handleUtilisateurs" text="  Communauté"
                style="-fx-background-color: transparent; -fx-text-fill: #555555; -fx-font-size: 13px;
                       -fx-alignment: CENTER_LEFT; -fx-cursor: hand; -fx-padding: 10 16;
                       -fx-background-radius: 0; -fx-max-width: Infinity;" />

        <Region VBox.vgrow="ALWAYS" />

        <HBox alignment="CENTER_LEFT" spacing="10"
              style="-fx-padding: 14 16; -fx-border-color: #F0F0F0; -fx-border-width: 1 0 0 0;">
            <Label text="AD"
                   style="-fx-background-color: #E8F5E9; -fx-text-fill: #2E7D32; -fx-font-size: 12px;
                          -fx-font-weight: bold; -fx-padding: 6 9; -fx-background-radius: 50;" />
            <VBox spacing="1">
                <Label text="Admin"
                       style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #333333;" />
                <Label text="Administrateur"
                       style="-fx-font-size: 11px; -fx-text-fill: #999999;" />
            </VBox>
        </HBox>
    </VBox>

    <!-- ═══════════════════════════════════════════════════════ MAIN -->
    <VBox HBox.hgrow="ALWAYS" style="-fx-background-color: #F5F5F5;">

        <!-- Topbar -->
        <HBox alignment="CENTER_LEFT" spacing="8"
              style="-fx-background-color: white; -fx-padding: 13 24;
                     -fx-border-color: #E0E0E0; -fx-border-width: 0 0 1 0;">
            <Label text="Dashboard" style="-fx-font-size: 12px; -fx-text-fill: #AAAAAA;" />
            <Label text="›" style="-fx-font-size: 12px; -fx-text-fill: #CCCCCC;" />
            <Label text="Cours" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #333333;" />
            <Region HBox.hgrow="ALWAYS" />
            <Button onAction="#handleActualiser" text="🔄  Actualiser"
                    style="-fx-background-color: white; -fx-text-fill: #555555; -fx-font-size: 12px;
                           -fx-padding: 7 16; -fx-background-radius: 7; -fx-cursor: hand;
                           -fx-border-color: #DDDDDD; -fx-border-radius: 7;" />
            <Button onAction="#handleAjouter" text="➕  Ajouter un cours"
                    style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-size: 12px;
                           -fx-font-weight: bold; -fx-padding: 7 18; -fx-background-radius: 7; -fx-cursor: hand;" />
        </HBox>

        <!-- Contenu scrollable -->
        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                    style="-fx-background: #F5F5F5; -fx-background-color: #F5F5F5; -fx-border-width: 0;">
            <VBox spacing="20" style="-fx-padding: 28 32;">

                <!-- En-tête -->
                <VBox spacing="4">
                    <Label text="Gestion des Cours"
                           style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1A1A1A;" />
                    <Label text="Créez, modifiez et gérez tous vos cours."
                           style="-fx-font-size: 13px; -fx-text-fill: #888888;" />
                </VBox>

                <!-- Barre de recherche + filtre -->
                <HBox spacing="12" alignment="CENTER_LEFT"
                      style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 16;
                             -fx-border-color: #EEEEEE; -fx-border-radius: 10;">
                    <Label text="🔍" style="-fx-font-size: 16px;" />
                    <TextField fx:id="searchField"
                               promptText="Rechercher par titre, niveau, matière ou description..."
                               style="-fx-padding: 8 12; -fx-background-radius: 7;
                                      -fx-border-color: #DDDDDD; -fx-border-radius: 7; -fx-font-size: 13px;"
                               HBox.hgrow="ALWAYS" />
                    <ComboBox fx:id="matiereFilterCombo" promptText="Toutes les matières"
                              prefWidth="180"
                              style="-fx-background-radius: 7; -fx-border-color: #DDDDDD;
                                     -fx-border-radius: 7; -fx-font-size: 13px;" />
                    <Button onAction="#handleRechercher" text="Rechercher"
                            style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-size: 13px;
                                   -fx-padding: 8 20; -fx-background-radius: 7; -fx-cursor: hand;" />
                    <Button onAction="#handleResetRecherche" text="Réinitialiser"
                            style="-fx-background-color: white; -fx-text-fill: #555555; -fx-font-size: 13px;
                                   -fx-padding: 8 16; -fx-background-radius: 7; -fx-cursor: hand;
                                   -fx-border-color: #DDDDDD; -fx-border-radius: 7;" />
                </HBox>

                <!-- TableView -->
                <VBox style="-fx-background-color: white; -fx-background-radius: 10;
                             -fx-border-color: #EEEEEE; -fx-border-radius: 10;" VBox.vgrow="ALWAYS">
                    <TableView fx:id="tableView" VBox.vgrow="ALWAYS"
                               style="-fx-background-color: transparent; -fx-border-width: 0;">
                        <columns>
                            <TableColumn fx:id="colId"          text="ID"           prefWidth="55" />
                            <TableColumn fx:id="colTitre"       text="Titre"        prefWidth="200" />
                            <TableColumn fx:id="colDescription" text="Description"  prefWidth="240" />
                            <TableColumn fx:id="colNiveau"      text="Niveau"       prefWidth="100" />
                            <TableColumn fx:id="colMatiere"     text="Matière"      prefWidth="120" />
                            <TableColumn fx:id="colDuree"       text="Durée (h)"    prefWidth="80" />
                            <TableColumn fx:id="colDate"        text="Date création" prefWidth="120" />
                            <TableColumn fx:id="colStatut"      text="Statut"       prefWidth="100" />
                            <TableColumn fx:id="colActions"     text="Actions"      prefWidth="160" />
                        </columns>
                        <placeholder>
                            <Label text="Aucun cours trouvé"
                                   style="-fx-font-size: 13px; -fx-text-fill: #AAAAAA;" />
                        </placeholder>
                    </TableView>
                </VBox>

                <HBox alignment="CENTER_RIGHT">
                    <Label fx:id="statsLabel" text="0 cours au total"
                           style="-fx-font-size: 12px; -fx-text-fill: #AAAAAA;" />
                </HBox>

            </VBox>
        </ScrollPane>
    </VBox>
</HBox>
