<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.path2learn.controllers.CoursController">

    <top>
        <VBox spacing="10.0" styleClass="entity-header">
            <padding>
                <Insets bottom="20.0" left="30.0" right="30.0" top="20.0" />
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="15.0">
                <Label styleClass="entity-icon" text="📖" />
                <Label styleClass="entity-title" text="Gestion des Cours" />
            </HBox>

            <Separator />

            <HBox alignment="CENTER_RIGHT" spacing="15.0">
                <Button onAction="#handleAdd" styleClass="action-button-primary" text="➕ Ajouter">
                    <graphic>
                        <Label text="+" />
                    </graphic>
                </Button>
                <Button onAction="#handleEdit" styleClass="action-button" text="✏️ Modifier" />
                <Button onAction="#handleDelete" styleClass="action-button-danger" text="🗑️ Supprimer" />
                <Button onAction="#handleRefresh" styleClass="action-button" text="🔄 Actualiser" />
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox spacing="15.0" styleClass="entity-content">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>

            <!-- Barre de recherche -->
            <HBox spacing="10.0" styleClass="search-bar">
                <TextField fx:id="searchField" promptText="Rechercher..." styleClass="search-field" HBox.hgrow="ALWAYS" />
                <Button onAction="#handleSearch" styleClass="search-button" text="🔍 Rechercher" />
            </HBox>

            <!-- TableView pour afficher les données -->
            <TableView fx:id="dataTable" styleClass="data-table" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn text="ID" prefWidth="50" />
                    <TableColumn text="Titre" prefWidth="200" />
                    <TableColumn text="Description" prefWidth="300" />
                    <TableColumn text="Date" prefWidth="150" />
                    <TableColumn text="Statut" prefWidth="100" />
                </columns>
                <placeholder>
                    <Label text="Aucune donnée à afficher" />
                </placeholder>
            </TableView>

            <!-- Pagination -->
            <HBox alignment="CENTER" spacing="10.0">
                <Button onAction="#handlePreviousPage" styleClass="pagination-button" text="◀ Précédent" />
                <Label fx:id="pageInfo" styleClass="page-info" text="Page 1 sur 1" />
                <Button onAction="#handleNextPage" styleClass="pagination-button" text="Suivant ▶" />
            </HBox>
        </VBox>
    </center>

</BorderPane>