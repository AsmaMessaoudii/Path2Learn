<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controllers.CoursController" style="-fx-background-color: #F5F5F5;">

    <!-- HEADER FIXE AVEC NAVIGATION -->
    <VBox style="-fx-background-color: white; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 10, 0, 0, 2);">
        <HBox alignment="CENTER_LEFT" spacing="30.0" style="-fx-padding: 15 40;">

            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <Label text="🌿" style="-fx-font-size: 28px;" />
                <Label text="Path2Learn" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #81C784;" />
            </HBox>

            <Region HBox.hgrow="ALWAYS" />

            <HBox spacing="25.0">
                <Button fx:id="homeBtn" onAction="#handleHome" text="Accueil" style="-fx-background-color: transparent; -fx-text-fill: #555555; -fx-font-size: 13px; -fx-cursor: hand; -fx-padding: 0 0 5 0;" />
                <Button fx:id="coursBtn" onAction="#handleCours" text="Cours" style="-fx-background-color: transparent; -fx-text-fill: #81C784; -fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 0 0 5 0; -fx-border-color: transparent transparent #81C784 transparent; -fx-border-width: 0 0 2 0;" />
                <Button fx:id="ressourcesBtn" onAction="#handleRessources" text="Ressources" style="-fx-background-color: transparent; -fx-text-fill: #555555; -fx-font-size: 13px; -fx-cursor: hand; -fx-padding: 0 0 5 0;" />
                <Button fx:id="questionsBtn" onAction="#handleQuestions" text="Quiz" style="-fx-background-color: transparent; -fx-text-fill: #555555; -fx-font-size: 13px; -fx-cursor: hand; -fx-padding: 0 0 5 0;" />
                <Button fx:id="projetsBtn" onAction="#handleProjets" text="Projets" style="-fx-background-color: transparent; -fx-text-fill: #555555; -fx-font-size: 13px; -fx-cursor: hand; -fx-padding: 0 0 5 0;" />
                <Button fx:id="evenementsBtn" onAction="#handleEvenements" text="Événements" style="-fx-background-color: transparent; -fx-text-fill: #555555; -fx-font-size: 13px; -fx-cursor: hand; -fx-padding: 0 0 5 0;" />
                <Button fx:id="utilisateursBtn" onAction="#handleUtilisateurs" text="Communauté" style="-fx-background-color: transparent; -fx-text-fill: #555555; -fx-font-size: 13px; -fx-cursor: hand; -fx-padding: 0 0 5 0;" />
            </HBox>

            <Region HBox.hgrow="ALWAYS" />

            <HBox spacing="12.0">
                <Button text="Se connecter" style="-fx-background-color: transparent; -fx-text-fill: #81C784; -fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 6 18; -fx-border-color: #81C784; -fx-border-radius: 25; -fx-background-radius: 25;" />
                <Button text="S'inscrire" style="-fx-background-color: #81C784; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 6 22; -fx-background-radius: 25;" />
            </HBox>
        </HBox>
    </VBox>

    <!-- CONTENU DE LA PAGE COURS (SCROLLABLE) -->
    <ScrollPane fitToWidth="true" fitToHeight="true" style="-fx-background: #F5F5F5; -fx-background-color: #F5F5F5; -fx-border-width: 0;" VBox.vgrow="ALWAYS">
        <VBox spacing="20.0" style="-fx-background-color: #F5F5F5; -fx-padding: 30 40;">

            <!-- Titre de la page -->
            <Label text="📚 Gestion des Cours" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2E5C2E;" />
            <Label text="Créez, modifiez et gérez tous vos cours" style="-fx-font-size: 14px; -fx-text-fill: #666666; -fx-padding: 0 0 10 0;" />

            <!-- Filtre par matière -->
            <HBox spacing="15.0" alignment="CENTER_LEFT">
                <Label text="Filtrer par matière :" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #555555;" />
                <ComboBox fx:id="matiereFilterCombo" prefWidth="200" style="-fx-background-radius: 8; -fx-border-color: #DDDDDD; -fx-border-radius: 8;" />
                <Region HBox.hgrow="ALWAYS" />
            </HBox>

            <!-- Boutons d'action -->
            <HBox spacing="15.0">
                <Button onAction="#handleAjouter" style="-fx-background-color: #81C784; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 8; -fx-cursor: hand;">
                    <graphic><Label text="➕" /></graphic>
                    <text>Ajouter un cours</text>
                </Button>
                <Button onAction="#handleActualiser" style="-fx-background-color: #F5F5F5; -fx-text-fill: #555555; -fx-font-size: 13px; -fx-padding: 10 20; -fx-background-radius: 8; -fx-cursor: hand; -fx-border-color: #DDDDDD; -fx-border-radius: 8;">
                    <graphic><Label text="🔄" /></graphic>
                    <text>Actualiser</text>
                </Button>
                <Region HBox.hgrow="ALWAYS" />
            </HBox>

            <!-- Barre de recherche -->
            <HBox spacing="15.0" alignment="CENTER_LEFT">
                <Label text="🔍" style="-fx-font-size: 18px;" />
                <TextField fx:id="searchField" promptText="Rechercher par titre, niveau, matière ou description..." style="-fx-padding: 10 15; -fx-background-radius: 8; -fx-border-color: #DDDDDD; -fx-border-radius: 8;" HBox.hgrow="ALWAYS" />
                <Button onAction="#handleRechercher" text="Rechercher" style="-fx-background-color: #81C784; -fx-text-fill: white; -fx-font-size: 13px; -fx-padding: 10 25; -fx-background-radius: 8; -fx-cursor: hand;" />
                <Button onAction="#handleResetRecherche" text="Reset" style="-fx-background-color: #F5F5F5; -fx-text-fill: #555555; -fx-font-size: 13px; -fx-padding: 10 20; -fx-background-radius: 8; -fx-cursor: hand; -fx-border-color: #DDDDDD; -fx-border-radius: 8;" />
            </HBox>

            <!-- TableView avec scrolling automatique -->
            <TableView fx:id="tableView" VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 2);">
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="50" />
                    <TableColumn fx:id="colTitre" text="Titre" prefWidth="200" />
                    <TableColumn fx:id="colDescription" text="Description" prefWidth="250" />
                    <TableColumn fx:id="colNiveau" text="Niveau" prefWidth="100" />
                    <TableColumn fx:id="colMatiere" text="Matière" prefWidth="120" />
                    <TableColumn fx:id="colDuree" text="Durée (h)" prefWidth="80" />
                    <TableColumn fx:id="colDate" text="Date création" prefWidth="120" />
                    <TableColumn fx:id="colStatut" text="Statut" prefWidth="100" />
                    <TableColumn fx:id="colActions" text="Actions" prefWidth="160" />
                </columns>
                <placeholder>
                    <Label text="Aucun cours trouvé" style="-fx-font-size: 14px; -fx-text-fill: #999999;" />
                </placeholder>
            </TableView>

            <!-- Statistiques -->
            <HBox alignment="CENTER_RIGHT">
                <Label fx:id="statsLabel" text="0 cours au total" style="-fx-font-size: 12px; -fx-text-fill: #666666;" />
            </HBox>
        </VBox>
    </ScrollPane>
</VBox>