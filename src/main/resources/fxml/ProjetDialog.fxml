<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.controllers.ProjetDialogController"
      prefWidth="520"
      style="-fx-background-color: #F8FFF8;">
    <padding>
        <Insets bottom="0" left="0" right="0" top="0" />
    </padding>

    <!-- Header band -->
    <VBox style="-fx-background-color: #1565C0; -fx-padding: 25 30 20 30;" spacing="5">
        <Label text="🚀" style="-fx-font-size: 32px;"/>
        <Label fx:id="dialogTitle" text="Ajouter un projet"
               style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: white;"/>
        <Label text="Décrivez votre projet en détail"
               style="-fx-font-size: 12px; -fx-text-fill: #90CAF9;"/>
    </VBox>

    <!-- Form in ScrollPane -->
    <ScrollPane fitToWidth="true"
                style="-fx-background: #F8FFF8; -fx-background-color: #F8FFF8; -fx-border-width: 0;">
        <VBox spacing="18" style="-fx-padding: 25 30;">

            <!-- Row 1: Titre + Text -->
            <HBox spacing="15">
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="📌  Titre du projet *"
                           style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #1565C0;"/>
                    <TextField fx:id="titreField" promptText="Nom du projet..."
                               style="-fx-padding: 10; -fx-background-radius: 10;
                                      -fx-border-color: #E0E0E0; -fx-border-radius: 10;
                                      -fx-font-size: 13px; -fx-background-color: white;"/>
                    <Label fx:id="titreError"
                           style="-fx-text-fill: #f44336; -fx-font-size: 11px;"/>
                </VBox>
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="💬  Texte court"
                           style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #1565C0;"/>
                    <TextField fx:id="textField" promptText="Une ligne de description..."
                               style="-fx-padding: 10; -fx-background-radius: 10;
                                      -fx-border-color: #E0E0E0; -fx-border-radius: 10;
                                      -fx-font-size: 13px; -fx-background-color: white;"/>
                </VBox>
            </HBox>

            <!-- Description -->
            <VBox spacing="6">
                <Label text="📝  Description *"
                       style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #1565C0;"/>
                <TextArea fx:id="descriptionArea"
                          promptText="Décrivez votre projet en détail..."
                          prefHeight="90" wrapText="true"
                          style="-fx-padding: 10; -fx-background-radius: 10;
                                 -fx-border-color: #E0E0E0; -fx-border-radius: 10;
                                 -fx-font-size: 13px; -fx-background-color: white;"/>
                <Label fx:id="descriptionError"
                       style="-fx-text-fill: #f44336; -fx-font-size: 11px;"/>
            </VBox>

            <!-- Row 2: Technologies + Date -->
            <HBox spacing="15">
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="🛠️  Technologies"
                           style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #1565C0;"/>
                    <TextField fx:id="technologiesField" promptText="Java, JavaFX, MySQL..."
                               style="-fx-padding: 10; -fx-background-radius: 10;
                                      -fx-border-color: #E0E0E0; -fx-border-radius: 10;
                                      -fx-font-size: 13px; -fx-background-color: white;"/>
                </VBox>
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="📅  Date de réalisation *"
                           style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #1565C0;"/>
                    <DatePicker fx:id="dateRealisationPicker"
                                style="-fx-background-color: white; -fx-background-radius: 10;
                                       -fx-border-color: #E0E0E0; -fx-border-radius: 10;"/>
                    <Label fx:id="dateError"
                           style="-fx-text-fill: #f44336; -fx-font-size: 11px;"/>
                </VBox>
            </HBox>

            <!-- Lien démo -->
            <VBox spacing="6">
                <Label text="🔗  Lien démo"
                       style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #1565C0;"/>
                <TextField fx:id="lienDemoField" promptText="https://github.com/..."
                           style="-fx-padding: 10; -fx-background-radius: 10;
                                  -fx-border-color: #E0E0E0; -fx-border-radius: 10;
                                  -fx-font-size: 13px; -fx-background-color: white;"/>
                <Label fx:id="lienDemoError"
                       style="-fx-text-fill: #f44336; -fx-font-size: 11px;"/>
            </VBox>

            <!-- Buttons -->
            <HBox spacing="12" alignment="CENTER_RIGHT" style="-fx-padding: 10 0 0 0;">
                <Button onAction="#handleAnnuler" text="Annuler"
                        style="-fx-background-color: transparent; -fx-text-fill: #888888;
                               -fx-font-size: 13px; -fx-padding: 10 25;
                               -fx-border-color: #DDDDDD; -fx-border-radius: 25;
                               -fx-background-radius: 25; -fx-cursor: hand;"/>
                <Button fx:id="saveButton" onAction="#handleSauvegarder" text="✅  Sauvegarder"
                        style="-fx-background-color: #1565C0; -fx-text-fill: white;
                               -fx-font-weight: bold; -fx-font-size: 13px;
                               -fx-padding: 10 30; -fx-background-radius: 25; -fx-cursor: hand;"/>
            </HBox>
        </VBox>
    </ScrollPane>
</VBox>