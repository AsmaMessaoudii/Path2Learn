<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.controllers.ProjetDialogController"
      style="-fx-background-color: white; -fx-background-radius: 10;">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label fx:id="dialogTitle" text="Ajouter un projet"
           style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2E5C2E;" />
    <Separator />

    <GridPane hgap="15.0" vgap="12.0">
        <columnConstraints>
            <ColumnConstraints percentWidth="30" />
            <ColumnConstraints percentWidth="70" />
        </columnConstraints>

        <!-- Titre -->
        <Label text="Titre : *" style="-fx-font-weight: bold;"
               GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <VBox GridPane.columnIndex="1" GridPane.rowIndex="0">
            <TextField fx:id="titreField" promptText="Entrez le titre (minimum 3 caractères)" />
            <Label fx:id="titreError" style="-fx-text-fill: #f44336; -fx-font-size: 11px;" />
        </VBox>

        <!-- Texte -->
        <Label text="Texte :" style="-fx-font-weight: bold;"
               GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <TextField fx:id="textField" promptText="Texte court du projet"
                   GridPane.columnIndex="1" GridPane.rowIndex="1" />

        <!-- Description -->
        <Label text="Description : *" style="-fx-font-weight: bold;"
               GridPane.columnIndex="0" GridPane.rowIndex="2" />
        <VBox GridPane.columnIndex="1" GridPane.rowIndex="2">
            <TextArea fx:id="descriptionArea"
                      promptText="Entrez la description (minimum 10 caractères)"
                      prefHeight="80" wrapText="true" />
            <Label fx:id="descriptionError" style="-fx-text-fill: #f44336; -fx-font-size: 11px;" />
        </VBox>

        <!-- Technologies -->
        <Label text="Technologies :" style="-fx-font-weight: bold;"
               GridPane.columnIndex="0" GridPane.rowIndex="3" />
        <TextField fx:id="technologiesField" promptText="ex: Java, JavaFX, MySQL"
                   GridPane.columnIndex="1" GridPane.rowIndex="3" />

        <!-- Date réalisation -->
        <Label text="Date réalisation : *" style="-fx-font-weight: bold;"
               GridPane.columnIndex="0" GridPane.rowIndex="4" />
        <VBox GridPane.columnIndex="1" GridPane.rowIndex="4">
            <DatePicker fx:id="dateRealisationPicker" />
            <Label fx:id="dateError" style="-fx-text-fill: #f44336; -fx-font-size: 11px;" />
        </VBox>

        <!-- Lien démo -->
        <Label text="Lien démo :" style="-fx-font-weight: bold;"
               GridPane.columnIndex="0" GridPane.rowIndex="5" />
        <TextField fx:id="lienDemoField" promptText="https://..."
                   GridPane.columnIndex="1" GridPane.rowIndex="5" />

    </GridPane>

    <Separator />

    <HBox spacing="15.0" alignment="CENTER_RIGHT">
        <Button onAction="#handleAnnuler" text="Annuler"
                style="-fx-background-color: #F5F5F5; -fx-text-fill: #555555; -fx-padding: 10 25; -fx-background-radius: 8; -fx-cursor: hand;" />
        <Button fx:id="saveButton" onAction="#handleSauvegarder" text="Sauvegarder"
                style="-fx-background-color: #81C784; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 25; -fx-background-radius: 8; -fx-cursor: hand;" />
    </HBox>
</VBox>