<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.controllers.CoursListFrontController"
      style="-fx-background-color: #F5F5F5;"
      prefWidth="1200" prefHeight="800">

    <!-- HEADER FIXE -->
    <VBox style="-fx-background-color: white; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 10, 0, 0, 2);">
        <HBox alignment="CENTER_LEFT" spacing="30.0" style="-fx-padding: 15 40;">
            <!-- Logo -->
            <ImageView fitWidth="150" fitHeight="150" preserveRatio="true">
                <Image url="/0c0390ea-b94e-4e66-bdee-dc1608f0674c.jpg" />
            </ImageView>
            <Region HBox.hgrow="ALWAYS" />

            <!-- Liens -->
            <HBox spacing="25.0" alignment="CENTER">
                <Button fx:id="homeBtn" onAction="#handleHome" text="Accueil"
                        style="-fx-background-color: transparent; -fx-text-fill: #555555; -fx-font-size: 13px; -fx-cursor: hand; -fx-padding: 0 0 5 0;" />
                <Button fx:id="coursBtn" onAction="#handleCours" text="Cours"
                        style="-fx-background-color: transparent; -fx-text-fill: #4CAF50; -fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 0 0 5 0; -fx-border-color: transparent transparent #4CAF50 transparent; -fx-border-width: 0 0 2 0;" />
                <Button fx:id="ressourcesBtn" onAction="#handleRessources" text="Ressources"
                        style="-fx-background-color: transparent; -fx-text-fill: #555555; -fx-font-size: 13px; -fx-cursor: hand; -fx-padding: 0 0 5 0;" />
                <Button fx:id="questionsBtn" onAction="#handleQuestions" text="Quiz"
                        style="-fx-background-color: transparent; -fx-text-fill: #555555; -fx-font-size: 13px; -fx-cursor: hand; -fx-padding: 0 0 5 0;" />
                <Button fx:id="projetsBtn" onAction="#handleProjets" text="Projets"
                        style="-fx-background-color: transparent; -fx-text-fill: #555555; -fx-font-size: 13px; -fx-cursor: hand; -fx-padding: 0 0 5 0;" />
                <Button fx:id="evenementsBtn" onAction="#handleEvenements" text="Événements"
                        style="-fx-background-color: transparent; -fx-text-fill: #555555; -fx-font-size: 13px; -fx-cursor: hand; -fx-padding: 0 0 5 0;" />
                <Button fx:id="utilisateursBtn" onAction="#handleUtilisateurs" text="Communauté"
                        style="-fx-background-color: transparent; -fx-text-fill: #555555; -fx-font-size: 13px; -fx-cursor: hand; -fx-padding: 0 0 5 0;" />
            </HBox>

            <Region HBox.hgrow="ALWAYS" />

            <!-- Auth Buttons -->
            <HBox spacing="12.0" alignment="CENTER">
                <Button text="Se connecter"
                        style="-fx-background-color: transparent; -fx-text-fill: #4CAF50; -fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 6 18; -fx-border-color: #4CAF50; -fx-border-radius: 25; -fx-background-radius: 25;" />
                <Button text="S'inscrire"
                        style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 6 22; -fx-background-radius: 25;" />
            </HBox>
        </HBox>
    </VBox>

    <!-- ===== CONTENU PRINCIPAL ===== -->
    <VBox VBox.vgrow="ALWAYS" style="-fx-background-color: #F5F5F5;">

        <!-- Topbar -->
        <HBox style="-fx-background-color: white; -fx-padding: 18 30; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 5, 0, 0, 2);" alignment="CENTER_LEFT" spacing="12">
            <Label text="📚 Nos Cours" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2E5C2E;" />
            <Label fx:id="statsLabel" text="(0 cours)" style="-fx-font-size: 13px; -fx-text-fill: #999999;" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="userLabel" text="👤 Étudiant" style="-fx-font-size: 12px; -fx-text-fill: #666666; -fx-background-color: #F0F0F0; -fx-padding: 5 12; -fx-background-radius: 20;" />
        </HBox>

        <ScrollPane fitToWidth="true" style="-fx-background: #F5F5F5; -fx-background-color: #F5F5F5; -fx-border-width: 0;" VBox.vgrow="ALWAYS">
            <VBox spacing="20.0" style="-fx-padding: 28 36;">

                <!-- Barre de recherche + filtres -->
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <HBox style="-fx-background-color: white; -fx-background-radius: 25; -fx-border-color: #E0E0E0; -fx-border-radius: 25; -fx-padding: 0 15;" alignment="CENTER_LEFT" spacing="8" HBox.hgrow="ALWAYS">
                        <Label text="🔍" style="-fx-font-size: 14px;" />
                        <TextField fx:id="searchField" promptText="Rechercher un cours par titre, matière, niveau..."
                                   style="-fx-background-color: transparent; -fx-border-width: 0; -fx-font-size: 13px; -fx-padding: 9 0;"
                                   HBox.hgrow="ALWAYS" />
                    </HBox>
                    <ComboBox fx:id="niveauFilter" promptText="Niveau" prefWidth="130"
                              style="-fx-background-radius: 20; -fx-border-color: #E0E0E0; -fx-border-radius: 20; -fx-font-size: 12px;" />
                    <ComboBox fx:id="matiereFilter" promptText="Matière" prefWidth="150"
                              style="-fx-background-radius: 20; -fx-border-color: #E0E0E0; -fx-border-radius: 20; -fx-font-size: 12px;" />
                    <Button text="Réinitialiser" onAction="#handleReset"
                            style="-fx-background-color: #F5F5F5; -fx-text-fill: #666; -fx-font-size: 12px; -fx-padding: 8 16; -fx-background-radius: 20; -fx-border-color: #E0E0E0; -fx-border-radius: 20; -fx-cursor: hand;" />
                </HBox>

                <!-- Chips de filtre rapide -->
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="Filtre rapide :" style="-fx-font-size: 12px; -fx-text-fill: #888;" />
                    <Button text="Tous"          onAction="#filterTous"        fx:id="chipTous"         style="-fx-background-color: #66BB6A; -fx-text-fill: white; -fx-font-size: 11px; -fx-padding: 4 14; -fx-background-radius: 20; -fx-cursor: hand;" />
                    <Button text="✅ Publiés"     onAction="#filterPublies"     fx:id="chipPublies"      style="-fx-background-color: #E8F5E9; -fx-text-fill: #2E7D32; -fx-font-size: 11px; -fx-padding: 4 14; -fx-background-radius: 20; -fx-cursor: hand;" />
                    <Button text="📝 Brouillons"  onAction="#filterBrouillons"  fx:id="chipBrouillons"   style="-fx-background-color: #FFF3E0; -fx-text-fill: #E65100; -fx-font-size: 11px; -fx-padding: 4 14; -fx-background-radius: 20; -fx-cursor: hand;" />
                    <Button text="🟢 Débutant"    onAction="#filterDebutant"    fx:id="chipDebutant"     style="-fx-background-color: #F5F5F5; -fx-text-fill: #555; -fx-font-size: 11px; -fx-padding: 4 14; -fx-background-radius: 20; -fx-border-color: #DDD; -fx-cursor: hand;" />
                    <Button text="🟡 Intermédiaire" onAction="#filterIntermediaire" fx:id="chipIntermediaire" style="-fx-background-color: #F5F5F5; -fx-text-fill: #555; -fx-font-size: 11px; -fx-padding: 4 14; -fx-background-radius: 20; -fx-border-color: #DDD; -fx-cursor: hand;" />
                    <Button text="🔴 Avancé"      onAction="#filterAvance"      fx:id="chipAvance"       style="-fx-background-color: #F5F5F5; -fx-text-fill: #555; -fx-font-size: 11px; -fx-padding: 4 14; -fx-background-radius: 20; -fx-border-color: #DDD; -fx-cursor: hand;" />
                </HBox>

                <!-- Grille de cartes dynamique -->
                <FlowPane fx:id="coursFlowPane" hgap="16" vgap="16" prefWrapLength="9999" />

                <!-- Message vide -->
                <VBox fx:id="emptyState" alignment="CENTER" spacing="10" style="-fx-padding: 60 0;" visible="false" managed="false">
                    <Label text="🔍" style="-fx-font-size: 40px;" />
                    <Label text="Aucun cours trouvé" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #999;" />
                    <Label text="Essayez de modifier vos filtres de recherche" style="-fx-font-size: 13px; -fx-text-fill: #BBB;" />
                </VBox>

            </VBox>
        </ScrollPane>
    </VBox>
</VBox>