<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controllers.CoursDialogController" style="-fx-background-color: white; -fx-background-radius: 10;">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label fx:id="dialogTitle" text="Ajouter un cours" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2E5C2E;" />
    <Separator />

    <GridPane hgap="15.0" vgap="12.0">
        <columnConstraints>
            <ColumnConstraints percentWidth="30" />
            <ColumnConstraints percentWidth="70" />
        </columnConstraints>

        <!-- Titre -->
        <Label text="Titre : *" style="-fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <VBox GridPane.columnIndex="1" GridPane.rowIndex="0">
            <TextField fx:id="titreField" promptText="Entrez le titre (minimum 3 caractères)" />
            <Label fx:id="titreError" style="-fx-text-fill: #f44336; -fx-font-size: 11px;" />
        </VBox>

        <!-- Description -->
        <Label text="Description : *" style="-fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <VBox GridPane.columnIndex="1" GridPane.rowIndex="1">
            <TextArea fx:id="descriptionArea" promptText="Entrez la description (minimum 10 caractères)" prefHeight="80" wrapText="true" />
            <Label fx:id="descriptionError" style="-fx-text-fill: #f44336; -fx-font-size: 11px;" />
        </VBox>

        <!-- Niveau -->
        <Label text="Niveau : *" style="-fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="2" />
        <VBox GridPane.columnIndex="1" GridPane.rowIndex="2">
            <ComboBox fx:id="niveauCombo" prefWidth="200" promptText="Sélectionnez le niveau" />
            <Label fx:id="niveauError" style="-fx-text-fill: #f44336; -fx-font-size: 11px;" />
        </VBox>

        <!-- Matière -->
        <Label text="Matière : *" style="-fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="3" />
        <VBox GridPane.columnIndex="1" GridPane.rowIndex="3">
            <TextField fx:id="matiereField" promptText="Entrez la matière" />
            <Label fx:id="matiereError" style="-fx-text-fill: #f44336; -fx-font-size: 11px;" />
        </VBox>

        <!-- Email Professeur -->
        <Label text="Email Professeur : *" style="-fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="4" />
        <VBox GridPane.columnIndex="1" GridPane.rowIndex="4">
            <TextField fx:id="emailProfField" promptText="exemple@email.com" />
            <Label fx:id="emailProfError" style="-fx-text-fill: #f44336; -fx-font-size: 11px;" />
        </VBox>

        <!-- Durée -->
        <Label text="Durée (heures) : *" style="-fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="5" />
        <VBox GridPane.columnIndex="1" GridPane.rowIndex="5">
            <TextField fx:id="dureeField" promptText="Entrez la durée en heures (nombre positif)" />
            <Label fx:id="dureeError" style="-fx-text-fill: #f44336; -fx-font-size: 11px;" />
        </VBox>

        <!-- Statut -->
        <Label text="Statut : *" style="-fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="6" />
        <VBox GridPane.columnIndex="1" GridPane.rowIndex="6">
            <ComboBox fx:id="statutCombo" prefWidth="200" promptText="Sélectionnez le statut" />
            <Label fx:id="statutError" style="-fx-text-fill: #f44336; -fx-font-size: 11px;" />
        </VBox>

    </GridPane>

    <Separator />

    <HBox spacing="15.0" alignment="CENTER_RIGHT">
        <Button onAction="#handleAnnuler" text="Annuler" style="-fx-background-color: #F5F5F5; -fx-text-fill: #555555; -fx-padding: 10 25; -fx-background-radius: 8; -fx-cursor: hand;" />
        <Button fx:id="saveButton" onAction="#handleSauvegarder" text="Sauvegarder" style="-fx-background-color: #81C784; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 25; -fx-background-radius: 8; -fx-cursor: hand;" />
    </HBox>
</VBox>