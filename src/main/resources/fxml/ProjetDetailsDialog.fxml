<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.controllers.ProjetDetailsController"
      prefWidth="550"
      style="-fx-background-color: #F0F4FF;">

    <!-- Header band -->
    <VBox style="-fx-background-color: #1565C0; -fx-padding: 25 30 20 30;" spacing="5">
        <Label text="🚀" style="-fx-font-size: 32px;"/>
        <Label text="Détails du projet"
               style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: white;"/>
        <Label fx:id="labelTitre"
               style="-fx-font-size: 13px; -fx-text-fill: #90CAF9;"/>
    </VBox>

    <!-- Content -->
    <VBox spacing="15" style="-fx-padding: 25 30;">

        <!-- Row: Text -->
        <VBox spacing="4"
              style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15;">
            <Label text="💬  Texte"
                   style="-fx-font-size: 11px; -fx-text-fill: #999999; -fx-font-weight: bold;"/>
            <Label fx:id="labelText"
                   style="-fx-font-size: 13px; -fx-text-fill: #333333; -fx-wrap-text: true;"/>
        </VBox>

        <!-- Row: Description -->
        <VBox spacing="4"
              style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15;">
            <Label text="📝  Description"
                   style="-fx-font-size: 11px; -fx-text-fill: #999999; -fx-font-weight: bold;"/>
            <Label fx:id="labelDescription"
                   style="-fx-font-size: 13px; -fx-text-fill: #333333; -fx-wrap-text: true;"
                   maxWidth="460"/>
        </VBox>

        <!-- Row: Technologies -->
        <HBox spacing="15" alignment="CENTER_LEFT"
              style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15;">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="🛠️  Technologies"
                       style="-fx-font-size: 11px; -fx-text-fill: #999999; -fx-font-weight: bold;"/>
                <Label fx:id="labelTechnologies"
                       style="-fx-text-fill: white; -fx-background-color: #1565C0;
                              -fx-background-radius: 20; -fx-padding: 4 12;
                              -fx-font-size: 12px; -fx-font-weight: bold;"/>
            </VBox>
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="📅  Date de réalisation"
                       style="-fx-font-size: 11px; -fx-text-fill: #999999; -fx-font-weight: bold;"/>
                <Label fx:id="labelDateRealisation"
                       style="-fx-font-size: 13px; -fx-text-fill: #333333;"/>
            </VBox>
        </HBox>

        <!-- Row: Lien démo -->
        <VBox spacing="4"
              style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15;">
            <Label text="🔗  Lien démo"
                   style="-fx-font-size: 11px; -fx-text-fill: #999999; -fx-font-weight: bold;"/>
            <Label fx:id="labelLienDemo"
                   style="-fx-font-size: 13px; -fx-text-fill: #1565C0;
                          -fx-underline: true; -fx-cursor: hand;"/>
        </VBox>

        <!-- Close button -->
        <HBox alignment="CENTER_RIGHT" style="-fx-padding: 5 0 0 0;">
            <Button fx:id="closeButton" text="✖  Fermer" onAction="#handleFermer"
                    style="-fx-background-color: #1565C0; -fx-text-fill: white;
                           -fx-font-weight: bold; -fx-font-size: 13px;
                           -fx-padding: 10 30; -fx-background-radius: 25; -fx-cursor: hand;"/>
        </HBox>
    </VBox>
</VBox>