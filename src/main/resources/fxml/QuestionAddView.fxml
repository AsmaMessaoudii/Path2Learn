<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<HBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.controllers.QuestionAddController"
      style="-fx-background-color: #F5F5F5;">

    <VBox style="-fx-background-color: #FFFFFF; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 2, 0);" prefWidth="280">
        <VBox spacing="10.0" style="-fx-padding: 30 20 30 20; -fx-background-color: #F8F9FA; -fx-alignment: CENTER;">
            <ImageView fitWidth="150" fitHeight="150" preserveRatio="true">

                <Image url="/0c0390ea-b94e-4e66-bdee-dc1608f0674c.jpg" />

            </ImageView>
            <Label text="Plateforme d'apprentissage" style="-fx-font-size: 11px; -fx-text-fill: #999999; -fx-alignment: CENTER;" />
        </VBox>
        <Separator style="-fx-background-color: #EEEEEE;" />
        <VBox spacing="5.0" style="-fx-padding: 20 10;">
            <Label text="MENU PRINCIPAL" style="-fx-font-size: 11px; -fx-text-fill: #BBBBBB; -fx-padding: 0 0 10 15; -fx-font-weight: bold;" />

            <Button fx:id="homeBtn" onAction="#handleHome" text="🏠  Tableau de bord" style="-fx-background-color: transparent; -fx-text-fill: #A0A0A0; -fx-font-size: 14px; -fx-cursor: hand; -fx-padding: 12 20; -fx-alignment: CENTER_LEFT; -fx-graphic-text-gap: 12;" />
            <Button fx:id="coursBtn" onAction="#handleCours" text="📚  Cours" style="-fx-background-color: transparent; -fx-text-fill: #A0A0A0; -fx-font-size: 14px; -fx-cursor: hand; -fx-padding: 12 20; -fx-alignment: CENTER_LEFT; -fx-graphic-text-gap: 12;" />
            <Button fx:id="ressourcesBtn" onAction="#handleRessources" text="📎  Ressources" style="-fx-background-color: transparent; -fx-text-fill: #A0A0A0; -fx-font-size: 14px; -fx-cursor: hand; -fx-padding: 12 20; -fx-alignment: CENTER_LEFT; -fx-graphic-text-gap: 12;" />
            <Button fx:id="questionsBtn" onAction="#handleQuestions" text="❓  Quiz" style="-fx-background-color: transparent; -fx-text-fill: #A0A0A0; -fx-font-size: 14px; -fx-cursor: hand; -fx-padding: 12 20; -fx-alignment: CENTER_LEFT; -fx-graphic-text-gap: 12;" />
            <Button fx:id="projetsBtn" onAction="#handleProjets" text="💼  Projets" style="-fx-background-color: transparent; -fx-text-fill: #A0A0A0; -fx-font-size: 14px; -fx-cursor: hand; -fx-padding: 12 20; -fx-alignment: CENTER_LEFT; -fx-graphic-text-gap: 12;" />
            <Button fx:id="evenementsBtn" onAction="#handleEvenements" text="📅  Événements" style="-fx-background-color: transparent; -fx-text-fill: #A0A0A0; -fx-font-size: 14px; -fx-cursor: hand; -fx-padding: 12 20; -fx-alignment: CENTER_LEFT; -fx-graphic-text-gap: 12;" />
            <Button fx:id="utilisateursBtn" onAction="#handleUtilisateurs" text="👥  Communauté" style="-fx-background-color: transparent; -fx-text-fill: #A0A0A0; -fx-font-size: 14px; -fx-cursor: hand; -fx-padding: 12 20; -fx-alignment: CENTER_LEFT; -fx-graphic-text-gap: 12;" />
        </VBox>
        <Separator style="-fx-background-color: #EEEEEE;" />
        <VBox spacing="10.0" style="-fx-padding: 20 20; -fx-background-color: #F8F9FA; -fx-alignment: CENTER;">
            <Button text="🔑  Se connecter" style="-fx-background-color: transparent; -fx-text-fill: #81C784; -fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8 20; -fx-border-color: #81C784; -fx-border-radius: 25;" maxWidth="Infinity" />
            <Button text="📝  S'inscrire" style="-fx-background-color: #81C784; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8 20; -fx-background-radius: 25;" maxWidth="Infinity" />
        </VBox>
        <Region VBox.vgrow="ALWAYS" />
        <VBox spacing="5.0" style="-fx-padding: 20; -fx-background-color: #F8F9FA;">
            <Label text="© 2026 Path2Learn" style="-fx-font-size: 10px; -fx-text-fill: #CCCCCC; -fx-alignment: CENTER;" />
            <Label text="v1.0.0" style="-fx-font-size: 9px; -fx-text-fill: #DDDDDD; -fx-alignment: CENTER;" />
        </VBox>
    </VBox>

    <VBox HBox.hgrow="ALWAYS" style="-fx-background-color: #F5F5F5;">
        <HBox style="-fx-background-color: white; -fx-padding: 20 30; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 5, 0, 0, 2);" alignment="CENTER_LEFT">
            <Label text="Ajouter une question" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2E5C2E;" />
            <Region HBox.hgrow="ALWAYS" />
            <Label text="👤 Administrateur" style="-fx-font-size: 13px; -fx-text-fill: #666666;" />
        </HBox>
        <ScrollPane fitToWidth="true" style="-fx-background: #F5F5F5; -fx-background-color: #F5F5F5; -fx-border-width: 0;" VBox.vgrow="ALWAYS">
            <VBox spacing="20.0" style="-fx-padding: 30 40;">
                <HBox alignment="CENTER_LEFT" spacing="20.0">
                    <Button text="← Retour à la liste" onAction="#handleRetour" style="-fx-background-color: #42A5F5; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15; -fx-background-radius: 5; -fx-cursor: hand;"/>
                </HBox>
                <Label fx:id="statusLabel" style="-fx-font-size: 12px;"/>
                <VBox spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 30;">
                    <GridPane hgap="20.0" vgap="10.0">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="25"/>
                            <ColumnConstraints percentWidth="75"/>
                        </columnConstraints>
                        <Label text="Titre :" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-font-weight: bold;"/>
                        <VBox GridPane.columnIndex="1" GridPane.rowIndex="0">
                            <TextField fx:id="titreField" promptText="Entrez le titre" prefWidth="400"/>
                            <Label fx:id="titreErrorLabel" style="-fx-font-size: 11px;"/>
                        </VBox>
                        <Label text="Description :" GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-font-weight: bold;"/>
                        <VBox GridPane.columnIndex="1" GridPane.rowIndex="1">
                            <TextArea fx:id="descriptionArea" prefHeight="100" promptText="Description détaillée"/>
                            <Label fx:id="descriptionErrorLabel" style="-fx-font-size: 11px;"/>
                        </VBox>
                        <Label text="Durée (minutes) :" GridPane.columnIndex="0" GridPane.rowIndex="2" style="-fx-font-weight: bold;"/>
                        <VBox GridPane.columnIndex="1" GridPane.rowIndex="2">
                            <TextField fx:id="dureeField" promptText="Ex: 30"/>
                            <Label fx:id="dureeErrorLabel" style="-fx-font-size: 11px;"/>
                        </VBox>
                        <Label text="Note maximale :" GridPane.columnIndex="0" GridPane.rowIndex="3" style="-fx-font-weight: bold;"/>
                        <VBox GridPane.columnIndex="1" GridPane.rowIndex="3">
                            <TextField fx:id="noteMaxField" promptText="Ex: 20"/>
                            <Label fx:id="noteMaxErrorLabel" style="-fx-font-size: 11px;"/>
                        </VBox>
                        <Label text="ID Utilisateur :" GridPane.columnIndex="0" GridPane.rowIndex="4" style="-fx-font-weight: bold;"/>
                        <VBox GridPane.columnIndex="1" GridPane.rowIndex="4">
                            <TextField fx:id="userIdField" promptText="ID du créateur"/>
                            <Label fx:id="userIdErrorLabel" style="-fx-font-size: 11px;"/>
                        </VBox>
                        <Label text="Date de création :" GridPane.columnIndex="0" GridPane.rowIndex="5" style="-fx-font-weight: bold;"/>
                        <DatePicker fx:id="datePicker" GridPane.columnIndex="1" GridPane.rowIndex="5" prefWidth="200"/>
                    </GridPane>
                    <HBox spacing="15.0" alignment="CENTER" style="-fx-padding: 20 0 0 0;">
                        <Button text="✅ Ajouter" onAction="#handleAjouter" style="-fx-background-color: #81C784; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 12 30; -fx-background-radius: 5; -fx-cursor: hand;"/>
                        <Button text="❌ Annuler" onAction="#handleAnnuler" style="-fx-background-color: #9E9E9E; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 12 30; -fx-background-radius: 5; -fx-cursor: hand;"/>
                    </HBox>
                    <Label text="💡 Astuce : Après avoir ajouté la question, vous pourrez gérer ses options (réponses possibles)" style="-fx-font-size: 11px; -fx-text-fill: #666666; -fx-padding: 10 0 0 0;"/>
                </VBox>
            </VBox>
        </ScrollPane>
    </VBox>
</HBox>