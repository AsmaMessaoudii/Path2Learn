<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.*?>

<HBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.controllers.QuestionAddController"
      style="-fx-background-color: #F5F5F5;">

    <!-- ═══════════════════════════════════════════════════════ SIDEBAR -->
    <VBox style="-fx-background-color: white; -fx-border-color: #E0E0E0; -fx-border-width: 0 1 0 0;
                 -fx-min-width: 220; -fx-max-width: 220; -fx-pref-width: 220;"
          VBox.vgrow="ALWAYS">

        <!-- Logo -->
        <HBox alignment="CENTER_LEFT" spacing="10"
              style="-fx-padding: 20 16 16 16; -fx-border-color: #F0F0F0; -fx-border-width: 0 0 1 0;">
            <Label text="🌿" style="-fx-font-size: 22px;" />
            <Label text="Path2Learn"
                   style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #4CAF50;" />
        </HBox>

        <Label text="NAVIGATION"
               style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #AAAAAA; -fx-padding: 16 16 6 16;" />

        <Button fx:id="homeBtn" onAction="#handleHome" text="  Dashboard"
                style="-fx-background-color: transparent; -fx-text-fill: #555555; -fx-font-size: 13px;
                       -fx-alignment: CENTER_LEFT; -fx-cursor: hand; -fx-padding: 10 16;
                       -fx-background-radius: 0; -fx-max-width: Infinity;" />

        <Button fx:id="coursBtn" onAction="#handleCours" text="  Cours"
                style="-fx-background-color: transparent; -fx-text-fill: #555555; -fx-font-size: 13px;
                       -fx-alignment: CENTER_LEFT; -fx-cursor: hand; -fx-padding: 10 16;
                       -fx-background-radius: 0; -fx-max-width: Infinity;" />

        <Button fx:id="ressourcesBtn" onAction="#handleRessources" text="  Ressources"
                style="-fx-background-color: transparent; -fx-text-fill: #555555; -fx-font-size: 13px;
                       -fx-alignment: CENTER_LEFT; -fx-cursor: hand; -fx-padding: 10 16;
                       -fx-background-radius: 0; -fx-max-width: Infinity;" />

        <!-- Quiz (actif) -->
        <Button fx:id="questionsBtn" onAction="#handleQuestions" text="  Quiz"
                style="-fx-background-color: #E8F5E9; -fx-text-fill: #2E7D32; -fx-font-size: 13px;
                       -fx-font-weight: bold; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;
                       -fx-padding: 10 16; -fx-background-radius: 0;
                       -fx-border-color: transparent #4CAF50 transparent transparent;
                       -fx-border-width: 0 3 0 0; -fx-max-width: Infinity;" />

        <Button fx:id="projetsBtn" onAction="#handleProjets" text="  Projets"
                style="-fx-background-color: transparent; -fx-text-fill: #555555; -fx-font-size: 13px;
                       -fx-alignment: CENTER_LEFT; -fx-cursor: hand; -fx-padding: 10 16;
                       -fx-background-radius: 0; -fx-max-width: Infinity;" />

        <Label text="GESTION"
               style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #AAAAAA; -fx-padding: 16 16 6 16;" />

        <Button fx:id="evenementsBtn" onAction="#handleEvenements" text="  Événements"
                style="-fx-background-color: transparent; -fx-text-fill: #555555; -fx-font-size: 13px;
                       -fx-alignment: CENTER_LEFT; -fx-cursor: hand; -fx-padding: 10 16;
                       -fx-background-radius: 0; -fx-max-width: Infinity;" />

        <Button fx:id="utilisateursBtn" onAction="#handleUtilisateurs" text="  Communauté"
                style="-fx-background-color: transparent; -fx-text-fill: #555555; -fx-font-size: 13px;
                       -fx-alignment: CENTER_LEFT; -fx-cursor: hand; -fx-padding: 10 16;
                       -fx-background-radius: 0; -fx-max-width: Infinity;" />

        <Region VBox.vgrow="ALWAYS" />

        <HBox alignment="CENTER_LEFT" spacing="10"
              style="-fx-padding: 14 16; -fx-border-color: #F0F0F0; -fx-border-width: 1 0 0 0;">
            <Label text="AD"
                   style="-fx-background-color: #E8F5E9; -fx-text-fill: #2E7D32; -fx-font-size: 12px;
                          -fx-font-weight: bold; -fx-padding: 6 9; -fx-background-radius: 50;" />
            <VBox spacing="1">
                <Label text="Admin"
                       style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #333333;" />
                <Label text="Administrateur"
                       style="-fx-font-size: 11px; -fx-text-fill: #999999;" />
            </VBox>
        </HBox>
    </VBox>

    <!-- ═══════════════════════════════════════════════════════ MAIN -->
    <VBox HBox.hgrow="ALWAYS" style="-fx-background-color: #F5F5F5;">

        <!-- Topbar -->
        <HBox alignment="CENTER_LEFT" spacing="8"
              style="-fx-background-color: white; -fx-padding: 13 24;
                     -fx-border-color: #E0E0E0; -fx-border-width: 0 0 1 0;">
            <Label text="Dashboard" style="-fx-font-size: 12px; -fx-text-fill: #AAAAAA;" />
            <Label text="›" style="-fx-font-size: 12px; -fx-text-fill: #CCCCCC;" />
            <Label text="Quiz" style="-fx-font-size: 12px; -fx-text-fill: #AAAAAA;" />
            <Label text="›" style="-fx-font-size: 12px; -fx-text-fill: #CCCCCC;" />
            <Label text="Ajouter une question" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #333333;" />
            <Region HBox.hgrow="ALWAYS" />
            <Button text="← Retour à la liste" onAction="#handleRetour"
                    style="-fx-background-color: white; -fx-text-fill: #555555; -fx-font-size: 12px;
                           -fx-padding: 7 16; -fx-background-radius: 7; -fx-cursor: hand;
                           -fx-border-color: #DDDDDD; -fx-border-radius: 7;" />
        </HBox>

        <!-- Contenu scrollable -->
        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                    style="-fx-background: #F5F5F5; -fx-background-color: #F5F5F5; -fx-border-width: 0;">
            <VBox spacing="20" style="-fx-padding: 28 32;">

                <!-- En-tête -->
                <VBox spacing="4">
                    <Label text="Ajouter une nouvelle question"
                           style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1A1A1A;" />
                    <Label text="Créez une question pour vos quiz. Vous pourrez ensuite ajouter les options de réponse."
                           style="-fx-font-size: 13px; -fx-text-fill: #888888;" />
                </VBox>

                <Label fx:id="statusLabel" style="-fx-font-size: 12px;"/>

                <!-- Formulaire -->
                <VBox spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 10;
                             -fx-border-color: #EEEEEE; -fx-border-radius: 10; -fx-padding: 30;">

                    <GridPane hgap="20.0" vgap="15.0">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="25"/>
                            <ColumnConstraints percentWidth="75"/>
                        </columnConstraints>

                        <!-- Titre -->
                        <Label text="Titre :" GridPane.columnIndex="0" GridPane.rowIndex="0"
                               style="-fx-font-weight: bold; -fx-text-fill: #333333;"/>
                        <VBox GridPane.columnIndex="1" GridPane.rowIndex="0">
                            <TextField fx:id="titreField" promptText="Entrez le titre"
                                       style="-fx-padding: 8 12; -fx-background-radius: 7; -fx-border-color: #DDDDDD; -fx-border-radius: 7;"/>
                            <Label fx:id="titreErrorLabel" style="-fx-font-size: 11px;"/>
                        </VBox>

                        <!-- Description -->
                        <Label text="Description :" GridPane.columnIndex="0" GridPane.rowIndex="1"
                               style="-fx-font-weight: bold; -fx-text-fill: #333333;"/>
                        <VBox GridPane.columnIndex="1" GridPane.rowIndex="1">
                            <TextArea fx:id="descriptionArea" prefHeight="100" promptText="Description détaillée"
                                      style="-fx-padding: 8 12; -fx-background-radius: 7; -fx-border-color: #DDDDDD; -fx-border-radius: 7;"/>
                            <Label fx:id="descriptionErrorLabel" style="-fx-font-size: 11px;"/>
                        </VBox>

                        <!-- Durée -->
                        <Label text="Durée (minutes) :" GridPane.columnIndex="0" GridPane.rowIndex="2"
                               style="-fx-font-weight: bold; -fx-text-fill: #333333;"/>
                        <VBox GridPane.columnIndex="1" GridPane.rowIndex="2">
                            <TextField fx:id="dureeField" promptText="Ex: 30"
                                       style="-fx-padding: 8 12; -fx-background-radius: 7; -fx-border-color: #DDDDDD; -fx-border-radius: 7;"/>
                            <Label fx:id="dureeErrorLabel" style="-fx-font-size: 11px;"/>
                        </VBox>

                        <!-- Note Max -->
                        <Label text="Note maximale :" GridPane.columnIndex="0" GridPane.rowIndex="3"
                               style="-fx-font-weight: bold; -fx-text-fill: #333333;"/>
                        <VBox GridPane.columnIndex="1" GridPane.rowIndex="3">
                            <TextField fx:id="noteMaxField" promptText="Ex: 20"
                                       style="-fx-padding: 8 12; -fx-background-radius: 7; -fx-border-color: #DDDDDD; -fx-border-radius: 7;"/>
                            <Label fx:id="noteMaxErrorLabel" style="-fx-font-size: 11px;"/>
                        </VBox>

                        <!-- ID Utilisateur -->
                        <Label text="ID Utilisateur :" GridPane.columnIndex="0" GridPane.rowIndex="4"
                               style="-fx-font-weight: bold; -fx-text-fill: #333333;"/>
                        <VBox GridPane.columnIndex="1" GridPane.rowIndex="4">
                            <TextField fx:id="userIdField" promptText="ID du créateur"
                                       style="-fx-padding: 8 12; -fx-background-radius: 7; -fx-border-color: #DDDDDD; -fx-border-radius: 7;"/>
                            <Label fx:id="userIdErrorLabel" style="-fx-font-size: 11px;"/>
                        </VBox>

                        <!-- Date -->
                        <Label text="Date de création :" GridPane.columnIndex="0" GridPane.rowIndex="5"
                               style="-fx-font-weight: bold; -fx-text-fill: #333333;"/>
                        <DatePicker fx:id="datePicker" GridPane.columnIndex="1" GridPane.rowIndex="5"
                                    prefWidth="200" style="-fx-background-radius: 7;"/>
                    </GridPane>

                    <HBox spacing="15.0" alignment="CENTER" style="-fx-padding: 20 0 0 0;">
                        <Button text="✅ Ajouter" onAction="#handleAjouter"
                                style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 12 30; -fx-background-radius: 7; -fx-cursor: hand;"/>
                        <Button text="❌ Annuler" onAction="#handleAnnuler"
                                style="-fx-background-color: #9E9E9E; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 12 30; -fx-background-radius: 7; -fx-cursor: hand;"/>
                    </HBox>

                    <Label text="💡 Astuce : Après avoir ajouté la question, vous pourrez gérer ses options (réponses possibles)"
                           style="-fx-font-size: 11px; -fx-text-fill: #AAAAAA; -fx-padding: 10 0 0 0;"/>
                </VBox>

            </VBox>
        </ScrollPane>
    </VBox>
</HBox>