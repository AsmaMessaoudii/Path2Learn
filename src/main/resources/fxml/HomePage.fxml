<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.controllers.HomePageController"
      style="-fx-background-color: #F5F5F5;"
      prefWidth="1200" prefHeight="800">

    <!-- HEADER FIXE -->
    <VBox style="-fx-background-color: white; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 10, 0, 0, 2);">
        <HBox alignment="CENTER_LEFT" spacing="30.0" style="-fx-padding: 15 40;">

            <ImageView fitWidth="150" fitHeight="150" preserveRatio="true">
                <Image url="/0c0390ea-b94e-4e66-bdee-dc1608f0674c.jpg" />
            </ImageView>

            <Region HBox.hgrow="ALWAYS" />

            <HBox spacing="25.0">
                <Button fx:id="homeBtn" onAction="#handleHome" text="Accueil"
                        style="-fx-background-color: transparent; -fx-text-fill: #4CAF50; -fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 0 0 5 0; -fx-border-color: transparent transparent #4CAF50 transparent; -fx-border-width: 0 0 2 0;" />
                <Button fx:id="coursBtn" onAction="#handleCours" text="Cours"
                        style="-fx-background-color: transparent; -fx-text-fill: #555555; -fx-font-size: 13px; -fx-cursor: hand; -fx-padding: 0 0 5 0;" />
                <Button fx:id="ressourcesBtn" onAction="#handleRessources" text="Ressources"
                        style="-fx-background-color: transparent; -fx-text-fill: #555555; -fx-font-size: 13px; -fx-cursor: hand; -fx-padding: 0 0 5 0;" />
                <Button fx:id="questionsBtn" onAction="#handleQuestions" text="Quiz"
                        style="-fx-background-color: transparent; -fx-text-fill: #555555; -fx-font-size: 13px; -fx-cursor: hand; -fx-padding: 0 0 5 0;" />
                <Button fx:id="projetsBtn" onAction="#handleProjets" text="Projets"
                        style="-fx-background-color: transparent; -fx-text-fill: #555555; -fx-font-size: 13px; -fx-cursor: hand; -fx-padding: 0 0 5 0;" />
                <Button fx:id="evenementsBtn" onAction="#handleEvenements" text="Événements"
                        style="-fx-background-color: transparent; -fx-text-fill: #555555; -fx-font-size: 13px; -fx-cursor: hand; -fx-padding: 0 0 5 0;" />
                <Button fx:id="utilisateursBtn" onAction="#handleUtilisateurs" text="Communauté"
                        style="-fx-background-color: transparent; -fx-text-fill: #555555; -fx-font-size: 13px; -fx-cursor: hand; -fx-padding: 0 0 5 0;" />
            </HBox>

            <Region HBox.hgrow="ALWAYS" />

            <HBox spacing="12.0" alignment="CENTER_RIGHT">
                <Label fx:id="userLabel" text=""
                       onMouseClicked="#toggleProfileMenu"
                       style="-fx-font-size: 13px; -fx-text-fill: #2E5C2E; -fx-font-weight: bold; -fx-cursor: hand;" />

                <VBox fx:id="profileMenu" visible="false" managed="false" spacing="5"
                      style="-fx-background-color: white; -fx-padding: 10; -fx-border-color: #ddd;
                             -fx-border-radius: 8; -fx-background-radius: 8;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 10, 0, 0, 4);
                             -fx-translate-y: 40;">
                    <Label fx:id="emailLabel"/>
                    <Label fx:id="roleLabel"/>
                    <Button text="Modifier compte" onAction="#handleEditProfile"
                            style="-fx-background-color: #4CAF50; -fx-text-fill: white;"/>
                </VBox>

                <!-- BADGE MINI (header) -->
                <VBox fx:id="badgeBox" spacing="2"
                      style="-fx-background-color: #ffffff; -fx-padding: 6 12;
                             -fx-background-radius: 10; -fx-border-color: #E0E0E0;
                             -fx-border-radius: 10;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 6, 0, 0, 2);">
                    <Label fx:id="badgeLabel" text="🏅 Badge"
                           style="-fx-font-size: 12px; -fx-text-fill: #2E5C2E; -fx-font-weight: bold;"/>
                    <Label fx:id="progressLabel" text="Progress"
                           style="-fx-font-size: 10px; -fx-text-fill: #777;"/>
                </VBox>

                <Button fx:id="logoutBtn" text="Déconnexion" onAction="#handleLogout"
                        visible="false" managed="false"
                        style="-fx-background-color: #E53935; -fx-text-fill: white; -fx-font-size: 12px; -fx-background-radius: 20;" />
                <Button fx:id="loginBtn" onAction="#handleLogin" text="Se connecter"
                        style="-fx-background-color: transparent; -fx-text-fill: #4CAF50; -fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 6 18; -fx-border-color: #4CAF50; -fx-border-radius: 25;" />
                <Button fx:id="registerBtn" onAction="#handleRegister" text="S'inscrire"
                        style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-size: 13px;" />
                <Button fx:id="adminBtn" onAction="#handleGoToAdmin" text="⚙️ Administration"
                        style="-fx-background-color: #FF9800; -fx-text-fill: white;"
                        visible="true" managed="true" />
            </HBox>
        </HBox>
    </VBox>

    <!-- ZONE SCROLLABLE -->
    <ScrollPane fitToWidth="true" fitToHeight="true"
                style="-fx-background: #F5F5F5; -fx-background-color: #F5F5F5; -fx-border-width: 0;"
                VBox.vgrow="ALWAYS">
        <VBox style="-fx-background-color: #F5F5F5;">

            <!-- SECTION HERO -->
            <HBox alignment="CENTER" style="-fx-background-color: #E8F5E9; -fx-padding: 50 50;">
                <VBox spacing="15.0" HBox.hgrow="ALWAYS">
                    <Label text="Bienvenue sur Path2Learn"
                           style="-fx-font-size: 12px; -fx-text-fill: #4CAF50; -fx-font-weight: bold;" />
                    <Label text="La plateforme qui rend l'apprentissage accessible à tous"
                           style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #2E5C2E; -fx-wrap-text: true;" />
                    <Label text="Des cours de qualité, des ressources interactives et une communauté passionnée pour vous accompagner dans votre réussite."
                           style="-fx-font-size: 14px; -fx-text-fill: #666666; -fx-wrap-text: true;" />
                    <HBox spacing="15.0" style="-fx-padding: 15 0 0 0;">
                        <Button onAction="#handleRegister" text="Commencer gratuitement"
                                style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 12 30; -fx-background-radius: 30; -fx-cursor: hand;" />
                        <Button onAction="#handleCours" text="Explorer les cours"
                                style="-fx-background-color: transparent; -fx-text-fill: #4CAF50; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 12 30; -fx-border-color: #4CAF50; -fx-border-radius: 30; -fx-background-radius: 30; -fx-cursor: hand;" />
                    </HBox>
                    <HBox spacing="30.0" style="-fx-padding: 30 0 0 0;">
                        <VBox spacing="3.0">
                            <Label text="5000+" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #4CAF50;" />
                            <Label text="Apprenants" style="-fx-font-size: 12px; -fx-text-fill: #666666;" />
                        </VBox>
                        <VBox spacing="3.0">
                            <Label text="120+" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #4CAF50;" />
                            <Label text="Cours" style="-fx-font-size: 12px; -fx-text-fill: #666666;" />
                        </VBox>
                        <VBox spacing="3.0">
                            <Label text="98%" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #4CAF50;" />
                            <Label text="Satisfaction" style="-fx-font-size: 12px; -fx-text-fill: #666666;" />
                        </VBox>
                    </HBox>
                </VBox>
                <VBox alignment="CENTER" HBox.hgrow="ALWAYS">
                    <Label text="🎓📚✨" style="-fx-font-size: 120px;" />
                </VBox>
            </HBox>

            <!-- ══════════════════════════════════════════════ -->
            <!-- BADGE SECTION — visible only for teachers     -->
            <!-- ══════════════════════════════════════════════ -->
            <VBox fx:id="badgeSection"
                  visible="false" managed="false"
                  spacing="16"
                  style="-fx-background-color: white;
                         -fx-padding: 30 50;
                         -fx-border-color: transparent transparent #f0f0f0 transparent;
                         -fx-border-width: 0 0 1 0;">

                <!-- Header -->
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label text="🏅 Mes Badges"
                           style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2E5C2E;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="pointsLabel"
                           style="-fx-font-size: 13px; -fx-text-fill: #666;
                                  -fx-background-color: #E8F5E9;
                                  -fx-background-radius: 20;
                                  -fx-padding: 5 14;
                                  -fx-font-weight: bold;"/>
                </HBox>

                <!-- Current + next badge labels -->
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label fx:id="currentBadgeLabel"
                           style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #333;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="nextBadgeLabel"
                           style="-fx-font-size: 12px; -fx-text-fill: #999;"/>
                </HBox>

                <!-- Progress bar -->
                <ProgressBar fx:id="badgeProgress"
                             prefWidth="1e30" prefHeight="10" progress="0"
                             style="-fx-accent: #4CAF50;"/>

                <!-- Badge cards in scrollable row -->
                <ScrollPane fitToHeight="true"
                            hbarPolicy="AS_NEEDED" vbarPolicy="NEVER"
                            style="-fx-background: transparent;
                                   -fx-background-color: transparent;
                                   -fx-border-color: transparent;
                                   -fx-padding: 0;">
                    <HBox fx:id="badgeShowcaseBox"
                          spacing="14"
                          alignment="CENTER_LEFT"
                          style="-fx-padding: 8 4;"/>
                </ScrollPane>

            </VBox>
            <!-- ══════════════════════════════════════════════ -->

            <!-- SECTION FONCTIONNALITÉS -->
            <VBox style="-fx-padding: 50 50; -fx-background-color: white;">
                <Label text="Nos services"
                       style="-fx-font-size: 12px; -fx-text-fill: #4CAF50; -fx-font-weight: bold; -fx-alignment: CENTER;" />
                <Label text="Tout ce dont vous avez besoin pour réussir"
                       style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2E5C2E; -fx-alignment: CENTER;" />
                <Label text="Des fonctionnalités pensées pour un apprentissage efficace"
                       style="-fx-font-size: 14px; -fx-text-fill: #666666; -fx-alignment: CENTER; -fx-padding: 5 0 40 0;" />

                <GridPane hgap="25.0" vgap="25.0">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="33.33" />
                        <ColumnConstraints percentWidth="33.33" />
                        <ColumnConstraints percentWidth="33.33" />
                    </columnConstraints>

                    <VBox fx:id="coursCard" onMouseClicked="#handleCours"
                          style="-fx-background-color: #F9F9F9; -fx-background-radius: 15; -fx-padding: 25 20; -fx-spacing: 12; -fx-cursor: hand;"
                          GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <Label text="📚" style="-fx-font-size: 40px;" />
                        <Label text="Cours complets" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2E5C2E;" />
                        <Label text="Des cours structurés avec vidéos, exercices et quiz."
                               style="-fx-font-size: 13px; -fx-text-fill: #777777; -fx-wrap-text: true;" />
                    </VBox>

                    <VBox fx:id="ressourcesCard" onMouseClicked="#handleRessources"
                          style="-fx-background-color: #F9F9F9; -fx-background-radius: 15; -fx-padding: 25 20; -fx-spacing: 12; -fx-cursor: hand;"
                          GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <Label text="📎" style="-fx-font-size: 40px;" />
                        <Label text="Ressources variées" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2E5C2E;" />
                        <Label text="PDF, vidéos, templates - tout le contenu nécessaire."
                               style="-fx-font-size: 13px; -fx-text-fill: #777777; -fx-wrap-text: true;" />
                    </VBox>

                    <VBox fx:id="questionsCard" onMouseClicked="#handleQuestions"
                          style="-fx-background-color: #F9F9F9; -fx-background-radius: 15; -fx-padding: 25 20; -fx-spacing: 12; -fx-cursor: hand;"
                          GridPane.columnIndex="2" GridPane.rowIndex="0">
                        <Label text="❓" style="-fx-font-size: 40px;" />
                        <Label text="Quiz interactifs" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2E5C2E;" />
                        <Label text="Testez vos connaissances et suivez votre progression."
                               style="-fx-font-size: 13px; -fx-text-fill: #777777; -fx-wrap-text: true;" />
                    </VBox>

                    <VBox fx:id="projetsCard" onMouseClicked="#handleProjets"
                          style="-fx-background-color: #F9F9F9; -fx-background-radius: 15; -fx-padding: 25 20; -fx-spacing: 12; -fx-cursor: hand;"
                          GridPane.columnIndex="0" GridPane.rowIndex="1">
                        <Label text="💼" style="-fx-font-size: 40px;" />
                        <Label text="Projets pratiques" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2E5C2E;" />
                        <Label text="Mettez en pratique vos compétences avec des projets concrets."
                               style="-fx-font-size: 13px; -fx-text-fill: #777777; -fx-wrap-text: true;" />
                    </VBox>

                    <VBox fx:id="evenementsCard" onMouseClicked="#handleEvenements"
                          style="-fx-background-color: #F9F9F9; -fx-background-radius: 15; -fx-padding: 25 20; -fx-spacing: 12; -fx-cursor: hand;"
                          GridPane.columnIndex="1" GridPane.rowIndex="1">
                        <Label text="📅" style="-fx-font-size: 40px;" />
                        <Label text="Événements live" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2E5C2E;" />
                        <Label text="Webinaires et ateliers avec des experts du domaine."
                               style="-fx-font-size: 13px; -fx-text-fill: #777777; -fx-wrap-text: true;" />
                    </VBox>

                    <VBox fx:id="utilisateursCard" onMouseClicked="#handleUtilisateurs"
                          style="-fx-background-color: #F9F9F9; -fx-background-radius: 15; -fx-padding: 25 20; -fx-spacing: 12; -fx-cursor: hand;"
                          GridPane.columnIndex="2" GridPane.rowIndex="1">
                        <Label text="👥" style="-fx-font-size: 40px;" />
                        <Label text="Communauté active" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2E5C2E;" />
                        <Label text="Échangez avec d'autres apprenants et formateurs."
                               style="-fx-font-size: 13px; -fx-text-fill: #777777; -fx-wrap-text: true;" />
                    </VBox>
                </GridPane>
            </VBox>

            <!-- SECTION CTA -->
            <HBox alignment="CENTER" spacing="30.0"
                  style="-fx-padding: 50 50; -fx-background-color: #2E5C2E;">
                <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                    <Label text="Prêt à démarrer ?"
                           style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: white;" />
                    <Label text="Rejoignez notre communauté et accédez à des centaines de cours"
                           style="-fx-font-size: 14px; -fx-text-fill: #C8E6C9;" />
                </VBox>
                <Button onAction="#handleRegister" text="S'inscrire gratuitement"
                        style="-fx-background-color: white; -fx-text-fill: #2E5C2E; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 12 35; -fx-background-radius: 30; -fx-cursor: hand;" />
            </HBox>

            <!-- FOOTER -->
            <HBox spacing="30.0" style="-fx-padding: 40 50 25 50; -fx-background-color: #2C3E50;">
                <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                    <Label text="🌿 Path2Learn" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;" />
                    <Label text="Apprenez autrement" style="-fx-font-size: 11px; -fx-text-fill: #95A5A6;" />
                    <Label text="© 2026" style="-fx-font-size: 10px; -fx-text-fill: #95A5A6; -fx-padding: 15 0 0 0;" />
                </VBox>
                <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                    <Label text="Plateforme" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: white;" />
                    <Label onMouseClicked="#handleCours" text="Cours" style="-fx-font-size: 11px; -fx-text-fill: #95A5A6; -fx-cursor: hand;" />
                    <Label onMouseClicked="#handleRessources" text="Ressources" style="-fx-font-size: 11px; -fx-text-fill: #95A5A6; -fx-cursor: hand;" />
                    <Label onMouseClicked="#handleQuestions" text="Quiz" style="-fx-font-size: 11px; -fx-text-fill: #95A5A6; -fx-cursor: hand;" />
                </VBox>
                <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                    <Label text="Communauté" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: white;" />
                    <Label onMouseClicked="#handleProjets" text="Projets" style="-fx-font-size: 11px; -fx-text-fill: #95A5A6; -fx-cursor: hand;" />
                    <Label onMouseClicked="#handleEvenements" text="Événements" style="-fx-font-size: 11px; -fx-text-fill: #95A5A6; -fx-cursor: hand;" />
                    <Label text="Forum" style="-fx-font-size: 11px; -fx-text-fill: #95A5A6; -fx-cursor: hand;" />
                </VBox>
                <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                    <Label text="Contact" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: white;" />
                    <Label text="contact@path2learn.com" style="-fx-font-size: 11px; -fx-text-fill: #95A5A6;" />
                    <Label text="+33 1 23 45 67 89" style="-fx-font-size: 11px; -fx-text-fill: #95A5A6;" />
                </VBox>
            </HBox>

        </VBox>
    </ScrollPane>
</VBox>